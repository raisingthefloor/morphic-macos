        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0435\u0436\u0438\u043C \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438. \u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u044D\u0442\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u067E\u0627\u06BB\u0645\u0631\u0627\u062F\u0648 \u0648\u068C\u0627\u064A\u0644 \u06AA\u0646\u067D\u0631\u0627\u0633\u067D \u06A9\u064A \u062A\u0628\u062F\u064A\u0644 \u0646\u0647 \u06AA\u0631\u064A \u0633\u06AF\u0647\u064A\u0648. \u0627\u0646 \u06A9\u064A \u067D\u0648\u06AF\u0644 \u06AA\u0631\u06BB \u0644\u0627\u0621\u0650 \u0631\u0633\u0627\u0626\u064A\u0621\u064E \u062C\u0648\u0646 \u0633\u064A\u067D\u0646\u06AF\u0648\u0646 \u06A9\u0648\u0644\u064A\u0648."

        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0949\u092A\u0940 (\u092A\u094D\u0930\u0924\u093F\u0932\u093F\u092A\u093F)"
          }
        },
        "ko": {

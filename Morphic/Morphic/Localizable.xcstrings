    "AboutMorphicMenuItem": {
      "comment": "[loc-id:6fb35f822df942fc] Menu item (Morphic status-menu) that opens the About window. macOS convention has no trailing ellipsis (unlike Windows). \u0022Morphic\u0022 is a product name; do not translate it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Morphic"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0646 \u0627\u0644\u0645\u0648\u0631\u0641\u064A\u0643..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Morphic..."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062F\u0631\u0628\u0627\u0631\u0647 \u0645\u0648\u0631\u0641\u06CC\u06A9..."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0AB5\u0ABF\u0AB6\u0AC7..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\u092E\u0949\u0930\u094D\u092B\u093F\u0915 \u0915\u0947 \u092C\u093E\u0930\u0947 \u092E\u0947\u0902.."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Morphic\uC5D0 \uB300\uD558\uC5EC..."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092E\u0949\u0930\u094D\u092B\u093F\u0915 \u092C\u0926\u094D\u0926\u0932..."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u06A9\u06D2 \u0628\u0627\u0631\u06D2 \u0645\u06CC\u06BA..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1EDBi thi\u1EC7u v\u1EC1 Morphic..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\u5173\u4E8E Morphic (A)..."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95DC\u65BC Morphic..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Info zu Morphic..."
          }
        }
      }
    },
    "AboutVersionFormat": {

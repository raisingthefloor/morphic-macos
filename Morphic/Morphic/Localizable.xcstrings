          "stringUnit": {
            "state": "translated",
            "value": "\u062F\u06A9\u0647\u0627\u0646\u0627"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u1EC3n th\u1ECB"
          }

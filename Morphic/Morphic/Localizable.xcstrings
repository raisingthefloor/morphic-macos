            "state": "translated",
            "value": "Morphic f\u00FCr macOS"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0628\u0631\u0627\u06CC macOS"
          }
        },
        "mr": {

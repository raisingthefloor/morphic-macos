        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0787\u07A6\u0781\u07B0 \u0786\u07A8\u0794\u07AA\u0782\u07A9 \u0787\u07AC\u0780\u07AC\u0782\u07B0 \u0788\u07A8\u0782\u07B0\u0791\u07AF\u0787\u07A6\u0786\u07AA\u0782\u07B0 \u0786\u07A6\u0789\u07A6\u0781\u07B0 \u0788\u07AC\u078B\u07A7\u0782\u07AC. \u078C\u07A8\u0784\u07A7\u078E\u07AC \u078D\u07A8\u0794\u07AA\u0789\u07A6\u0781\u07B0 \u078A\u07A8\u078C\u07A7\u078D\u07AA\u0789\u07A6\u0781\u07B0\u078A\u07A6\u0780\u07AA \u0787\u07A6\u078D\u07AA\u0782\u07B0 \u0789\u07A6\u0790\u07A6\u0787\u07B0\u0786\u07A6\u078C\u07B0 \u0786\u07AE\u0781\u07B0\u078D\u07A6\u0787\u07B0\u0788\u07A7."
          }
        },

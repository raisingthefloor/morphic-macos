            "state": "translated",
            "value": "\u0022Se\u00E7ilmi\u015Fi Oxu\u0022 s\u0259hv p\u0259nc\u0259r\u0259ni oxumu\u015F ola bil\u0259r. M\u0259tniniz\u0259 klikl\u0259yin v\u0259 yenid\u0259n c\u0259hd edin."
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u0427\u044B\u0442\u0430\u0446\u044C \u0432\u044B\u043B\u0443\u0447\u0430\u043D\u0430\u0435\u00BB \u043C\u0430\u0433\u043B\u043E \u043F\u0440\u0430\u0447\u044B\u0442\u0430\u0446\u044C \u043D\u0435 \u0442\u043E\u0435 \u0430\u043A\u043D\u043E. \u041F\u0441\u0442\u0440\u044B\u043A\u043D\u0456\u0446\u0435 \u045E \u0441\u0432\u043E\u0439 \u0442\u044D\u043A\u0441\u0442 \u0456 \u043F\u0430\u045E\u0442\u0430\u0440\u044B\u0446\u0435 \u0441\u043F\u0440\u043E\u0431\u0443."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u0427\u0435\u0442\u0435\u043D\u0435 \u043D\u0430 \u0438\u0437\u0431\u0440\u0430\u043D\u043E\u0442\u043E\u201C \u043C\u043E\u0436\u0435 \u0434\u0430 \u0435 \u043F\u0440\u043E\u0447\u0435\u043B\u043E \u0433\u0440\u0435\u0448\u043D\u0438\u044F \u043F\u0440\u043E\u0437\u043E\u0440\u0435\u0446. \u0429\u0440\u0430\u043A\u043D\u0435\u0442\u0435 \u0432 \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0438 \u0438 \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u043E\u0442\u043D\u043E\u0432\u043E."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "\u2018\u09A8\u09BF\u09B0\u09CD\u09AC\u09BE\u099A\u09BF\u09A4 \u09B2\u09C7\u0996\u09BE \u09AA\u09DC\u09C1\u09A8\u2019 \u09AB\u09BF\u099A\u09BE\u09B0\u099F\u09BF \u09B9\u09DF\u09A4\u09CB \u09AD\u09C1\u09B2 \u0989\u0987\u09A8\u09CD\u09A1\u09CB \u09A5\u09C7\u0995\u09C7 \u09AA\u09DC\u09C7\u099B\u09C7\u0964 \u0986\u09AA\u09A8\u09BE\u09B0 \u09B2\u09C7\u0996\u09BE\u09B0 \u0989\u09AA\u09B0 \u0995\u09CD\u09B2\u09BF\u0995 \u0995\u09B0\u09C7 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u09B9\u09AF\u09BC\u09A4\u09CB \u09AD\u09C1\u09B2 \u0989\u0987\u09A8\u09CD\u09A1\u09CB \u09AA\u09A1\u09BC\u09C7\u099B\u09C7\u0964 \u0986\u09AA\u09A8\u09BE\u09B0 \u099F\u09C7\u0995\u09CD\u09B8\u099F\u09C7 \u0995\u09CD\u09B2\u09BF\u0995 \u0995\u09B0\u09C7 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"

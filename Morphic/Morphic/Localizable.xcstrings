    "ReadSelectedSpeakSelectionDisabledMessage": {
      "comment": "[loc-id:18a693419f16d0dd] Notification toast body shown when Read Selected can\u0027t work because the macOS \u201CSpeak selection\u201D feature is turned off. Tells the user to enable it. \u201CSpeak selection\u201D is the macOS Accessibility setting name; match Apple\u0027s wording. \u0022Morphic\u0022/Read Selected are product features.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201EAuswahl vorlesen\u201C verwendet die macOS-Funktion \u201EAuswahl sprechen\u201C, die derzeit deaktiviert ist. Aktivieren Sie sie in den Bedienungshilfen-Einstellungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa \u0022Leer selecci\u00F3n\u0022 de macOS, que actualmente est\u00E1 desactivado. Act\u00EDvalo en la configuraci\u00F3n de Accesibilidad y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0633\u062A\u062E\u062F\u0645 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062D\u062F\u062F \u0645\u064A\u0632\u0629 \u201D\u0646\u0637\u0642 \u0627\u0644\u062A\u062D\u062F\u064A\u062F\u201C \u0641\u064A macOS\u060C \u0648\u0647\u064A \u0645\u0639\u0637\u0651\u0644\u0629 \u062D\u0627\u0644\u064A\u064B\u0627. \u0634\u063A\u0651\u0644\u0647\u0627 \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u060C \u062B\u0645 \u062D\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062E\u0648\u0627\u0646\u062F\u0646 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647 \u0627\u0632 \u00AB\u062E\u0648\u0627\u0646\u062F\u0646 \u0627\u0646\u062A\u062E\u0627\u0628\u00BB macOS \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u0627\u06A9\u0646\u0648\u0646 \u062E\u0627\u0645\u0648\u0634 \u0627\u0633\u062A. \u0622\u0646 \u0631\u0627 \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u06CC\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0648\u0634\u0646 \u06A9\u0646\u06CC\u062F \u0648 \u0633\u067E\u0633 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS \u201CSpeak selection\u201D \u0AA8\u0ACB \u0A89\u0AAA\u0AAF\u0ACB\u0A97 \u0A95\u0AB0\u0AC7 \u0A9B\u0AC7, \u0A9C\u0AC7 \u0AB9\u0ABE\u0AB2\u0AAE\u0ABE\u0A82 \u0AAC\u0A82\u0AA7 \u0A9B\u0AC7. \u0AA4\u0AC7\u0AA8\u0AC7 \u0A8D\u0A95\u0ACD\u0AB8\u0AC7\u0AB8\u0ABF\u0AAC\u0ABF\u0AB2\u0ABF\u0A9F\u0AC0 \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8\u0AAE\u0ABE\u0A82 \u0A9A\u0ABE\u0AB2\u0AC1 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091A\u092F\u0928\u093F\u0924 \u092A\u0922\u093C\u0947\u0902 macOS \u201C\u091A\u092F\u0928 \u092C\u094B\u0932\u0947\u0902\u201D \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0924\u093E \u0939\u0948, \u091C\u094B \u0935\u0930\u094D\u0924\u092E\u093E\u0928 \u092E\u0947\u0902 \u092C\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0947 \u090F\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u0930\u0947\u0902, \u092B\u093F\u0930 \u092A\u0941\u0928: \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uC120\uD0DD \uD56D\uBAA9 \uC77D\uAE30\uB294 macOS \u201C\uC120\uD0DD \uD56D\uBAA9 \uB9D0\uD558\uAE30\u201D\uB97C \uC0AC\uC6A9\uD558\uC9C0\uB9CC \uD604\uC7AC \uAEBC\uC838 \uC788\uC2B5\uB2C8\uB2E4. \uC190\uC26C\uC6B4 \uC0AC\uC6A9 \uC124\uC815\uC5D0\uC11C \uCF20 \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093F\u0935\u0921\u0932\u0947\u0932\u0947 \u0935\u093E\u091A\u093E macOS \u201CSpeak selection\u201D \u0935\u093E\u092A\u0930\u0924\u0947, \u091C\u0947 \u0938\u0927\u094D\u092F\u093E \u092C\u0902\u0926 \u0906\u0939\u0947. \u0924\u0947 Accessibility \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C\u092E\u0927\u094D\u092F\u0947 \u091A\u093E\u0932\u0942 \u0915\u0930\u093E, \u0928\u0902\u0924\u0930 \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected\u060C macOS \u06A9\u06CC \u201DSpeak selection\u201C \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0648 \u0641\u06CC \u0627\u0644\u062D\u0627\u0644 \u0628\u0646\u062F \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 Accessibility \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0645\u06CC\u06BA \u0622\u0646 \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201C\u6717\u8BFB\u6240\u9009\u5185\u5BB9\u201D\u4F7F\u7528 macOS \u7684\u201C\u6717\u8BFB\u6240\u9009\u9879\u201D\u529F\u80FD\uFF0C\u8BE5\u529F\u80FD\u5F53\u524D\u5DF2\u5173\u95ED\u3002\u8BF7\u5728\u201C\u8F85\u52A9\u529F\u80FD\u201D\u8BBE\u7F6E\u4E2D\u5C06\u5176\u6253\u5F00\uFF0C\u7136\u540E\u518D\u8BD5\u4E00\u6B21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300C\u6717\u8B80\u9078\u53D6\u7BC4\u570D\u300D\u4F7F\u7528 macOS \u7684\u300C\u6717\u8B80\u6240\u9078\u7BC4\u570D\u300D\uFF0C\u4F46\u8A72\u529F\u80FD\u76EE\u524D\u5DF2\u95DC\u9589\u3002\u8ACB\u5728\u300C\u8F14\u52A9\u4F7F\u7528\u300D\u8A2D\u5B9A\u4E2D\u5C07\u5176\u958B\u555F\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi selezione usa la funzione \u201CPronuncia selezione\u201D di macOS, che al momento \u00E8 disattivata. Attivala nelle impostazioni di Accessibilit\u00E0, quindi riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ECDc ph\u1EA7n \u0111\u00E3 ch\u1ECDn s\u1EED d\u1EE5ng t\u00EDnh n\u0103ng \u201C\u0110\u1ECDc ph\u1EA7n l\u1EF1a ch\u1ECDn\u201D c\u1EE7a macOS, hi\u1EC7n \u0111ang b\u1ECB t\u1EAFt. H\u00E3y b\u1EADt t\u00EDnh n\u0103ng n\u00E0y trong C\u00E0i \u0111\u1EB7t tr\u1EE3 n\u0103ng, sau \u0111\u00F3 th\u1EED l\u1EA1i."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05D4\u05E7\u05E8\u05D0\u05EA \u05D4\u05D1\u05D7\u05D9\u05E8\u05D4 \u05DE\u05E9\u05EA\u05DE\u05E9\u05EA \u05D1-\u201C\u05D4\u05E7\u05E8\u05D0\u05EA \u05D4\u05DE\u05DC\u05DC \u05E9\u05E0\u05D1\u05D7\u05E8\u201D \u05E9\u05DC macOS, \u05E9\u05DB\u05D1\u05D5\u05D9\u05D4 \u05DB\u05E8\u05D2\u05E2. \u05D4\u05E4\u05E2\u05DC \u05D0\u05D5\u05EA\u05D4 \u05D1\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D5\u05E0\u05E1\u05D4 \u05E9\u05D5\u05D1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629E\u7BC4\u56F2\u306E\u8AAD\u307F\u4E0A\u3052\u306F macOS \u306E\u300C\u9078\u629E\u9805\u76EE\u306E\u8AAD\u307F\u4E0A\u3052\u300D\u3092\u4F7F\u7528\u3057\u307E\u3059\u304C\u3001\u73FE\u5728\u30AA\u30D5\u306B\u306A\u3063\u3066\u3044\u307E\u3059\u3002\u30A2\u30AF\u30BB\u30B7\u30D3\u30EA\u30C6\u30A3\u8A2D\u5B9A\u3067\u30AA\u30F3\u306B\u3057\u3066\u304B\u3089\u3001\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00E6s markeret bruger macOS \u201CL\u00E6s det valgte op\u201D, som i \u00F8jeblikket er sl\u00E5et fra. Sl\u00E5 det til i indstillingerne for Tilg\u00E6ngelighed, og pr\u00F8v igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0397 \u0391\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C5 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u00AB\u0395\u03BA\u03C6\u03CE\u03BD\u03B7\u03C3\u03B7 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2\u00BB \u03C4\u03BF\u03C5 macOS, \u03B7 \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03B7\u03BC\u03AD\u03BD\u03B7. \u0395\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03C3\u03C4\u03B9\u03C2 \u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03A0\u03C1\u03BF\u03C3\u03B2\u03B1\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03BE\u03B1\u03BD\u03AC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue valittu k\u00E4ytt\u00E4\u00E4 macOS:n \u201DPuhu valinta\u201D -toimintoa, joka on t\u00E4ll\u00E4 hetkell\u00E4 pois k\u00E4yt\u00F6st\u00E4. Ota se k\u00E4ytt\u00F6\u00F6n K\u00E4ytt\u00F6apu-asetuksissa ja yrit\u00E4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire la s\u00E9lection utilise \u00AB \u00C9noncer la s\u00E9lection \u00BB de macOS, actuellement d\u00E9sactiv\u00E9. Activez-le dans les r\u00E9glages Accessibilit\u00E9, puis r\u00E9essayez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire la s\u00E9lection utilise \u00AB \u00C9noncer la s\u00E9lection \u00BB de macOS, qui est pr\u00E9sentement d\u00E9sactiv\u00E9. Activez-le dans les r\u00E9glages d\u0027Accessibilit\u00E9, puis r\u00E9essayez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Czytaj zaznaczone u\u017Cywa opcji \u201EM\u00F3w zaznaczone\u201D w systemie macOS, kt\u00F3ra jest obecnie wy\u0142\u0105czona. W\u0142\u0105cz j\u0105 w ustawieniach u\u0142atwie\u0144 dost\u0119pu i spr\u00F3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso Ler Sele\u00E7\u00E3o usa a op\u00E7\u00E3o \u0022Falar sele\u00E7\u00E3o\u0022 do macOS, que est\u00E1 desativada no momento. Ative-a nas configura\u00E7\u00F5es de Acessibilidade e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler sele\u00E7\u00E3o utiliza \u201CEnunciar sele\u00E7\u00E3o\u201D do macOS, que est\u00E1 atualmente desativado. Ative-o nas defini\u00E7\u00F5es de Acessibilidade e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00E4s upp markering anv\u00E4nder \u201DL\u00E4s upp markering\u201D i macOS, som f\u00F6r n\u00E4rvarande \u00E4r avst\u00E4ngt. Aktivera det i inst\u00E4llningarna f\u00F6r Hj\u00E4lpmedel och f\u00F6rs\u00F6k sedan igen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitu ettelugemine kasutab macOS-i funktsiooni \u201ELoe valik ette\u201C, mis on praegu v\u00E4lja l\u00FClitatud. L\u00FClita see h\u00F5lbustuse seadetes sisse ja proovi uuesti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectie voorlezen gebruikt macOS \u2018Spreek selectie uit\u2019, dat momenteel is uitgeschakeld. Schakel dit in bij Toegankelijkheid en probeer het opnieuw."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS \u201CSpeak selection\u201D \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0648 \u0641\u06CC \u0627\u0644\u062D\u0627\u0644 \u0628\u0646\u062F \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 \u0631\u0633\u0627\u0626\u06CC \u067E\u0630\u06CC\u0631\u06CC \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0645\u06CC\u06BA \u0622\u0646 \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees Seleksie gebruik macOS se \u201CSpreek seleksie\u201D, wat tans afgeskakel is. Skakel dit in Toeganklikheid-instellings aan, en probeer dan weer."
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u12E8macOS \u201CSpeak selection\u201D\u1295 \u12ED\u1320\u1240\u121B\u120D\u1363 \u12A5\u1231\u121D \u12A0\u1201\u1295 \u1320\u134D\u1277\u120D\u1362 \u1260\u1270\u12F0\u122B\u123D\u1290\u1275 \u1245\u1295\u1265\u122E\u127D \u12CD\u1235\u1325 \u12EB\u1265\u1229\u1275\u1363 \u12A8\u12DA\u12EB \u12A5\u1295\u12F0\u1308\u1293 \u12ED\u121E\u12AD\u1229\u1362"
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected-\u098F macOS \u201CSpeak selection\u201D \u09AC\u09CD\u09AF\u09F1\u09B9\u09BE\u09F0 \u0995\u09F0\u09C7, \u09AF\u09BF \u09AC\u09F0\u09CD\u09A4\u09AE\u09BE\u09A8 \u09AC\u09A8\u09CD\u09A7 \u0986\u099B\u09C7\u0964 Accessibility \u099B\u09C7\u099F\u09BF\u0982\u099B\u09A4 \u0987\u09AF\u09BC\u09BE\u0995 \u0985\u09A8 \u0995\u09F0\u0995, \u09A4\u09BE\u09F0\u09AA\u09BF\u099B\u09A4 \u09AA\u09C1\u09A8\u09F0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09F0\u0995\u0964"
          }
        },
        "az-Latn-AZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0022Se\u00E7ilmi\u015Fi Oxu\u0022 funksiyas\u0131 haz\u0131rda s\u00F6nd\u00FCr\u00FClm\u00FC\u015F olan macOS \u201CSe\u00E7imi s\u0259sl\u0259ndir\u201D funksiyas\u0131ndan istifad\u0259 edir. Onu \u018Fl\u00E7atanl\u0131q parametrl\u0259rind\u0259 aktivl\u0259\u015Fdirin, sonra yenid\u0259n c\u0259hd edin."
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u0427\u044B\u0442\u0430\u0446\u044C \u0432\u044B\u043B\u0443\u0447\u0430\u043D\u0430\u0435\u00BB \u0432\u044B\u043A\u0430\u0440\u044B\u0441\u0442\u043E\u045E\u0432\u0430\u0435 \u0444\u0443\u043D\u043A\u0446\u044B\u044E macOS \u00AB\u0410\u0433\u0443\u0447\u0432\u0430\u0446\u044C \u0432\u044B\u043B\u0443\u0447\u044D\u043D\u043D\u0435\u00BB, \u044F\u043A\u0430\u044F \u0437\u0430\u0440\u0430\u0437 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u043D\u0430. \u0423\u043A\u043B\u044E\u0447\u044B\u0446\u0435 \u044F\u0435 \u045E \u043D\u0430\u043B\u0430\u0434\u0430\u0445 \u0441\u043F\u0435\u0446\u044B\u044F\u043B\u044C\u043D\u044B\u0445 \u043C\u0430\u0433\u0447\u044B\u043C\u0430\u0441\u0446\u0435\u0439 \u0456 \u043F\u0430\u045E\u0442\u0430\u0440\u044B\u0446\u0435 \u0441\u043F\u0440\u043E\u0431\u0443."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u0427\u0435\u0442\u0435\u043D\u0435 \u043D\u0430 \u0438\u0437\u0431\u0440\u0430\u043D\u043E\u0442\u043E\u201C \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430 \u201E\u0418\u0437\u0433\u043E\u0432\u0430\u0440\u044F\u043D\u0435 \u043D\u0430 \u0438\u0437\u0431\u0440\u0430\u043D\u043E\u0442\u043E\u201C \u0432 macOS, \u043A\u043E\u0435\u0442\u043E \u0432 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u0435 \u0438\u0437\u043A\u043B\u044E\u0447\u0435\u043D\u043E. \u0412\u043A\u043B\u044E\u0447\u0435\u0442\u0435 \u0433\u043E \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\u0442\u0435 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F\u043D\u043E\u0441\u0442 \u0438 \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u043E\u0442\u043D\u043E\u0432\u043E."
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS \u201CSpeak selection\u201D \u09AC\u09CD\u09AF\u09AC\u09B9\u09BE\u09B0 \u0995\u09B0\u09C7, \u09AF\u09BE \u098F\u0996\u09A8 \u09AC\u09A8\u09CD\u09A7 \u0986\u099B\u09C7\u0964 \u0985\u09CD\u09AF\u09BE\u0995\u09CD\u09B8\u09C7\u09B8\u09BF\u09AC\u09BF\u09B2\u09BF\u099F\u09BF \u09B8\u09C7\u099F\u09BF\u0982\u09B8\u09C7 \u098F\u099F\u09BF \u099A\u09BE\u09B2\u09C1 \u0995\u09B0\u09C7 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "eu-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Irakurri hautatutakoa funtzioak macOS-en \u201CEsan hautapena\u201D erabiltzen du, eta desaktibatuta dago. Aktibatu Irisgarritasun-ezarpenetan, eta saiatu berriro."
          }
        },
        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0538\u0576\u0569\u0565\u0580\u0581\u0565\u056C \u0568\u0576\u057F\u0580\u057E\u0561\u056E\u0568-\u0576 \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0578\u0582\u0574 \u0567 macOS-\u056B \u00AB\u0531\u0580\u057F\u0561\u0562\u0565\u0580\u0565\u056C \u0568\u0576\u057F\u0580\u057E\u0561\u056E\u0568\u00BB \u0563\u0578\u0580\u056E\u0561\u057C\u0578\u0582\u0575\u0569\u0568, \u0578\u0580\u0568 \u0576\u0565\u0580\u056F\u0561\u0575\u0578\u0582\u0574\u057D \u0561\u0576\u057B\u0561\u057F\u057E\u0561\u056E \u0567\u0589 \u0544\u056B\u0561\u0581\u0580\u0565\u0584 \u0561\u0575\u0576 \u0544\u0561\u057F\u0579\u0565\u056C\u056B\u0578\u0582\u0569\u0575\u0561\u0576 \u056F\u0561\u0580\u0563\u0561\u057E\u0578\u0580\u0578\u0582\u0574\u0576\u0565\u0580\u0578\u0582\u0574, \u0561\u057A\u0561 \u0583\u0578\u0580\u0571\u0565\u0584 \u0576\u0578\u0580\u056B\u0581\u0589"
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u200FmacOS \u06A9\u06D2 \u0027Speak selection\u0027 \u06A9\u0627 \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0648 \u0641\u06CC \u0627\u0644\u062D\u0627\u0644 \u0628\u0646\u062F \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 \u0627\u06CC\u06A9\u0633\u06CC\u0633\u0628\u06CC\u0644\u0679\u06CC \u0633\u06CC\u0679\u0646\u06AF\u0632 \u0645\u06CC\u06BA \u0622\u0646 \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS-\u098F\u09B0 \u201CSpeak selection\u201D \u09AC\u09CD\u09AF\u09AC\u09B9\u09BE\u09B0 \u0995\u09B0\u09C7, \u09AF\u09BE \u098F\u0996\u09A8 \u09AC\u09A8\u09CD\u09A7 \u0986\u099B\u09C7\u0964 Accessibility \u09B8\u09C7\u099F\u09BF\u0982\u09B8\u09C7 \u098F\u099F\u09BF \u099A\u09BE\u09B2\u09C1 \u0995\u09B0\u09C1\u09A8, \u09A4\u09BE\u09B0\u09AA\u09B0 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u010Citaj odabrano koristi macOS funkciju \u201EIzgovori odabir\u201C, koja je trenutno isklju\u010Dena. Uklju\u010Dite je u postavkama pristupa\u010Dnosti, a zatim poku\u0161ajte ponovo."
          }
        },
        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce P\u0159e\u010D\u00EDst vybran\u00E9 pou\u017E\u00EDv\u00E1 v macOS volbu \u201EP\u0159ed\u010D\u00EDtat v\u00FDb\u011Br\u201C, kter\u00E1 je moment\u00E1ln\u011B vypnut\u00E1. Zapn\u011Bte ji v nastaven\u00ED Zp\u0159\u00EDstupn\u011Bn\u00ED a zkuste to znovu."
          }
        },
        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0784\u07AD\u0782\u07AA\u0782\u07B0\u0786\u07AA\u0783\u07A6\u0782\u07A9 macOS \u078E\u07AC \u201CSpeak selection\u201D \u0787\u07AC\u0788\u07AC\u060C \u0787\u07AC\u0788\u07A6\u0782\u07A9 \u0789\u07A8\u0788\u07A6\u078E\u07AA\u078C\u07AA \u0782\u07A8\u0787\u07B0\u0788\u07A7\u078D\u07A7\u078A\u07A6\u0787\u07AC\u0788\u07AC. \u0787\u07AC\u0786\u07B0\u0790\u07AC\u0790\u07A8\u0784\u07A8\u078D\u07A8\u0793\u07A9 \u0790\u07AC\u0793\u07A8\u0782\u07B0\u078E\u07B0\u0790\u07B0 \u0787\u07A8\u0782\u07B0 \u0787\u07AC \u0787\u07AE\u0782\u07B0 \u0786\u07AE\u0781\u07B0\u078D\u07AA\u0789\u07A6\u0781\u07B0\u078A\u07A6\u0780\u07AA \u0787\u07A6\u078D\u07AA\u0782\u07B0 \u0789\u07A6\u0790\u07A6\u0787\u07B0\u0786\u07A6\u078C\u07B0 \u0786\u07AE\u0781\u07B0\u078D\u07A6\u0787\u07B0\u0788\u07A7."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang Read Selected ng macOS \u201CSpeak selection,\u201D na kasalukuyang naka-off. I-on ito sa mga setting ng Accessibility, pagkatapos ay subukang muli."
          }
        },
        "gl-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler o seleccionado usa \u00ABLer a selecci\u00F3n\u00BB de macOS, que est\u00E1 desactivado. Act\u00EDvao na configuraci\u00F3n de Accesibilidade e t\u00E9ntao de novo."
          }
        },
        "hr-HR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u010Citaj odabrano koristi zna\u010Dajku \u201EIzgovori odabir\u201D sustava macOS, koja je trenuta\u010Dno isklju\u010Dena. Uklju\u010Dite je u postavkama Pristupa\u010Dnosti, a zatim poku\u0161ajte ponovno."
          }
        },
        "hu-HU": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kijel\u00F6l\u00E9s felolvas\u00E1sa funkci\u00F3 a macOS \u201EKijel\u00F6l\u00E9s felolvas\u00E1sa\u201D szolg\u00E1ltat\u00E1s\u00E1t haszn\u00E1lja, amely jelenleg ki van kapcsolva. Kapcsolja be a Kiseg\u00EDt\u0151 lehet\u0151s\u00E9gek be\u00E1ll\u00EDt\u00E1saiban, majd pr\u00F3b\u00E1lja \u00FAjra."
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u10DB\u10DD\u10DC\u10D8\u10E8\u10DC\u10E3\u10DA\u10D8\u10E1 \u10EC\u10D0\u10D9\u10D8\u10D7\u10EE\u10D5\u10D0\u201C \u10D8\u10E7\u10D4\u10DC\u10D4\u10D1\u10E1 macOS-\u10D8\u10E1 \u201E\u10DB\u10DD\u10DC\u10D8\u10E8\u10DC\u10E3\u10DA\u10D8\u10E1 \u10EC\u10D0\u10E0\u10DB\u10DD\u10D7\u10E5\u10DB\u10D0\u10E1\u201C, \u10E0\u10DD\u10DB\u10D4\u10DA\u10D8\u10EA \u10D0\u10DB\u10DF\u10D0\u10DB\u10D0\u10D3 \u10D2\u10D0\u10DB\u10DD\u10E0\u10D7\u10E3\u10DA\u10D8\u10D0. \u10E9\u10D0\u10E0\u10D7\u10D4\u10D7 \u10D8\u10D2\u10D8 \u201E\u10EC\u10D5\u10D3\u10DD\u10DB\u10D0\u10D3\u10DD\u10D1\u10D8\u10E1\u201C \u10DE\u10D0\u10E0\u10D0\u10DB\u10D4\u10E2\u10E0\u10D4\u10D1\u10E8\u10D8 \u10D3\u10D0 \u10E1\u10EA\u10D0\u10D3\u10D4\u10D7 \u10EE\u10D4\u10DA\u10D0\u10EE\u10DA\u10D0."
          }
        },
        "ca-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegir la selecci\u00F3 fa servir \u00ABPronunciar la selecci\u00F3\u00BB de macOS, que ara est\u00E0 desactivat. Activeu-ho a la configuraci\u00F3 d\u2019Accessibilitat i torneu-ho a provar."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "ga-IE": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00DAs\u00E1ideann L\u00E9igh an Roghn\u00FAch\u00E1n \u201CLabhair an roghn\u00FAch\u00E1n\u201D macOS, at\u00E1 m\u00FAchta faoi l\u00E1thair. Cuir ar si\u00FAl \u00E9 i socruithe Inrochtaineachta, ansin bain triail eile as."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca yang Dipilih menggunakan \u201CUcapkan pilihan\u201D macOS, yang saat ini nonaktif. Aktifkan di pengaturan Aksesibilitas, lalu coba lagi."
          }
        },
        "is-IS": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesa vali\u00F0 notar \u201ETala vali\u00F0\u201C \u00ED macOS, en sl\u00F6kkt er \u00E1 \u00FEv\u00ED. Kveiktu \u00E1 \u00FEv\u00ED \u00ED A\u00F0gengisstillingum og reyndu svo aftur."
          }
        },
        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u0422\u0430\u04A3\u0434\u0430\u043B\u0493\u0430\u043D\u0434\u044B \u043E\u049B\u0443\u00BB macOS \u00AB\u0422\u0430\u04A3\u0434\u0430\u043B\u0493\u0430\u043D\u0434\u044B \u0434\u0430\u0443\u044B\u0441\u0442\u0430\u043F \u043E\u049B\u0443\u00BB \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u0441\u044B\u043D \u043F\u0430\u0439\u0434\u0430\u043B\u0430\u043D\u0430\u0434\u044B, \u0431\u0456\u0440\u0430\u049B \u043E\u043B \u049B\u0430\u0437\u0456\u0440 \u04E9\u0448\u0456\u0440\u0443\u043B\u0456. \u041E\u043D\u044B \u00AB\u049A\u043E\u043B \u0436\u0435\u0442\u0456\u043C\u0434\u0456\u043B\u0456\u043A\u00BB \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043B\u0435\u0440\u0456\u043D\u0434\u0435 \u049B\u043E\u0441\u044B\u043F, \u049B\u0430\u0439\u0442\u0430\u043B\u0430\u043F \u043A\u04E9\u0440\u0456\u04A3\u0456\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u17A2\u17B6\u1793\u17A2\u178F\u17D2\u1790\u1794\u1791\u178A\u17C2\u179B\u1794\u17B6\u1793\u1787\u17D2\u179A\u17BE\u179F\u179A\u17BE\u179F \u1794\u17D2\u179A\u17BE \u201C\u1793\u17B7\u1799\u17B6\u1799\u17A2\u178F\u17D2\u1790\u1794\u1791\u178A\u17C2\u179B\u1794\u17B6\u1793\u1787\u17D2\u179A\u17BE\u179F\u179A\u17BE\u179F\u201D \u179A\u1794\u179F\u17CB macOS \u178A\u17C2\u179B\u1794\u1785\u17D2\u1785\u17BB\u1794\u17D2\u1794\u1793\u17D2\u1793\u1780\u17C6\u1796\u17BB\u1784\u1794\u17B7\u1791\u17D4 \u1794\u17BE\u1780\u179C\u17B6\u1793\u17C5\u1780\u17D2\u1793\u17BB\u1784\u1780\u17B6\u179A\u1780\u17C6\u178E\u178F\u17CB\u1797\u17B6\u1796\u1784\u17B6\u1799\u179F\u17D2\u179A\u17BD\u179B \u1794\u1793\u17D2\u1791\u17B6\u1794\u17CB\u1798\u1780\u1796\u17D2\u1799\u17B6\u1799\u17B6\u1798\u1798\u17D2\u178F\u1784\u1791\u17C0\u178F\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS \u201CSpeak selection\u201D \u0935\u093E\u092A\u0930\u0924\u093E, \u091C\u0947\u0902 \u0938\u0926\u094D\u092F\u093E \u092C\u0902\u0926 \u0906\u0938\u093E. Accessibility \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C\u093E\u0902\u0924 \u0924\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u0930\u093E\u0924, \u092E\u093E\u0917\u0940\u0930 \u092A\u0930\u0924 \u092F\u0924\u094D\u0928 \u0915\u0930\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201ESkaityti pa\u017Eym\u0117t\u0105\u201C naudoja \u201EmacOS\u201C funkcij\u0105 \u201E\u012Egarsinti pa\u017Eym\u0117jim\u0105\u201C, kuri \u0161iuo metu i\u0161jungta. \u012Ejunkite j\u0105 pritaikymo ne\u012Fgaliesiems parametruose ir bandykite dar kart\u0105."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcija Las\u012Bt atlas\u012Bto izmanto macOS opciju \u201CNolas\u012Bt atlas\u012Bto\u201D, kas pa\u0161laik ir izsl\u0113gta. Iesl\u0113dziet to pieejam\u012Bbas iestat\u012Bjumos un m\u0113\u0123iniet v\u0113lreiz."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0027\u0C86\u0CAF\u0CCD\u0C95\u0CC6\u0CAE\u0CBE\u0CA1\u0CBF\u0CA6\u0CCD\u0CA6\u0CA8\u0CCD\u0CA8\u0CC1 \u0C93\u0CA6\u0CBF\u0027 \u0CB5\u0CC8\u0CB6\u0CBF\u0CB7\u0CCD\u0C9F\u0CCD\u0CAF\u0CB5\u0CC1 macOS \u0CA8 \u201CSpeak selection\u201D \u0C85\u0CA8\u0CCD\u0CA8\u0CC1 \u0CAC\u0CB3\u0CB8\u0CC1\u0CA4\u0CCD\u0CA4\u0CA6\u0CC6, \u0C85\u0CA6\u0CA8\u0CCD\u0CA8\u0CC1 \u0CAA\u0CCD\u0CB0\u0CB8\u0CCD\u0CA4\u0CC1\u0CA4 \u0C86\u0CAB\u0CCD \u0CAE\u0CBE\u0CA1\u0CB2\u0CBE\u0C97\u0CBF\u0CA6\u0CC6. \u0CAA\u0CCD\u0CB0\u0CB5\u0CC7\u0CB6\u0CBF\u0CB8\u0CC1\u0CB5\u0CBF\u0C95\u0CC6 \u0CB8\u0CC6\u0C9F\u0CCD\u0C9F\u0CBF\u0C82\u0C97\u0CCD\u200C\u0C97\u0CB3\u0CB2\u0CCD\u0CB2\u0CBF \u0C85\u0CA6\u0CA8\u0CCD\u0CA8\u0CC1 \u0C86\u0CA8\u0CCD \u0CAE\u0CBE\u0CA1\u0CBF, \u0CA8\u0C82\u0CA4\u0CB0 \u0CAE\u0CA4\u0CCD\u0CA4\u0CC6 \u0CAA\u0CCD\u0CB0\u0CAF\u0CA4\u0CCD\u0CA8\u0CBF\u0CB8\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0443\u043D\u043A\u0446\u0438\u0458\u0430\u0442\u0430 \u201E\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0458 \u0433\u043E \u0438\u0437\u0431\u0440\u0430\u043D\u043E\u0442\u043E\u201C \u0458\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u0438 \u043E\u043F\u0446\u0438\u0458\u0430\u0442\u0430 \u201E\u0418\u0437\u0433\u043E\u0432\u043E\u0440\u0438 \u0433\u043E \u0438\u0437\u0431\u043E\u0440\u043E\u0442\u201C \u043D\u0430 macOS, \u043A\u043E\u0458\u0430\u0448\u0442\u043E \u0435 \u0438\u0441\u043A\u043B\u0443\u0447\u0435\u043D\u0430. \u0412\u043A\u043B\u0443\u0447\u0435\u0442\u0435 \u0458\u0430 \u0432\u043E \u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0437\u0430 \u043F\u0440\u0438\u0441\u0442\u0430\u043F\u043D\u043E\u0441\u0442, \u043F\u0430 \u043E\u0431\u0438\u0434\u0435\u0442\u0435 \u0441\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected, macOS-\u0D32\u0D46 \u201C\u0D24\u0D3F\u0D30\u0D1E\u0D4D\u0D1E\u0D46\u0D1F\u0D41\u0D24\u0D4D\u0D24\u0D24\u0D4D \u0D38\u0D02\u0D38\u0D3E\u0D30\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15\u201D \u0D0E\u0D28\u0D4D\u0D28 \u0D2B\u0D40\u0D1A\u0D4D\u0D1A\u0D31\u0D3E\u0D23\u0D4D \u0D09\u0D2A\u0D2F\u0D4B\u0D17\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D28\u0D4D\u0D28\u0D24\u0D4D, \u0D05\u0D24\u0D4D \u0D28\u0D3F\u0D32\u0D35\u0D3F\u0D7D \u0D13\u0D2B\u0D3E\u0D23\u0D4D. \u0D2A\u0D4D\u0D30\u0D35\u0D47\u0D36\u0D28\u0D15\u0D4D\u0D37\u0D2E\u0D24 \u0D15\u0D4D\u0D30\u0D2E\u0D40\u0D15\u0D30\u0D23\u0D19\u0D4D\u0D19\u0D33\u0D3F\u0D7D \u0D05\u0D24\u0D4D \u0D13\u0D23\u0D3E\u0D15\u0D4D\u0D15\u0D3F\u0D2F \u0D36\u0D47\u0D37\u0D02 \u0D35\u0D40\u0D23\u0D4D\u0D1F\u0D41\u0D02 \u0D36\u0D4D\u0D30\u0D2E\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043E\u043D\u0433\u043E\u0441\u043D\u044B\u0433 \u0443\u043D\u0448\u0438\u0445 \u043D\u044C \u043E\u0434\u043E\u043E\u0433\u043E\u043E\u0440 \u0443\u043D\u0442\u0440\u0430\u0430\u043B\u0442\u0442\u0430\u0439 \u0431\u0430\u0439\u0433\u0430\u0430 macOS-\u0438\u0439\u043D \u201C\u0421\u043E\u043D\u0433\u043E\u043B\u0442\u044B\u0433 \u044F\u0440\u0438\u0445\u201D \u0444\u0443\u043D\u043A\u0446\u0438\u0439\u0433 \u0430\u0448\u0438\u0433\u043B\u0430\u0434\u0430\u0433. \u0425\u04AF\u0440\u0442\u044D\u044D\u043C\u0436\u0438\u0439\u043D \u0442\u043E\u0445\u0438\u0440\u0433\u043E\u043E\u043D\u043E\u043E\u0441 \u04AF\u04AF\u043D\u0438\u0439\u0433 \u0430\u0441\u0430\u0430\u0433\u0430\u0430\u0434 \u0434\u0430\u0445\u0438\u043D \u043E\u0440\u043E\u043B\u0434\u043E\u043D\u043E \u0443\u0443."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca Pilihan menggunakan \u201CSebut pilihan\u201D macOS, yang kini dimatikan. Hidupkannya dalam tetapan Kebolehcapaian, kemudian cuba lagi."
          }
        },
        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqra l-Mag\u0127\u017Cul ju\u017Ca \u201CSpeak selection\u201D tal-macOS, li b\u0127alissa hija mitfija. Ixg\u0127elha fis-settings tal-A\u010B\u010Bessibbilt\u00E0, imbag\u0127ad er\u0121a\u0027 pprova."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opp markert bruker macOS \u00ABLes opp markering\u00BB, som er sl\u00E5tt av. Sl\u00E5 det p\u00E5 i Tilgjengelighet-innstillingene, og pr\u00F8v p\u00E5 nytt."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "\u2018\u091A\u092F\u0928 \u0917\u0930\u093F\u090F\u0915\u094B \u092A\u0922\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u2019 \u0932\u0947 macOS \u0915\u094B \u201CSpeak selection\u201D \u0938\u0941\u0935\u093F\u0927\u093E \u092A\u094D\u0930\u092F\u094B\u0917 \u0917\u0930\u094D\u0926\u091B, \u091C\u0941\u0928 \u0939\u093E\u0932 \u092C\u0928\u094D\u0926 \u091B\u0964 \u0915\u0943\u092A\u092F\u093E Accessibility \u0938\u0947\u091F\u093F\u0919\u0939\u0930\u0942\u092E\u093E \u0917\u090F\u0930 \u092F\u0938\u0932\u093E\u0908 \u0905\u0928 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D, \u0924\u094D\u092F\u0938\u092A\u091B\u093F \u092B\u0947\u0930\u093F \u092A\u094D\u0930\u092F\u093E\u0938 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0B1A\u0B5F\u0B28\u0B3F\u0B24 \u0B2A\u0B22\u0B3C\u0B28\u0B4D\u0B24\u0B41 macOS \u201C\u0B1A\u0B5F\u0B28 \u0B15\u0B41\u0B39\u0B28\u0B4D\u0B24\u0B41\u201D \u0B2C\u0B4D\u0B5F\u0B2C\u0B39\u0B3E\u0B30 \u0B15\u0B30\u0B47, \u0B2F\u0B3E\u0B39\u0B3E \u0B2C\u0B30\u0B4D\u0B24\u0B4D\u0B24\u0B2E\u0B3E\u0B28 \u0B2C\u0B28\u0B4D\u0B26 \u0B05\u0B1B\u0B3F\u0964 \u0B06\u0B15\u0B4D\u0B38\u0B47\u0B38\u0B3F\u0B2C\u0B3F\u0B32\u0B3F\u0B1F\u0B3F \u0B38\u0B47\u0B1F\u0B3F\u0B02\u0B38\u0B4D\u200C\u0B30\u0B47 \u0B0F\u0B39\u0B3E\u0B15\u0B41 \u0B1A\u0B3E\u0B32\u0B41 \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41, \u0B24\u0B3E\u2019\u0B2A\u0B30\u0B47 \u0B2A\u0B41\u0B23\u0B3F \u0B1A\u0B47\u0B37\u0B4D\u0B1F\u0B3E \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41\u0964"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0A1A\u0A41\u0A23\u0A3F\u0A06 \u0A39\u0A4B\u0A07\u0A06 \u0A2A\u0A5C\u0A4D\u0A39\u0A4B macOS \u201C\u0A1A\u0A4B\u0A23 \u0A2C\u0A4B\u0A32\u0A4B\u201D \u0A26\u0A40 \u0A35\u0A30\u0A24\u0A4B\u0A02 \u0A15\u0A30\u0A26\u0A3E \u0A39\u0A48, \u0A1C\u0A4B \u0A07\u0A38 \u0A35\u0A47\u0A32\u0A47 \u0A2C\u0A70\u0A26 \u0A39\u0A48\u0964 \u0A2A\u0A39\u0A41\u0A70\u0A1A\u0A2F\u0A4B\u0A17\u0A24\u0A3E \u0A38\u0A48\u0A1F\u0A3F\u0A70\u0A17\u0A3E\u0A02 \u0A35\u0A3F\u0A71\u0A1A \u0A07\u0A38\u0A28\u0A42\u0A70 \u0A1A\u0A3E\u0A32\u0A42 \u0A15\u0A30\u0A4B, \u0A2B\u0A3F\u0A30 \u0A26\u0A41\u0A2C\u0A3E\u0A30\u0A3E \u0A15\u0A4B\u0A38\u0A3C\u0A3F\u0A38\u0A3C \u0A15\u0A30\u0A4B\u0964"
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "\u067C\u0627\u06A9\u0644 \u0634\u0648\u06CC \u0648\u0644\u0648\u0644\u0626 \u062F macOS \u201CSpeak selection\u201D \u06A9\u0627\u0631\u0648\u064A\u060C \u0686\u06D0 \u0627\u0648\u0633 \u0628\u0646\u062F \u062F\u06CC. \u062F \u0644\u0627\u0633\u0631\u0633\u064A \u067E\u0647 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A\u0648 \u06A9\u06D0 \u06CC\u06D0 \u0686\u0627\u0644\u0627\u0646 \u06A9\u0693\u0626\u060C \u0628\u06CC\u0627 \u0647\u0685\u0647 \u0648\u06A9\u0693\u0626."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa \u201CLeer selecci\u00F3n\u201D de macOS, que est\u00E1 desactivado. Activ\u00E1 esta opci\u00F3n en la configuraci\u00F3n de Accesibilidad y volv\u00E9 a intentarlo."
          }
        },
        "es-BO": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201CLeer lo seleccionado\u201D usa la funci\u00F3n \u201CLeer selecci\u00F3n\u201D de macOS, que est\u00E1 desactivada. Act\u00EDvala en Configuraci\u00F3n de Accesibilidad y vuelve a intentarlo."
          }
        },
        "gd-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidh \u201CLeugh na Thagh Thu\u201D a\u0027 cleachdadh \u201CLabhair an taghadh\u201D macOS, a tha dheth an-dr\u00E0sta. Cuir air e ann an roghainnean So-ruigsinneachd, an uairsin feuch a-rithist."
          }
        },
        "ro-RO": {
          "stringUnit": {
            "state": "translated",
            "value": "Citire selec\u021Bie folose\u0219te func\u021Bia \u201ERostire selec\u021Bie\u201D din macOS, care este momentan dezactivat\u0103. Activa\u021Bi-o \u00EEn set\u0103rile de Accesibilitate, apoi \u00EEncerca\u021Bi din nou."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u00AB\u0427\u0438\u0442\u0430\u0442\u044C \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0435\u00BB \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u044E macOS \u00AB\u041F\u0440\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0435\u00BB, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0435\u0435 \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0443."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0686\u0648\u0646\u068A\u064A\u0644 \u067E\u0699\u0647\u0648 macOS \u201D\u0686\u0648\u0646\u068A \u06B3\u0627\u0644\u0647\u0627\u064A\u0648\u201C \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06AA\u0631\u064A \u067F\u0648\u060C \u062C\u064A\u06AA\u0648 \u0647\u0646 \u0648\u0642\u062A \u0628\u0646\u062F \u0622\u0647\u064A. \u0631\u0633\u0627\u0626\u064A \u0633\u064A\u067D\u0646\u06AF\u0632 \u06FE \u0627\u0646 \u06A9\u064A \u0622\u0646 \u06AA\u0631\u064A\u0648\u060C \u067E\u0648\u0621\u0650 \u067B\u064A\u0647\u0631 \u06AA\u0648\u0634\u0634 \u06AA\u0631\u064A\u0648."
          }
        },
        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DAD\u0DCA \u0DAF\u0DDA \u0D9A\u0DD2\u0DBA\u0DC0\u0DB1\u0DCA\u0DB1 macOS \u201C\u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DAD\u0DCA \u0DAF\u0DDA \u0D9A\u0DAE\u0DB1\u0DBA \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1\u201D \u0DB7\u0DCF\u0DC0\u0DD2\u0DAD \u0D9A\u0DBB\u0DBA\u0DD2, \u0D91\u0DBA \u0DAF\u0DD0\u0DB1\u0DCA \u0D85\u0D9A\u0DCA\u200D\u0DBB\u0DD2\u0DBA\u0DBA\u0DD2. \u0DB4\u0DCA\u200D\u0DBB\u0DC0\u0DDA\u0DC1\u0DCA\u200D\u0DBA\u0DAD\u0DCF \u0DC3\u0DD0\u0D9A\u0DC3\u0DD3\u0DB8\u0DCA \u0DAD\u0DD4\u0DC5 \u0D91\u0DBA \u0DC3\u0D9A\u0DCA\u200D\u0DBB\u0DD2\u0DBA \u0D9A\u0DBB \u0DB1\u0DD0\u0DC0\u0DAD \u0D8B\u0DAD\u0DCA\u0DC3\u0DCF\u0DC4 \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1."
          }
        },
        "sk-SK": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcia Pre\u010D\u00EDta\u0165 v\u00FDber pou\u017E\u00EDva v macOS mo\u017Enos\u0165 \u201EPre\u010D\u00EDta\u0165 v\u00FDber\u201C, ktor\u00E1 je moment\u00E1lne vypnut\u00E1. Zapnite ju v nastaveniach Pr\u00EDstupnosti a sk\u00FAste to znova."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Preberi izbrano uporablja funkcijo macOS \u00BBIzgovori izbor\u00AB, ki je trenutno izklopljena. Vklopite jo v nastavitvah dostopnosti in poskusite znova."
          }
        },
        "sr-Latn-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro\u010Ditaj izabrano koristi macOS \u201EIzgovori izbor\u201D, \u0161to je trenutno isklju\u010Deno. Uklju\u010Dite to u pode\u0161avanjima Pristupa\u010Dnosti, pa poku\u0161ajte ponovo."
          }
        },
        "cy-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae Darllen y Dewis yn defnyddio \u201CLleisio\u0027r dewis\u201D macOS, sydd wedi\u0027i ddiffodd ar hyn o bryd. Trowch ef ymlaen yn y gosodiadau Hygyrchedd, yna ceisiwch eto."
          }
        },
        "sw-KE": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma Yaliyochaguliwa hutumia \u201CZungumza uteuzi\u201D ya macOS, ambayo imezimwa kwa sasa. Iwashe katika mipangilio ya Ufikivu, kisha jaribu tena."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0BA4\u0BC7\u0BB0\u0BCD\u0BA8\u0BCD\u0BA4\u0BC6\u0B9F\u0BC1\u0B95\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BA4\u0BC8 \u0BB5\u0BBE\u0B9A\u0BBF \u0B85\u0BAE\u0BCD\u0B9A\u0BAE\u0BCD macOS \u201C\u0BA4\u0BC7\u0BB0\u0BCD\u0BB5\u0BC8\u0BAA\u0BCD \u0BAA\u0BC7\u0B9A\u0BC1\u201D \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC8\u0BAA\u0BCD \u0BAA\u0BAF\u0BA9\u0BCD\u0BAA\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1, \u0B85\u0BA4\u0BC1 \u0BA4\u0BB1\u0BCD\u0BAA\u0BCB\u0BA4\u0BC1 \u0B85\u0BA3\u0BC8\u0B95\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BC1\u0BB3\u0BCD\u0BB3\u0BA4\u0BC1. \u0B85\u0BA3\u0BC1\u0B95\u0BB2\u0BCD\u0BA4\u0BA9\u0BCD\u0BAE\u0BC8 \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1\u0B95\u0BB3\u0BBF\u0BB2\u0BCD \u0B85\u0BA4\u0BC8 \u0B87\u0BAF\u0B95\u0BCD\u0B95\u0BBF, \u0BAA\u0BBF\u0BA9\u0BCD\u0BA9\u0BB0\u0BCD \u0BAE\u0BC0\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BAF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
          }
        },
        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0E2D\u0E48\u0E32\u0E19\u0E2A\u0E48\u0E27\u0E19\u0E17\u0E35\u0E48\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E43\u0E0A\u0E49\u0E04\u0E38\u0E13\u0E2A\u0E21\u0E1A\u0E31\u0E15\u0E34 \u201C\u0E1E\u0E39\u0E14\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E40\u0E25\u0E37\u0E2D\u0E01\u201D \u0E02\u0E2D\u0E07 macOS \u0E0B\u0E36\u0E48\u0E07\u0E02\u0E13\u0E30\u0E19\u0E35\u0E49\u0E1B\u0E34\u0E14\u0E2D\u0E22\u0E39\u0E48 \u0E42\u0E1B\u0E23\u0E14\u0E40\u0E1B\u0E34\u0E14\u0E43\u0E0A\u0E49\u0E07\u0E32\u0E19\u0E43\u0E19\u0E01\u0E32\u0E23\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32\u0E01\u0E32\u0E23\u0E0A\u0E48\u0E27\u0E22\u0E01\u0E32\u0E23\u0E40\u0E02\u0E49\u0E32\u0E16\u0E36\u0E07 \u0E41\u0E25\u0E49\u0E27\u0E25\u0E2D\u0E07\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07"
          }
        },
        "ti-ER": {
          "stringUnit": {
            "state": "translated",
            "value": "\u12DD\u1270\u1218\u1228\u1338 \u12A3\u1295\u1265\u1265\u1361 \u1293\u12ED macOS \u201CSpeak selection\u201D \u12ED\u1325\u1240\u121D\u1363 \u1295\u1231 \u12F5\u121B \u1215\u1302 \u1320\u134A\u12A1 \u12A3\u120E\u1362 \u12A3\u1265 \u1293\u12ED \u1270\u1260\u133B\u1215\u1290\u1275 \u1218\u12F3\u1208\u12CA\u1273\u1275 \u12A3\u1265\u122D\u1206\u1363 \u12F5\u1215\u122A\u12A1 \u12A5\u1295\u12F0\u1308\u1293 \u1348\u1275\u1295\u1362"
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00E7ileni Oku, \u015Fu anda kapal\u0131 olan macOS \u201CSe\u00E7imi seslendir\u201D \u00F6zelli\u011Fini kullan\u0131r. Eri\u015Filebilirlik ayarlar\u0131nda a\u00E7\u0131p yeniden deneyin."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438 \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u0435\u00BB \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454 \u0444\u0443\u043D\u043A\u0446\u0456\u044E macOS \u00AB\u041E\u0437\u0432\u0443\u0447\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043D\u0435\u00BB, \u044F\u043A\u0430 \u0437\u0430\u0440\u0430\u0437 \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u0430. \u0423\u0432\u0456\u043C\u043A\u043D\u0456\u0442\u044C \u0457\u0457 \u0432 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u0456 \u0442\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "uz-Latn-UZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlanganni o\u2018qish macOS \u201CTanlangan matnni aytish\u201D funksiyasidan foydalanadi, u hozir o\u2018chirilgan. Uni Maxsus imkoniyatlar sozlamalarida yoqing, keyin qayta urinib ko\u2018ring."
          }
        },
        "xh-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Read Selected isebenzisa i-\u201CSpeak selection,\u201D ye-macOS, ecinyiweyo ngoku. Yivule kwiisetingi Zokufikeleleka, uze uzame kwakhona."
          }
        },
        "yo-NG": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0144 lo \u201CSpeak selection\u201D ti macOS, \u00E8y\u00ED t\u00ED a ti pa b\u00E1y\u00EC\u00ED. Tan \u00E1n n\u00EDn\u00FA \u00E0w\u1ECDn \u00E8t\u00F2 Accessibility, k\u00ED o s\u00EC t\u00FAn gb\u00ECy\u00E0nj\u00FA."
          }
        },
        "zu-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Read Selected isebenzisa i-\u201CSpeak selection\u201D ye-macOS, evaliwe njengamanje. Yivule kuzilungiselelo ze-Accessibility, bese uzama futhi."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa la funci\u00F3n \u201CEnunciar selecci\u00F3n\u201D de macOS, que est\u00E1 desactivada. Act\u00EDvala en la configuraci\u00F3n de Accesibilidad y vuelve a intentarlo."
          }
        },
        "es-CO": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa la funci\u00F3n \u201CLeer selecci\u00F3n\u201D de macOS, que est\u00E1 desactivada. Act\u00EDvela en los ajustes de Accesibilidad y vuelva a intentarlo."
          }

        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u0422\u0430\u04A3\u0434\u0430\u043B\u0493\u0430\u043D\u0434\u044B \u043E\u049B\u0443\u00BB \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u0441\u044B \u049B\u0430\u0442\u0435 \u0442\u0435\u0440\u0435\u0437\u0435\u0434\u0435\u043D \u043E\u049B\u044B\u0493\u0430\u043D \u0431\u043E\u043B\u0443\u044B \u043C\u04AF\u043C\u043A\u0456\u043D. \u041C\u04D9\u0442\u0456\u043D\u0456\u04A3\u0456\u0437\u0433\u0435 \u04E9\u0442\u0456\u043F, \u049B\u0430\u0439\u0442\u0430\u043B\u0430\u043F \u043A\u04E9\u0440\u0456\u04A3\u0456\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u17A2\u17B6\u1793\u17A2\u178F\u17D2\u1790\u1794\u1791\u178A\u17C2\u179B\u1794\u17B6\u1793\u1787\u17D2\u179A\u17BE\u179F\u179A\u17BE\u179F \u17A2\u17B6\u1785\u1793\u17B9\u1784\u1794\u17B6\u1793\u17A2\u17B6\u1793\u1794\u1784\u17D2\u17A2\u17BD\u1785\u1781\u17BB\u179F\u17D4 \u179F\u17BC\u1798\u1785\u17BB\u1785\u1785\u17BC\u179B\u1791\u17C5\u1780\u17D2\u1793\u17BB\u1784\u17A2\u178F\u17D2\u1790\u1794\u1791\u179A\u1794\u179F\u17CB\u17A2\u17D2\u1793\u1780 \u17A0\u17BE\u1799\u1796\u17D2\u1799\u17B6\u1799\u17B6\u1798\u1798\u17D2\u178F\u1784\u1791\u17C0\u178F\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u091A\u0941\u0915\u0940\u091A\u0940 \u0935\u093F\u0902\u0921\u094B \u0935\u093E\u091A\u093F\u0932\u094D\u0932\u0940 \u0906\u0938\u0942\u0902 \u092F\u0947\u0924\u093E. \u0924\u0941\u092E\u091A\u094D\u092F\u093E \u092E\u091C\u0915\u0941\u0930\u093E\u0902\u0924 \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u093E\u0924 \u0906\u0928\u0940 \u092A\u0930\u0924 \u092F\u0924\u094D\u0928 \u0915\u0930\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gali b\u016Bti, kad funkcija \u201ESkaityti pasirinkim\u0105\u201C perskait\u0117 ne t\u0105 lang\u0105. Spustel\u0117kite savo tekst\u0105 ir bandykite dar kart\u0105."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcija Las\u012Bt atlas\u012Bto, iesp\u0113jams, nolas\u012Bja nepareizo logu. Noklik\u0161\u0137iniet tekst\u0101 un m\u0113\u0123iniet v\u0113lreiz."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0C86\u0CAF\u0CCD\u0C95\u0CC6 \u0CAE\u0CBE\u0CA1\u0CBF\u0CA6 \u0CAA\u0CA0\u0CCD\u0CAF \u0C93\u0CA6\u0CC1\u0CB5\u0CBF\u0C95\u0CC6\u0CAF\u0CC1 \u0CA4\u0CAA\u0CCD\u0CAA\u0CC1 \u0CB5\u0CBF\u0C82\u0CA1\u0CCB\u0CB5\u0CA8\u0CCD\u0CA8\u0CC1 \u0C93\u0CA6\u0CBF\u0CB0\u0CAC\u0CB9\u0CC1\u0CA6\u0CC1. \u0CA8\u0CBF\u0CAE\u0CCD\u0CAE \u0CAA\u0CA0\u0CCD\u0CAF\u0CA6 \u0C92\u0CB3\u0C97\u0CC6 \u0C95\u0CCD\u0CB2\u0CBF\u0C95\u0CCD \u0CAE\u0CBE\u0CA1\u0CBF \u0CAE\u0CA4\u0CCD\u0CA4\u0CC6 \u0CAA\u0CCD\u0CB0\u0CAF\u0CA4\u0CCD\u0CA8\u0CBF\u0CB8\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u0427\u0438\u0442\u0430\u0458 \u0438\u0437\u0431\u0440\u0430\u043D\u043E\u201C \u043C\u043E\u0436\u0435\u0431\u0438 \u0433\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430 \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u0438\u043E\u0442 \u043F\u0440\u043E\u0437\u043E\u0440\u0435\u0446. \u041A\u043B\u0438\u043A\u043D\u0435\u0442\u0435 \u0432\u043E \u0442\u0435\u043A\u0441\u0442\u043E\u0442 \u0438 \u043E\u0431\u0438\u0434\u0435\u0442\u0435 \u0441\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0D24\u0D3F\u0D30\u0D1E\u0D4D\u0D1E\u0D46\u0D1F\u0D41\u0D24\u0D4D\u0D24\u0D24\u0D4D \u0D35\u0D3E\u0D2F\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15 \u0D0E\u0D28\u0D4D\u0D28\u0D24\u0D4D \u0D24\u0D46\u0D31\u0D4D\u0D31\u0D3E\u0D2F \u0D35\u0D3F\u0D7B\u0D21\u0D4B \u0D35\u0D3E\u0D2F\u0D3F\u0D1A\u0D4D\u0D1A\u0D3F\u0D30\u0D3F\u0D15\u0D4D\u0D15\u0D3E\u0D02. \u0D28\u0D3F\u0D19\u0D4D\u0D19\u0D33\u0D41\u0D1F\u0D46 \u0D1F\u0D46\u0D15\u0D4D\u0D38\u0D4D\u0D31\u0D4D\u0D31\u0D3F\u0D7D \u0D15\u0D4D\u0D32\u0D3F\u0D15\u0D4D\u0D15\u0D4D \u0D1A\u0D46\u0D2F\u0D4D\u0D24\u0D4D \u0D35\u0D40\u0D23\u0D4D\u0D1F\u0D41\u0D02 \u0D36\u0D4D\u0D30\u0D2E\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected jista\u0027 jkun qara mit-tieqa l-\u0127a\u017Cina. Ikklikkja fit-test tieg\u0127ek u er\u0121a\u0027 pprova."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opp merket tekst kan ha lest opp feil vindu. Klikk i teksten din og pr\u00F8v igjen."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0932\u0947 \u0917\u0932\u0924 \u0935\u093F\u0928\u094D\u0921\u094B \u092A\u0922\u0947\u0915\u094B \u0939\u0941\u0928 \u0938\u0915\u094D\u091B\u0964 \u0906\u092B\u094D\u0928\u094B \u092A\u093E\u0920\u092E\u093E \u0915\u094D\u0932\u093F\u0915 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D \u0930 \u092B\u0947\u0930\u093F \u092A\u094D\u0930\u092F\u093E\u0938 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0B1A\u0B5F\u0B28\u0B3F\u0B24 \u0B2A\u0B22\u0B3C\u0B28\u0B4D\u0B24\u0B41 \u0B2D\u0B41\u0B32\u0B4D \u0B71\u0B3F\u0B23\u0B4D\u0B21\u0B4B \u0B2A\u0B22\u0B3C\u0B3F\u0B25\u0B3E\u0B07\u0B2A\u0B3E\u0B30\u0B47\u0964 \u0B06\u0B2A\u0B23\u0B19\u0B4D\u0B15 \u0B2A\u0B3E\u0B20\u0B4D\u0B5F\u0B30\u0B47 \u0B15\u0B4D\u0B32\u0B3F\u0B15\u0B4D \u0B15\u0B30\u0B3F \u0B2A\u0B41\u0B23\u0B3F \u0B1A\u0B47\u0B37\u0B4D\u0B1F\u0B3E \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41\u0964"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0A1A\u0A41\u0A23\u0A3F\u0A06 \u0A2A\u0A5C\u0A4D\u0A39\u0A4B \u0A28\u0A47 \u0A17\u0A32\u0A24 \u0A35\u0A3F\u0A70\u0A21\u0A4B \u0A2A\u0A5C\u0A4D\u0A39\u0A40 \u0A39\u0A4B \u0A38\u0A15\u0A26\u0A40 \u0A39\u0A48\u0964 \u0A06\u0A2A\u0A23\u0A47 \u0A1F\u0A48\u0A15\u0A38\u0A1F \u0A35\u0A3F\u0A71\u0A1A \u0A15\u0A32\u0A3F\u0A71\u0A15 \u0A15\u0A30\u0A4B \u0A05\u0A24\u0A47 \u0A26\u0A41\u0A2C\u0A3E\u0A30\u0A3E \u0A15\u0A4B\u0A38\u0A3C\u0A3F\u0A38\u0A3C \u0A15\u0A30\u0A4B\u0964"
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "\u067C\u0627\u06A9\u0644 \u0634\u0648\u06CC \u0644\u0648\u0633\u062A\u0644 \u0645\u0645\u06A9\u0646 \u063A\u0644\u0637\u0647 \u06A9\u0693\u06A9\u06CD \u0644\u0648\u0633\u062A\u0644\u06D0 \u0648\u064A. \u067E\u0647 \u062E\u067E\u0644 \u0645\u062A\u0646 \u06A9\u06D0 \u06A9\u0644\u06CC\u06A9 \u0648\u06A9\u0693\u0626 \u0627\u0648 \u0628\u06CC\u0627 \u0647\u0685\u0647 \u0648\u06A9\u0693\u0626."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que Leer selecci\u00F3n haya le\u00EDdo la ventana incorrecta. Hac\u00E9 clic en tu texto e intent\u00E1 de nuevo."
          }
        },
        "es-BO": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n pudo haber le\u00EDdo la ventana equivocada. Haga clic en su texto e int\u00E9ntelo de nuevo."
          }
        },
        "gd-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dh\u0027fhaodadh gun do leugh \u201CLeugh an taghadh\u201D an uinneag che\u00E0rr. Briog a-steach don teacsa agad agus feuch ris a-rithist."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043E\u043D\u0433\u043E\u0441\u043E\u043D \u0445\u044D\u0441\u0433\u0438\u0439\u0433 \u0443\u043D\u0448\u0438\u0445\u0434\u0430\u0430 \u0431\u0443\u0440\u0443\u0443 \u0446\u043E\u043D\u0445\u044B\u0433 \u0443\u043D\u0448\u0441\u0430\u043D \u0431\u0430\u0439\u0436 \u043C\u0430\u0433\u0430\u0434\u0433\u04AF\u0439. \u0422\u0435\u043A\u0441\u0442\u044D\u043D \u0434\u044D\u044D\u0440\u044D\u044D \u0434\u0430\u0440\u0430\u0430\u0434 \u0434\u0430\u0445\u0438\u043D \u043E\u0440\u043E\u043B\u0434\u043E\u043D\u043E \u0443\u0443."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca yang Dipilih mungkin telah membaca daripada tetingkap yang salah. Klik pada teks anda dan cuba semula."
          }
        },
        "ro-RO": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil ca func\u021Bia Citire selec\u021Bie s\u0103 fi citit din fereastra gre\u0219it\u0103. Face\u021Bi clic \u00EEn text \u0219i \u00EEncerca\u021Bi din nou."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u043D\u0435 \u0442\u043E\u0433\u043E \u043E\u043A\u043D\u0430. \u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u0432 \u043D\u0443\u0436\u043D\u043E\u043C \u0442\u0435\u043A\u0441\u0442\u0435 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0443."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0686\u0648\u0646\u068A\u064A\u0644 \u067E\u0699\u0647\u0648 \u0634\u0627\u064A\u062F \u063A\u0644\u0637 \u0648\u0646\u068A\u0648 \u067E\u0699\u0647\u064A \u0686\u06AA\u0648 \u0647\u062C\u064A. \u067E\u0646\u0647\u0646\u062C\u064A \u0645\u062A\u0646 \u06FE \u06AA\u0644\u06AA \u06AA\u0631\u064A\u0648 \u06FD \u067B\u064A\u0647\u0631 \u06AA\u0648\u0634\u0634 \u06AA\u0631\u064A\u0648."
          }
        },
        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0DAD\u0DDD\u0DBB\u0DCF\u0D9C\u0DAD\u0DCA \u0DAF\u0DDA \u0D9A\u0DD2\u0DBA\u0DC0\u0DD3\u0DB8 \u0DC0\u0DD0\u0DBB\u0DAF\u0DD2 \u0D9A\u0DC0\u0DD4\u0DC5\u0DD4\u0DC0\u0D9A\u0DD2\u0DB1\u0DCA \u0D9A\u0DD2\u0DBA\u0DC0\u0DCF \u0DAD\u0DD2\u0DB6\u0DD2\u0DBA \u0DC4\u0DD0\u0D9A. \u0D94\u0DB6\u0DDA \u0DB4\u0DD9\u0DC5 \u0DAD\u0DD4\u0DC5\u0DA7 \u0D9A\u0DCA\u0DBD\u0DD2\u0D9A\u0DCA \u0D9A\u0DBB \u0DB1\u0DD0\u0DC0\u0DAD \u0D8B\u0DAD\u0DCA\u0DC3\u0DCF\u0DC4 \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1."
          }
        },
        "sk-SK": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcia Pre\u010D\u00EDta\u0165 v\u00FDber mohla pre\u010D\u00EDta\u0165 nespr\u00E1vne okno. Kliknite do svojho textu a sk\u00FAste to znova."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcija Preberi izbrano je morda prebrala napa\u010Dno okno. Kliknite v besedilo in poskusite znova."
          }
        },
        "cy-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae\u0027n bosibl bod Darllen y Dewisiad wedi darllen y ffenestr anghywir. Cliciwch i mewn i\u0027ch testun a rhowch gynnig arall arni."
          }
        },
        "sr-Latn-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcija \u201E\u010Citaj izabrano\u201C je mo\u017Eda pro\u010Ditala pogre\u0161an prozor. Kliknite u tekst i poku\u0161ajte ponovo."
          }
        },
        "sw-KE": {
          "stringUnit": {
            "state": "translated",
            "value": "Soma Yaliyochaguliwa huenda imesoma dirisha lisilo sahihi. Bofya ndani ya maandishi yako kisha ujaribu tena."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0BA4\u0BC7\u0BB0\u0BCD\u0BA8\u0BCD\u0BA4\u0BC6\u0B9F\u0BC1\u0BA4\u0BCD\u0BA4\u0BA4\u0BC8 \u0BB5\u0BBE\u0B9A\u0BBF \u0BA4\u0BB5\u0BB1\u0BBE\u0BA9 \u0B9A\u0BBE\u0BB3\u0BB0\u0BA4\u0BCD\u0BA4\u0BC8 \u0BB5\u0BBE\u0B9A\u0BBF\u0BA4\u0BCD\u0BA4\u0BBF\u0BB0\u0BC1\u0B95\u0BCD\u0B95\u0BB2\u0BBE\u0BAE\u0BCD. \u0B89\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0B89\u0BB0\u0BC8\u0BAF\u0BBF\u0BB2\u0BCD \u0B95\u0BBF\u0BB3\u0BBF\u0B95\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BA4\u0BC1 \u0BAE\u0BC0\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BAF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
          }
        },
        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0E01\u0E32\u0E23\u0E2D\u0E48\u0E32\u0E19\u0E2A\u0E48\u0E27\u0E19\u0E17\u0E35\u0E48\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E2D\u0E32\u0E08\u0E2D\u0E48\u0E32\u0E19\u0E1C\u0E34\u0E14\u0E2B\u0E19\u0E49\u0E32\u0E15\u0E48\u0E32\u0E07 \u0E04\u0E25\u0E34\u0E01\u0E17\u0E35\u0E48\u0E02\u0E49\u0E2D\u0E04\u0E27\u0E32\u0E21\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E41\u0E25\u0E49\u0E27\u0E25\u0E2D\u0E07\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07"
          }
        },
        "ti-ER": {
          "stringUnit": {
            "state": "translated",
            "value": "\u1295\u12DD\u1270\u1218\u122D\u1338 \u12A3\u1295\u1265\u1265 \u12D8\u12ED\u1245\u1291\u12D5 \u1218\u1235\u12AE\u1275 \u12A3\u1295\u1262\u1261 \u12AD\u12B8\u12CD\u1295 \u12ED\u12BD\u12A5\u120D\u1362 \u12A3\u1265 \u133D\u1211\u134D\u12AB \u1320\u12CD\u1255 \u12A5\u121E \u12A5\u1295\u12F0\u1308\u1293 \u1348\u1275\u1295\u1362"
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",

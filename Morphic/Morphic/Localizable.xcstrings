    "ContrastAutomationFailedMessage": {
      "comment": "[loc-id:bbeecdb44a5cb52f] Notification toast body shown when Morphic could not toggle Increase Contrast automatically, asking the user to do it in Accessibility settings. \u0022Morphic\u0022 is a product name; \u0022Increase Contrast\u0022 is the macOS Accessibility setting (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic couldn\u2019t switch Increase Contrast automatically. Open Accessibility settings to toggle it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic konnte \u201EKontrast erh\u00F6hen\u201C nicht automatisch umschalten. \u00D6ffnen Sie die Bedienungshilfen, um es umzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic no pudo cambiar Aumentar contraste autom\u00E1ticamente. Abre la configuraci\u00F3n de Accesibilidad para activarlo o desactivarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0639\u0630\u0651\u0631 \u0639\u0644\u0649 Morphic \u062A\u0628\u062F\u064A\u0644 \u0632\u064A\u0627\u062F\u0629 \u0627\u0644\u062A\u0628\u0627\u064A\u0646 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627. \u0627\u0641\u062A\u062D \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0644\u062A\u0628\u062F\u064A\u0644\u0647."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0646\u062A\u0648\u0627\u0646\u0633\u062A \u00AB\u0627\u0641\u0632\u0627\u06CC\u0634 \u06A9\u0646\u062A\u0631\u0627\u0633\u062A\u00BB \u0631\u0627 \u0628\u0647\u200C\u0637\u0648\u0631 \u062E\u0648\u062F\u06A9\u0627\u0631 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F. \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u06CC\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0627 \u0628\u0627\u0632 \u06A9\u0646\u06CC\u062F \u062A\u0627 \u0622\u0646 \u0631\u0627 \u0631\u0648\u0634\u0646 \u06CC\u0627 \u062E\u0627\u0645\u0648\u0634 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0A86\u0AAA\u0AAE\u0AC7\u0AB3\u0AC7 \u0A95\u0ACB\u0AA8\u0ACD\u0A9F\u0ACD\u0AB0\u0ABE\u0AB8\u0ACD\u0A9F \u0AB5\u0AA7\u0ABE\u0AB0\u0ACB \u0AB8\u0ACD\u0AB5\u0ABF\u0A9A \u0A95\u0AB0\u0AC0 \u0AB6\u0A95\u0ACD\u0AAF\u0AC1\u0A82 \u0AA8\u0AA5\u0AC0. \u0AA4\u0AC7\u0AA8\u0AC7 \u0A9F\u0AC9\u0A97\u0AB2 \u0A95\u0AB0\u0AB5\u0ABE \u0AAE\u0ABE\u0A9F\u0AC7 \u0A8D\u0A95\u0ACD\u0AB8\u0AC7\u0AB8\u0ABF\u0AAC\u0ABF\u0AB2\u0ABF\u0A9F\u0AC0 \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8 \u0A96\u0ACB\u0AB2\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0938\u094D\u0935\u091A\u093E\u0932\u093F\u0924 \u0930\u0942\u092A \u0938\u0947 \u0915\u0902\u091F\u094D\u0930\u093E\u0938\u094D\u091F \u092C\u0922\u093C\u093E\u090F\u0901 \u0915\u094B \u0938\u094D\u0935\u093F\u091A \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u093E\u0964 \u0907\u0938\u0947 \u091F\u0949\u0917\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u090F\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u0916\u094B\u0932\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic\uC5D0\uC11C \uB300\uBE44 \uC99D\uAC00\uB97C \uC790\uB3D9\uC73C\uB85C \uC804\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC190\uC26C\uC6B4 \uC0AC\uC6A9 \uC124\uC815\uC744 \uC5F4\uC5B4 \uC9C1\uC811 \uC804\uD658\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0938\u094D\u0935\u092F\u0902\u091A\u0932\u093F\u0924\u092A\u0923\u0947 Increase Contrast \u092C\u0926\u0932\u0942 \u0936\u0915\u0932\u0947 \u0928\u093E\u0939\u0940. \u0924\u0947 \u091F\u0949\u0917\u0932 \u0915\u0930\u0923\u094D\u092F\u093E\u0938\u093E\u0920\u0940 Accessibility \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C \u0909\u0918\u0921\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062E\u0648\u062F\u06A9\u0627\u0631 \u0637\u0648\u0631 \u067E\u0631 Increase Contrast \u06A9\u0648 \u062A\u0628\u062F\u06CC\u0644 \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u0627\u06D4 \u0627\u0633\u06D2 \u0622\u0646 \u06CC\u0627 \u0622\u0641 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Accessibility \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u06A9\u06BE\u0648\u0644\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kh\u00F4ng th\u1EC3 t\u1EF1 \u0111\u1ED9ng chuy\u1EC3n \u0111\u1ED5i T\u0103ng \u0111\u1ED9 t\u01B0\u01A1ng ph\u1EA3n. H\u00E3y m\u1EDF C\u00E0i \u0111\u1EB7t tr\u1EE3 n\u0103ng \u0111\u1EC3 b\u1EADt/t\u1EAFt t\u00EDnh n\u0103ng n\u00E0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u65E0\u6CD5\u81EA\u52A8\u5207\u6362\u201C\u589E\u5F3A\u5BF9\u6BD4\u5EA6\u201D\u3002\u8BF7\u6253\u5F00\u201C\u8F85\u52A9\u529F\u80FD\u201D\u8BBE\u7F6E\u8FDB\u884C\u5207\u6362\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u7121\u6CD5\u81EA\u52D5\u5207\u63DB\u300C\u589E\u52A0\u5C0D\u6BD4\u300D\u3002\u8ACB\u958B\u555F\u300C\u8F14\u52A9\u4F7F\u7528\u300D\u8A2D\u5B9A\u4F86\u5207\u63DB\u3002"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic non \u00E8 riuscito a modificare automaticamente l\u2019opzione Aumenta contrasto. Apri le impostazioni di Accessibilit\u00E0 per attivarla o disattivarla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05DC-Morphic \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D0\u05E4\u05E9\u05E8\u05D5\u05EA \u05DC\u05E9\u05E0\u05D5\u05EA \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05D0\u05EA \u05F4\u05D4\u05D2\u05D3\u05DC\u05EA \u05D4\u05E0\u05D9\u05D2\u05D5\u05D3\u05D9\u05D5\u05EA\u05F4. \u05D9\u05E9 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05D0\u05EA \u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E4\u05E2\u05D9\u05DC \u05D0\u05D5 \u05DC\u05DB\u05D1\u05D5\u05EA \u05D0\u05D5\u05EA\u05D4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u306F\u300C\u30B3\u30F3\u30C8\u30E9\u30B9\u30C8\u3092\u4E0A\u3052\u308B\u300D\u3092\u81EA\u52D5\u7684\u306B\u5207\u308A\u66FF\u3048\u3089\u308C\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u30A2\u30AF\u30BB\u30B7\u30D3\u30EA\u30C6\u30A3\u8A2D\u5B9A\u3092\u958B\u3044\u3066\u5207\u308A\u66FF\u3048\u3066\u304F\u3060\u3055\u3044\u3002"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kunne ikke automatisk \u00E6ndre For\u00F8g kontrast. \u00C5bn indstillingerne for Tilg\u00E6ngelighed for at sl\u00E5 det til eller fra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic ei voinut vaihtaa Lis\u00E4\u00E4 kontrastia -asetusta automaattisesti. Ota se k\u00E4ytt\u00F6\u00F6n tai poista k\u00E4yt\u00F6st\u00E4 K\u00E4ytt\u00F6apu-asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic n\u2019a pas pu activer ou d\u00E9sactiver automatiquement Augmenter le contraste. Ouvrez les r\u00E9glages Accessibilit\u00E9 pour le faire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic n\u2019a pas pu activer Augmenter le contraste automatiquement. Ouvrez les r\u00E9glages d\u2019accessibilit\u00E9 pour l\u2019activer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kon Verhoog contrast niet automatisch wijzigen. Open Toegankelijkheidsinstellingen om dit in of uit te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic nie m\u00F3g\u0142 automatycznie prze\u0142\u0105czy\u0107 opcji Zwi\u0119ksz kontrast. Otw\u00F3rz ustawienia Dost\u0119pno\u015Bci, aby j\u0105 prze\u0142\u0105czy\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphic n\u00E3o conseguiu alternar a op\u00E7\u00E3o Aumentar Contraste automaticamente. Abra as configura\u00E7\u00F5es de Acessibilidade para ativ\u00E1-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphic n\u00E3o conseguiu mudar a op\u00E7\u00E3o Aumentar Contraste automaticamente. Abra as defini\u00E7\u00F5es de Acessibilidade para a alternar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u03A4\u03BF Morphic \u03B4\u03B5\u03BD \u03BC\u03C0\u03CC\u03C1\u03B5\u03C3\u03B5 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03B9 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C4\u03B7\u03BD \u0391\u03CD\u03BE\u03B7\u03C3\u03B7 \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C3\u03B7\u03C2. \u0391\u03BD\u03BF\u03AF\u03BE\u03C4\u03B5 \u03C4\u03B9\u03C2 \u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03A0\u03C1\u03BF\u03C3\u03B2\u03B1\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C4\u03B7\u03BD \u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5/\u03B1\u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic ei saanud funktsiooni \u201ESuurenda kontrastsust\u201C automaatselt l\u00FClitada. Ava selle l\u00FClitamiseks h\u00F5lbustuse seaded."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kunde inte v\u00E4xla \u00D6ka kontrast automatiskt. \u00D6ppna Hj\u00E4lpmedelsinst\u00E4llningar f\u00F6r att \u00E4ndra det."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062E\u0648\u062F\u06A9\u0627\u0631 \u0637\u0648\u0631 \u067E\u0631 Increase Contrast \u062A\u0628\u062F\u06CC\u0644 \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u0627\u06D4 \u0627\u0633\u06D2 \u0679\u0648\u06AF\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 \u0631\u0633\u0627\u0626\u06CC \u067E\u0630\u06CC\u0631\u06CC \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u06A9\u06BE\u0648\u0644\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kon nie Verhoog Kontras outomaties wissel nie. Maak Toeganklikheid-instellings oop om dit te wissel."
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic Increase Contrast\u1295 \u1260\u122B\u1235-\u1230\u122D \u1218\u1240\u12E8\u122D \u12A0\u120D\u127B\u1208\u121D\u1362 \u1208\u1218\u1240\u12E8\u122D \u12E8\u1270\u12F0\u122B\u123D\u1290\u1275 \u1245\u1295\u1265\u122E\u127D\u1295 \u12ED\u12AD\u1348\u1271\u1362"
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u098F Increase Contrast \u09B8\u09CD\u09AC\u09AF\u09BC\u0982\u0995\u09CD\u09F0\u09BF\u09AF\u09BC\u09AD\u09BE\u09F1\u09C7 \u09B8\u09B2\u09A8\u09BF \u0995\u09F0\u09BF\u09AC \u09A8\u09CB\u09F1\u09BE\u09F0\u09BF\u09B2\u09C7\u0964 \u0987\u09AF\u09BC\u09BE\u0995 \u099F\u0997\u09B2 \u0995\u09F0\u09BF\u09AC\u09B2\u09C8 Accessibility \u099B\u09C7\u099F\u09BF\u0982\u099B \u0996\u09CB\u09B2\u0995\u0964"
          }
        },
        "az-Latn-AZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic Kontrast\u0131 Art\u0131r rejimini avtomatik d\u0259yi\u015Fdir\u0259 bilm\u0259di. Onu d\u0259yi\u015Fdirm\u0259k \u00FC\u00E7\u00FCn \u018Fl\u00E7atanl\u0131q parametrl\u0259rini a\u00E7\u0131n."
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0435 \u045E\u0434\u0430\u043B\u043E\u0441\u044F \u0430\u045E\u0442\u0430\u043C\u0430\u0442\u044B\u0447\u043D\u0430 \u043F\u0435\u0440\u0430\u043A\u043B\u044E\u0447\u044B\u0446\u044C \u00AB\u041F\u0430\u0432\u044F\u043B\u0456\u0447\u044B\u0446\u044C \u043A\u0430\u043D\u0442\u0440\u0430\u0441\u0442\u00BB. \u0410\u0434\u043A\u0440\u044B\u0439\u0446\u0435 \u043D\u0430\u043B\u0430\u0434\u044B \u0441\u043F\u0435\u0446\u044B\u044F\u043B\u044C\u043D\u044B\u0445 \u043C\u0430\u0433\u0447\u044B\u043C\u0430\u0441\u0446\u0435\u0439, \u043A\u0430\u0431 \u0443\u043A\u043B\u044E\u0447\u044B\u0446\u044C \u0430\u0431\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u044B\u0446\u044C \u044F\u0433\u043E."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0435 \u0443\u0441\u043F\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0434\u0430 \u043F\u0440\u0435\u0432\u043A\u043B\u044E\u0447\u0438 \u201E\u0423\u0432\u0435\u043B\u0438\u0447\u0430\u0432\u0430\u043D\u0435 \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0430\u201C. \u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\u0442\u0435 \u0437\u0430 \u0434\u043E\u0441\u0442\u044A\u043F\u043D\u043E\u0441\u0442, \u0437\u0430 \u0434\u0430 \u0433\u043E \u043F\u0440\u0435\u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u09B8\u09CD\u09AC\u09DF\u0982\u0995\u09CD\u09B0\u09BF\u09DF\u09AD\u09BE\u09AC\u09C7 Increase Contrast \u099A\u09BE\u09B2\u09C1/\u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09A4\u09C7 \u09AA\u09BE\u09B0\u09C7\u09A8\u09BF\u0964 \u098F\u099F\u09BF \u099A\u09BE\u09B2\u09C1/\u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09A4\u09C7 Accessibility \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u0996\u09C1\u09B2\u09C1\u09A8\u0964"
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u09B8\u09CD\u09AC\u09AF\u09BC\u0982\u0995\u09CD\u09B0\u09BF\u09AF\u09BC\u09AD\u09BE\u09AC\u09C7 Increase Contrast \u09AA\u09B0\u09BF\u09AC\u09B0\u09CD\u09A4\u09A8 \u0995\u09B0\u09A4\u09C7 \u09AA\u09BE\u09B0\u09C7\u09A8\u09BF\u0964 \u098F\u099F\u09BF \u099F\u0997\u09B2 \u0995\u09B0\u09A4\u09C7 \u0985\u09CD\u09AF\u09BE\u0995\u09CD\u09B8\u09C7\u09B8\u09BF\u09AC\u09BF\u09B2\u09BF\u099F\u09BF \u09B8\u09C7\u099F\u09BF\u0982\u09B8 \u0996\u09C1\u09B2\u09C1\u09A8\u0964"
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic nije mogao automatski uklju\u010Diti Pove\u0107aj kontrast. Otvorite postavke Pristupa\u010Dnosti da ga uklju\u010Dite."
          }
        },
        "ca-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El Morphic no ha pogut canviar l\u0027opci\u00F3 Augmenta el contrast autom\u00E0ticament. Obriu la configuraci\u00F3 d\u0027Accessibilitat per activar-la o desactivar-la."
          }
        },
        "eu-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-ek ezin izan du Areagotu kontrastea automatikoki aldatu. Ireki Erabilerraztasun-ezarpenak hura aldatzeko."
          }
        },
        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u0568 \u0579\u056F\u0561\u0580\u0578\u0572\u0561\u0581\u0561\u057E \u056B\u0576\u0584\u0576\u0561\u0562\u0565\u0580\u0561\u0562\u0561\u0580 \u0583\u0578\u056D\u0561\u0580\u056F\u0565\u056C \u00AB\u0532\u0561\u0580\u0571\u0580\u0561\u0581\u0576\u0565\u056C \u056F\u0578\u0576\u057F\u0580\u0561\u057D\u057F\u0568\u00BB\u0589 \u0532\u0561\u0581\u0565\u0584 \u0544\u0561\u057F\u0579\u0565\u056C\u056B\u0578\u0582\u0569\u0575\u0561\u0576 \u056F\u0561\u0580\u0563\u0561\u057E\u0578\u0580\u0578\u0582\u0574\u0576\u0565\u0580\u0568\u055D \u0561\u0575\u0576 \u0583\u0578\u056D\u0561\u0580\u056F\u0565\u056C\u0578\u0582 \u0570\u0561\u0574\u0561\u0580\u0589"
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062E\u0648\u062F \u0628\u062E\u0648\u062F Increase Contrast \u06A9\u0648 \u0633\u0648\u0626\u0686 \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u0627\u06D4 \u0627\u0633\u06D2 \u0679\u0648\u06AF\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 \u0627\u06CC\u06A9\u0633\u06CC\u0633\u0628\u06CC\u0644\u0679\u06CC \u0633\u06CC\u0679\u0646\u06AF\u0632 \u06A9\u06BE\u0648\u0644\u06CC\u06BA\u06D4"
          }
        },
        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic nemohl automaticky p\u0159epnout Zv\u00FD\u0161it kontrast. Otev\u0159ete nastaven\u00ED Zp\u0159\u00EDstupn\u011Bn\u00ED a p\u0159epn\u011Bte ho ru\u010Dn\u011B."
          }
        },
        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0787\u07A6\u0781\u07B0 \u0787\u07AE\u0793\u07AE\u0789\u07AC\u0793\u07A8\u0786\u07AA\u0782\u07B0 Increase Contrast \u0784\u07A6\u078B\u07A6\u078D\u07AC\u0787\u07B0 \u0782\u07AA\u0786\u07AA\u0783\u07AC\u0788\u07AA\u0782\u07AC\u0788\u07AC. \u0787\u07AC \u0793\u07AE\u078E\u07A6\u078D\u07B0 \u0786\u07AA\u0783\u07AA\u0789\u07A6\u0781\u07B0 Accessibility \u0790\u07AC\u0793\u07A8\u0782\u07B0\u078E\u07B0\u0790\u07B0 \u0780\u07AA\u0785\u07AA\u0788\u07A7\u0781\u07AC\u0788\u07AC."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic couldn\u2019t switch Increase Contrast automatically. Open Accessibility settings to toggle it."
          }
        },
        "en-CA": {

    "ReadSelectedPlayAccessibleName": {
      "comment": "[loc-id:20dc9650e6ce4cd4] VoiceOver/accessibility label for the Read Selected play/stop button on the MorphicBar; starts reading the user\u0027s selected text aloud.",
      "extractionState": "manual",
      "localizations": {

        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091A\u0941\u0928\u0947 \u0939\u0941\u090F \u092A\u093E\u0920 \u092A\u0922\u093C\u0947\u0902"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uC120\uD0DD\uD55C \uD14D\uC2A4\uD2B8 \uC77D\uAE30"
          }
        },
        "mr": {
          "stringUnit": {

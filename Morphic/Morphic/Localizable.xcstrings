    "AboutBuildFormat": {
      "comment": "[loc-id:05081f5508eb466a] About box build line. %@ = build number, supplied from code. Keep the parentheses. Short fragment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(build %@)"
          }
        },
        "de": {

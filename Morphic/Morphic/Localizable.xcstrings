        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u0D28\u0D4D \u0D15\u0D4B\u0D7A\u0D1F\u0D4D\u0D30\u0D3E\u0D38\u0D4D\u0D31\u0D4D\u0D31\u0D4D \u0D35\u0D7C\u0D26\u0D4D\u0D27\u0D3F\u0D2A\u0D4D\u0D2A\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D28\u0D4D\u0D28\u0D24\u0D4D \u0D38\u0D4D\u0D35\u0D2F\u0D2E\u0D47\u0D35 \u0D2E\u0D3E\u0D31\u0D4D\u0D31\u0D3E\u0D7B \u0D15\u0D34\u0D3F\u0D1E\u0D4D\u0D1E\u0D3F\u0D32\u0D4D\u0D32. \u0D07\u0D24\u0D4D \u0D1F\u0D4B\u0D17\u0D3F\u0D7E \u0D1A\u0D46\u0D2F\u0D4D\u0D2F\u0D3E\u0D7B \u0D2A\u0D4D\u0D30\u0D35\u0D47\u0D36\u0D28\u0D15\u0D4D\u0D37\u0D2E\u0D24 \u0D15\u0D4D\u0D30\u0D2E\u0D40\u0D15\u0D30\u0D23\u0D19\u0D4D\u0D19\u0D7E \u0D24\u0D41\u0D31\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u044C \u0422\u043E\u0434\u043E\u0441\u0433\u043E\u043B\u044B\u0433 \u043D\u044D\u043C\u044D\u0433\u0434\u04AF\u04AF\u043B\u044D\u0445-\u0438\u0439\u0433 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430\u0430\u0440 \u0441\u044D\u043B\u0433\u044D\u0436 \u0447\u0430\u0434\u0441\u0430\u043D\u0433\u04AF\u0439. \u0425\u04AF\u0440\u0442\u044D\u044D\u043C\u0436\u0438\u0439\u043D \u0442\u043E\u0445\u0438\u0440\u0433\u043E\u043E\u0433 \u043D\u044D\u044D\u0436 \u0430\u0441\u0430\u0430/\u0443\u043D\u0442\u0440\u0430\u0430."
          }

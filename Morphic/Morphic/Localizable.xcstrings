        "ug-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0627\u0644\u0644\u0627\u0646\u063A\u0627\u0646\u0646\u0649 \u0626\u0648\u0642\u06C7\u0634 \u062E\u0627\u062A\u0627 \u0643\u06C6\u0632\u0646\u06D5\u0643\u0646\u0649 \u0626\u0648\u0642\u06C7\u063A\u0627\u0646 \u0628\u0648\u0644\u06C7\u0634\u0649 \u0645\u06C7\u0645\u0643\u0649\u0646. \u062A\u06D0\u0643\u0649\u0633\u062A\u0649\u06AD\u0649\u0632\u06AF\u06D5 \u0686\u06D0\u0643\u0649\u067E \u0642\u0627\u064A\u062A\u0627 \u0633\u0649\u0646\u0627\u06AD."
          }

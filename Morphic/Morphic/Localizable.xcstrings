          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u094B (\u0926\u093F\u0916\u093E\u090F\u0901)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uBCF4\uC5EC\uC8FC\uB2E4"
          }

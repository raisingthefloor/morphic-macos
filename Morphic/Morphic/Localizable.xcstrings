    "SnipAccessibleName": {
      "comment": "[loc-id:dfd49d019d6441f0] VoiceOver/accessibility label for the Snip \u0022Copy\u0022 button on the MorphicBar; captures part of the screen to the clipboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip and copy part of the screen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmausschnitt erfassen und kopieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar y copiar parte de la pantalla"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0631\u0634 \u0648 \u06A9\u067E\u06CC \u0628\u062E\u0634\u06CC \u0627\u0632 \u0635\u0641\u062D\u0647\u200C\u0646\u0645\u0627\u06CC\u0634"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0915\u094D\u0930\u0940\u0928 \u0915\u093E \u0939\u093F\u0938\u094D\u0938\u093E \u0938\u094D\u0928\u093F\u092A \u0915\u0930\u0947\u0902 \u0914\u0930 \u0915\u0949\u092A\u0940 \u0915\u0930\u0947\u0902"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uD654\uBA74 \uC77C\uBD80 \uCEA1\uCC98 \uBC0F \uBCF5\uC0AC"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0915\u094D\u0930\u0940\u0928\u091A\u093E \u092D\u093E\u0917 \u0938\u094D\u0928\u093F\u092A \u0915\u0930\u093E \u0906\u0923\u093F \u0915\u0949\u092A\u0940 \u0915\u0930\u093E"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u06A9\u0631\u06CC\u0646 \u06A9\u06D2 \u062D\u0635\u06D2 \u06A9\u0648 \u062A\u0631\u0627\u0634\u06CC\u06BA \u0627\u0648\u0631 \u06A9\u0627\u067E\u06CC \u06A9\u0631\u06CC\u06BA"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1EE5p v\u00E0 sao ch\u00E9p m\u1ED9t ph\u1EA7n m\u00E0n h\u00ECnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u622A\u53D6\u5E76\u590D\u5236\u5C4F\u5E55\u7684\u4E00\u90E8\u5206"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526A\u53D6\u4E26\u8907\u88FD\u90E8\u5206\u87A2\u5E55\u756B\u9762"
          }
        }
      }
    },
    "SnipCopyLabel": {
      "comment": "[loc-id:ea4debfd136f421f] Short button label on the MorphicBar; snips (captures) part of the screen and copies it to the clipboard. Very short to fit the button.",
      "extractionState": "manual",
      "localizations": {

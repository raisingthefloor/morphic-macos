        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0DC4\u0DA7 \u0DB4\u0DCA\u200D\u0DBB\u0DAD\u0DD2\u0DC0\u0DD2\u0DBB\u0DD4\u0DAF\u0DCA\u0DB0\u0DAD\u0DCF\u0DC0 \u0DC0\u0DD0\u0DA9\u0DD2 \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8 \u0DC3\u0DCA\u0DC0\u0DBA\u0D82\u0D9A\u0DCA\u200D\u0DBB\u0DD3\u0DBA\u0DC0 \u0DB8\u0DCF\u0DBB\u0DD4 \u0D9A\u0DC5 \u0DB1\u0DDC\u0DC4\u0DD0\u0D9A\u0DD2 \u0DC0\u0DD2\u0DBA. \u0D91\u0DBA \u0DB8\u0DCF\u0DBB\u0DD4 \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8\u0DA7 \u0DB4\u0DCA\u200D\u0DBB\u0DC0\u0DDA\u0DC1 \u0DB4\u0DC4\u0DC3\u0DD4\u0D9A\u0DB8\u0DCA \u0DC3\u0DD0\u0D9A\u0DC3\u0DD4\u0DB8\u0DCA \u0DC0\u0DD2\u0DC0\u0DD8\u0DAD \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1."

        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0B38\u0B4D\u0B71\u0B5F\u0B02\u0B1A\u0B3E\u0B33\u0B3F\u0B24 \u0B2D\u0B3E\u0B2C\u0B47 Increase Contrast \u0B2C\u0B26\u0B33\u0B3E\u0B07 \u0B2A\u0B3E\u0B30\u0B3F\u0B32\u0B3E \u0B28\u0B3E\u0B39\u0B3F\u0B01\u0964 \u0B0F\u0B39\u0B3E\u0B15\u0B41 \u0B1F\u0B4B\u0B17\u0B32\u0B4D \u0B15\u0B30\u0B3F\u0B2C\u0B3E\u0B15\u0B41 Accessibility \u0B38\u0B47\u0B1F\u0B3F\u0B02\u0B38\u0B4D \u0B16\u0B4B\u0B32\u0B28\u0B4D\u0B24\u0B41\u0964"

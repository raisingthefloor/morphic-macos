        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic ma setax jaqleb Increase Contrast awtomatikament. Ifta\u0127 is-settings tal-A\u010B\u010Bessibbilt\u00E0 biex tixeg\u0127lu jew titfih."
          }

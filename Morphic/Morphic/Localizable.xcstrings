        "nn-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplesing av merkt tekst kan ha lese fr\u00E5 feil vindauge. Klikk i teksten din og pr\u00F8v p\u00E5 nytt."
          }
        }
      }
    },

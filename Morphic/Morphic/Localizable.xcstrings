        "lb-LU": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u0027Bildschiermopnam gouf erlaabt. Start Morphic nei, fir d\u0027\u00C4nnerung z\u0027iwwerhuelen."
          }
        },
        "mi-NZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Kua whakaaetia te Screen Recording. T\u012Bmata an\u014D i a Morphic kia whai mana ai te panonitanga."
          }
        },
        "nn-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00F8yve til skjermopptak er gjeve. Start Morphic p\u00E5 nytt for at endringa skal tre i kraft."
          }
        },
        "quz-PE": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording saqisqa\u00F1a. Morphic kaqmanta qallarichiy chay hukmanyasqa llamk\u0027ananpaq."
          }
        },
        "sq-AL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leja p\u00EBr Regjistrimin e ekranit u dha. Rinisni Morphic q\u00EB ndryshimi t\u00EB hyj\u00EB n\u00EB fuqi."
          }
        },
        "sr-Cyrl-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043D\u0438\u043C\u0430\u045A\u0435 \u0435\u043A\u0440\u0430\u043D\u0430 \u0458\u0435 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u043E. \u041F\u043E\u043D\u043E\u0432\u043E \u043F\u043E\u043A\u0440\u0435\u043D\u0438\u0442\u0435 Morphic \u0434\u0430 \u0431\u0438 \u043F\u0440\u043E\u043C\u0458\u0435\u043D\u0430 \u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043D\u0430 \u0441\u043D\u0430\u0433\u0443."
          }
        },
        "sr-Cyrl-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043D\u0438\u043C\u0430\u045A\u0435 \u0435\u043A\u0440\u0430\u043D\u0430 \u0458\u0435 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u043E. \u041F\u043E\u043D\u043E\u0432\u043E \u043F\u043E\u043A\u0440\u0435\u043D\u0438\u0442\u0435 Morphic \u0434\u0430 \u0431\u0438 \u043F\u0440\u043E\u043C\u0435\u043D\u0430 \u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043D\u0430 \u0441\u043D\u0430\u0433\u0443."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0C38\u0C4D\u0C15\u0C4D\u0C30\u0C40\u0C28\u0C4D \u0C30\u0C3F\u0C15\u0C3E\u0C30\u0C4D\u0C21\u0C3F\u0C02\u0C17\u0C4D \u0C05\u0C28\u0C41\u0C2E\u0C24\u0C3F\u0C02\u0C1A\u0C2C\u0C21\u0C3F\u0C02\u0C26\u0C3F. \u0C2E\u0C3E\u0C30\u0C4D\u0C2A\u0C41 \u0C05\u0C2E\u0C32\u0C41\u0C32\u0C4B\u0C15\u0C3F \u0C30\u0C3E\u0C35\u0C21\u0C3E\u0C28\u0C3F\u0C15\u0C3F Morphic\u0C28\u0C3F \u0C2A\u0C41\u0C28\u0C03\u0C2A\u0C4D\u0C30\u0C3E\u0C30\u0C02\u0C2D\u0C3F\u0C02\u0C1A\u0C02\u0C21\u0C3F."
          }
        },
        "lo-LA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0EC4\u0E94\u0EC9\u0EAE\u0EB1\u0E9A\u0E81\u0EB2\u0E99\u0EAD\u0EB0\u0E99\u0EB8\u0E8D\u0EB2\u0E94 Screen Recording \u0EC1\u0EA5\u0EC9\u0EA7. \u0E81\u0EB0\u0EA5\u0EB8\u0E99\u0EB2\u0EC0\u0EA5\u0EB5\u0EC8\u0EA1 Morphic \u0EC3\u0EDD\u0EC8\u0EC0\u0E9E\u0EB7\u0EC8\u0EAD\u0EC3\u0EAB\u0EC9\u0E81\u0EB2\u0E99\u0E9B\u0EC8\u0EBD\u0E99\u0EC1\u0E9B\u0E87\u0EA1\u0EB5\u0E9C\u0EBB\u0E99."
          }
        },
        "tt-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042D\u043A\u0440\u0430\u043D \u044F\u0437\u0434\u044B\u0440\u0443 \u0440\u04E9\u0445\u0441\u04D9\u0442 \u0438\u0442\u0435\u043B\u0434\u0435. \u04AE\u0437\u0433\u04D9\u0440\u0435\u0448 \u043A\u04E9\u0447\u0435\u043D\u04D9 \u043A\u0435\u0440\u0441\u0435\u043D \u04E9\u0447\u0435\u043D, Morphic-\u043D\u044B \u044F\u04A3\u0430\u0434\u0430\u043D \u044D\u0448\u043B\u04D9\u0442\u0435\u043F \u0497\u0438\u0431\u04D9\u0440\u0435\u0433\u0435\u0437."
          }
        },
        "ug-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0626\u06D0\u0643\u0631\u0627\u0646 \u062E\u0627\u062A\u0649\u0631\u0649\u0644\u06D5\u0634 \u0631\u06C7\u062E\u0633\u0649\u062A\u0649 \u0628\u06D0\u0631\u0649\u0644\u062F\u0649. \u0626\u06C6\u0632\u06AF\u0649\u0631\u0649\u0634 \u0643\u06C8\u0686\u0643\u06D5 \u0626\u0649\u06AF\u06D5 \u0628\u0648\u0644\u06C7\u0634\u0649 \u0626\u06C8\u0686\u06C8\u0646 Morphic \u0646\u0649 \u0642\u0627\u064A\u062A\u0627 \u0642\u0648\u0632\u063A\u0649\u062A\u0649\u06AD."
          }
        },
        "zu-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Imvume ye-Screen Recording inikeziwe. Qala kabusha i-Morphic ukuze ushintsho lusebenze."
          }
        }
      }
    },
    "SettingsDialogBlockingMessage": {
      "comment": "[loc-id:82900dc9c0dd22cb] Notification toast body shown when Morphic can\u0027t change a setting because System Settings has a modal dialog open that Morphic won\u0027t close automatically. Asks the user to close it and retry. \u0022Morphic\u0022 is a product name; \u0022System Settings\u0022 is the macOS app name (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic versucht, eine Einstellung zu \u00E4ndern, aber in den Systemeinstellungen ist ein Dialogfeld ge\u00F6ffnet, das nicht automatisch geschlossen werden kann. Bitte schlie\u00DFen Sie dieses Dialogfeld und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por ti. Cierra ese cuadro de di\u00E1logo y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064A\u062D\u0627\u0648\u0644 Morphic \u062A\u063A\u064A\u064A\u0631 \u0623\u062D\u062F \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A\u060C \u0648\u0644\u0643\u0646 \u064A\u0648\u062C\u062F \u0645\u0631\u0628\u0639 \u062D\u0648\u0627\u0631 \u0645\u0641\u062A\u0648\u062D \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0627 \u064A\u0645\u0643\u0646\u0647 \u0625\u063A\u0644\u0627\u0642\u0647 \u0646\u064A\u0627\u0628\u0629 \u0639\u0646\u0643. \u064A\u0631\u062C\u0649 \u0625\u063A\u0644\u0627\u0642 \u0645\u0631\u0628\u0639 \u0627\u0644\u062D\u0648\u0627\u0631 \u0647\u0630\u0627\u060C \u062B\u0645 \u0627\u0644\u0645\u062D\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062F\u0631 \u062A\u0644\u0627\u0634 \u0627\u0633\u062A \u06CC\u06A9 \u062A\u0646\u0638\u06CC\u0645 \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F\u060C \u0627\u0645\u0627 \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0633\u06CC\u0633\u062A\u0645 \u06CC\u06A9 \u067E\u0646\u062C\u0631\u0647\u0654 \u06AF\u0641\u062A\u06AF\u0648 \u0628\u0627\u0632 \u0627\u0633\u062A \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0634\u0645\u0627 \u0628\u0628\u0646\u062F\u062F. \u0644\u0637\u0641\u0627\u064B \u0622\u0646 \u067E\u0646\u062C\u0631\u0647 \u0631\u0627 \u0628\u0628\u0646\u062F\u06CC\u062F\u060C \u0633\u067E\u0633 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97 \u0AAC\u0AA6\u0AB2\u0AB5\u0ABE\u0AA8\u0ACB \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0AC0 \u0AB0\u0AB9\u0ACD\u0AAF\u0AC1\u0A82 \u0A9B\u0AC7, \u0AAA\u0AB0\u0A82\u0AA4\u0AC1 \u0AB8\u0ABF\u0AB8\u0ACD\u0A9F\u0AAE \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8\u0AAE\u0ABE\u0A82 \u0A8F\u0A95 \u0AB8\u0A82\u0AB5\u0ABE\u0AA6 \u0A96\u0AC1\u0AB2\u0ACD\u0AB2\u0ACB \u0A9B\u0AC7 \u0A9C\u0AC7\u0AA8\u0AC7 \u0AA4\u0AC7 \u0AA4\u0AAE\u0ABE\u0AB0\u0ABE \u0AAE\u0ABE\u0A9F\u0AC7 \u0AAC\u0A82\u0AA7 \u0A95\u0AB0\u0AC0 \u0AB6\u0A95\u0AA4\u0AC1\u0A82 \u0AA8\u0AA5\u0AC0. \u0A95\u0AC3\u0AAA\u0ABE \u0A95\u0AB0\u0AC0\u0AA8\u0AC7 \u0AA4\u0AC7 \u0AB8\u0A82\u0AB5\u0ABE\u0AA6 \u0AAC\u0A82\u0AA7 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u090F\u0915 \u0938\u0947\u091F\u093F\u0902\u0917 \u092C\u0926\u0932\u0928\u0947 \u0915\u093E \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930 \u0930\u0939\u093E \u0939\u0948, \u0932\u0947\u0915\u093F\u0928 \u0938\u093F\u0938\u094D\u091F\u092E \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u090F\u0915 \u0921\u093E\u092F\u0932\u0949\u0917 \u0916\u0941\u0932\u093E \u0939\u0948 \u091C\u093F\u0938\u0947 \u0935\u0939 \u0906\u092A\u0915\u0947 \u0932\u093F\u090F \u092C\u0902\u0926 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093E\u0964 \u0915\u0943\u092A\u092F\u093E \u0909\u0938 \u0921\u093E\u092F\u0932\u0949\u0917 \u0915\u094B \u092C\u0902\u0926 \u0915\u0930\u0947\u0902, \u092B\u093F\u0930 \u092A\u0941\u0928: \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic\uC774 \uC124\uC815\uC744 \uBCC0\uACBD\uD558\uB824\uACE0 \uD558\uC9C0\uB9CC \uC2DC\uC2A4\uD15C \uC124\uC815\uC5D0 \uB300\uC2E0 \uB2EB\uC744 \uC218 \uC5C6\uB294 \uB300\uD654 \uC0C1\uC790\uAC00 \uC5F4\uB824 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uB300\uD654 \uC0C1\uC790\uB97C \uB2EB\uC740 \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u090F\u0915 \u0938\u0947\u091F\u093F\u0902\u0917 \u092C\u0926\u0932\u0923\u094D\u092F\u093E\u091A\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u0924 \u0906\u0939\u0947, \u092A\u0930\u0902\u0924\u0941 System Settings \u092E\u0927\u094D\u092F\u0947 \u090F\u0915 \u0921\u093E\u092F\u0932\u0949\u0917 \u0909\u0918\u0921\u093E \u0906\u0939\u0947 \u091C\u094B \u0924\u0947 \u0924\u0941\u092E\u091A\u094D\u092F\u093E\u0938\u093E\u0920\u0940 \u092C\u0902\u0926 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093E\u0939\u0940. \u0915\u0943\u092A\u092F\u093E \u0924\u094B \u0921\u093E\u092F\u0932\u0949\u0917 \u092C\u0902\u0926 \u0915\u0930\u093E \u0906\u0923\u093F \u0928\u0902\u0924\u0930 \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0627\u06CC\u06A9 \u062A\u0631\u062A\u06CC\u0628 \u062A\u0628\u062F\u06CC\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06CC \u06A9\u0648\u0634\u0634 \u06A9\u0631 \u0631\u06C1\u0627 \u06C1\u06D2\u060C \u0644\u06CC\u06A9\u0646 System Settings \u0645\u06CC\u06BA \u0627\u06CC\u06A9 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u06A9\u06BE\u0644\u0627 \u06C1\u06D2 \u062C\u0633\u06D2 \u06CC\u06C1 \u0622\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 \u0628\u0646\u062F \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u062A\u0627\u06D4 \u0628\u0631\u0627\u06C1\u0650 \u06A9\u0631\u0645 \u0648\u06C1 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u0628\u0646\u062F \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0111ang c\u1ED1 thay \u0111\u1ED5i m\u1ED9t c\u00E0i \u0111\u1EB7t, nh\u01B0ng C\u00E0i \u0111\u1EB7t h\u1EC7 th\u1ED1ng c\u00F3 h\u1ED9p tho\u1EA1i \u0111ang m\u1EDF m\u00E0 Morphic kh\u00F4ng th\u1EC3 \u0111\u00F3ng gi\u00FAp b\u1EA1n. Vui l\u00F2ng \u0111\u00F3ng h\u1ED9p tho\u1EA1i \u0111\u00F3, r\u1ED3i th\u1EED l\u1EA1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u6B63\u5728\u5C1D\u8BD5\u66F4\u6539\u8BBE\u7F6E\uFF0C\u4F46\u201C\u7CFB\u7EDF\u8BBE\u7F6E\u201D\u4E2D\u6709\u4E00\u4E2A\u6253\u5F00\u7684\u5BF9\u8BDD\u6846\uFF0CMorphic \u65E0\u6CD5\u4E3A\u4F60\u5173\u95ED\u3002\u8BF7\u5173\u95ED\u8BE5\u5BF9\u8BDD\u6846\uFF0C\u7136\u540E\u91CD\u8BD5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u6B63\u5728\u5617\u8A66\u8B8A\u66F4\u8A2D\u5B9A\uFF0C\u4F46\u300C\u7CFB\u7D71\u8A2D\u5B9A\u300D\u6709\u4E00\u500B\u958B\u555F\u7684\u5C0D\u8A71\u6846\uFF0CMorphic \u7121\u6CD5\u70BA\u60A8\u95DC\u9589\u3002\u8ACB\u95DC\u9589\u8A72\u5C0D\u8A71\u6846\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic sta tentando di modificare un\u2019impostazione, ma in Impostazioni di Sistema \u00E8 aperta una finestra di dialogo che Morphic non pu\u00F2 chiudere per te. Chiudila, quindi riprova."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u05DE\u05E0\u05E1\u05D4 \u05DC\u05E9\u05E0\u05D5\u05EA \u05D4\u05D2\u05D3\u05E8\u05D4, \u05D0\u05DA \u05D1\u0027\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05EA\u0027 \u05E4\u05EA\u05D5\u05D7\u05D4 \u05EA\u05D9\u05D1\u05EA \u05D3\u05D5\u05BE\u05E9\u05D9\u05D7 \u05E9\u05D0\u05D9\u05DF \u05D1\u05D0\u05E4\u05E9\u05E8\u05D5\u05EA\u05D5 \u05DC\u05E1\u05D2\u05D5\u05E8 \u05E2\u05D1\u05D5\u05E8\u05DA. \u05E1\u05D2\u05D5\u05E8 \u05D0\u05EA \u05EA\u05D9\u05D1\u05EA \u05D4\u05D3\u05D5\u05BE\u05E9\u05D9\u05D7 \u05D5\u05E0\u05E1\u05D4 \u05E9\u05D5\u05D1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u306F\u8A2D\u5B9A\u3092\u5909\u66F4\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u307E\u3059\u304C\u3001\u30B7\u30B9\u30C6\u30E0\u8A2D\u5B9A\u3067\u30C0\u30A4\u30A2\u30ED\u30B0\u304C\u958B\u3044\u3066\u3044\u308B\u305F\u3081\u81EA\u52D5\u7684\u306B\u9589\u3058\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u305B\u3093\u3002\u30C0\u30A4\u30A2\u30ED\u30B0\u3092\u9589\u3058\u3066\u304B\u3089\u3001\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic fors\u00F8ger at \u00E6ndre en indstilling, men Systemindstillinger har en dialogboks \u00E5ben, som den ikke kan lukke for dig. Luk dialogboksen, og pr\u00F8v igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u03A4\u03BF Morphic \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03B5\u03AF \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03B9 \u03BC\u03B9\u03B1 \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7, \u03B1\u03BB\u03BB\u03AC \u03BF\u03B9 \u03A1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03CC \u03AD\u03BD\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF \u03B4\u03B9\u03B1\u03BB\u03CC\u03B3\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BA\u03BB\u03B5\u03AF\u03C3\u03B5\u03B9 \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2. \u039A\u03BB\u03B5\u03AF\u03C3\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF \u03B4\u03B9\u03B1\u03BB\u03CC\u03B3\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03BE\u03B1\u03BD\u03AC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic yritt\u00E4\u00E4 muuttaa asetusta, mutta J\u00E4rjestelm\u00E4asetuksissa on avoinna valintaikkuna, jota se ei voi sulkea puolestasi. Sulje kyseinen valintaikkuna ja yrit\u00E4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic essaie de modifier un r\u00E9glage, mais l\u2019application R\u00E9glages Syst\u00E8me affiche une bo\u00EEte de dialogue qu\u2019il ne peut pas fermer pour vous. Fermez cette bo\u00EEte de dialogue, puis r\u00E9essayez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic tente de modifier un r\u00E9glage, mais R\u00E9glages Syst\u00E8me a une bo\u00EEte de dialogue ouverte qu\u2019il ne peut pas fermer pour vous. Fermez cette bo\u00EEte de dialogue, puis r\u00E9essayez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic probeert een instelling te wijzigen, maar Systeeminstellingen heeft een dialoogvenster geopend dat niet automatisch kan worden gesloten. Sluit dat dialoogvenster en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic pr\u00F3buje zmieni\u0107 ustawienie, ale w Ustawieniach systemowych jest otwarte okno dialogowe, kt\u00F3rego nie mo\u017Ce zamkn\u0105\u0107 za Ciebie. Zamknij to okno dialogowe i spr\u00F3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphic est\u00E1 tentando alterar uma configura\u00E7\u00E3o, mas os Ajustes do Sistema t\u00EAm uma caixa de di\u00E1logo aberta que ele n\u00E3o pode fechar para voc\u00EA. Feche essa caixa de di\u00E1logo e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic f\u00F6rs\u00F6ker \u00E4ndra en inst\u00E4llning, men Systeminst\u00E4llningar har en \u00F6ppen dialogruta som Morphic inte kan st\u00E4nga \u00E5t dig. St\u00E4ng dialogrutan och f\u00F6rs\u00F6k igen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic proovib s\u00E4tet muuta, kuid rakenduses S\u00FCsteemiseaded on avatud dialoog, mida see ei saa teie eest sulgeda. Sulgege dialoog ja proovige uuesti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Morphic est\u00E1 a tentar alterar uma defini\u00E7\u00E3o, mas as Defini\u00E7\u00F5es do Sistema t\u00EAm uma caixa de di\u00E1logo aberta que n\u00E3o consegue fechar por si. Feche essa caixa de di\u00E1logo e tente novamente."
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0627\u06CC\u06A9 \u0633\u06CC\u0679\u0646\u06AF \u0628\u062F\u0644\u0646\u06D2 \u06A9\u06CC \u06A9\u0648\u0634\u0634 \u06A9\u0631 \u0631\u06C1\u0627 \u06C1\u06D2\u060C \u0645\u06AF\u0631 System Settings \u0645\u06CC\u06BA \u0627\u06CC\u06A9 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u06A9\u06BE\u0644\u0627 \u06C1\u06D2 \u062C\u0633\u06D2 \u06CC\u06C1 \u0622\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 \u0628\u0646\u062F \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u062A\u0627\u06D4 \u0628\u0631\u0627\u06C1\u0650 \u06A9\u0631\u0645 \u0648\u06C1 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u0628\u0646\u062F \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0627\u06CC\u06A9 \u062A\u0631\u062A\u06CC\u0628 \u062A\u0628\u062F\u06CC\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06CC \u06A9\u0648\u0634\u0634 \u06A9\u0631 \u0631\u06C1\u0627 \u06C1\u06D2\u060C \u0645\u06AF\u0631 System Settings \u0645\u06CC\u06BA \u0627\u06CC\u06A9 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u06A9\u06BE\u0644\u0627 \u06C1\u0648\u0627 \u06C1\u06D2 \u062C\u0633\u06D2 \u0648\u06C1 \u0622\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 \u0628\u0646\u062F \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u062A\u0627\u06D4 \u0628\u0631\u0627\u06C1\u0650 \u06A9\u0631\u0645 \u0648\u06C1 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u0628\u0646\u062F \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic probeer \u0027n instelling verander, maar Stelselinstellings het \u0027n dialoog oop wat dit nie vir jou kan toemaak nie. Maak asseblief daardie dialoog toe en probeer weer."
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u1245\u1295\u1265\u122D \u1208\u1218\u1240\u12E8\u122D \u12A5\u12E8\u121E\u12A8\u1228 \u1290\u12CD\u1363 \u1290\u1308\u122D \u130D\u1295 System Settings \u120A\u12D8\u130B\u12CD \u12E8\u121B\u12ED\u127D\u1208\u12CD \u12E8\u1218\u1308\u1293\u129B \u1233\u1325\u1295 \u12AD\u134D\u1275 \u12A0\u1208\u12CD\u1362 \u12A5\u1263\u12AD\u12CE \u12EB\u1295 \u12E8\u1218\u1308\u1293\u129B \u1233\u1325\u1295 \u12ED\u12DD\u1309\u1363 \u12A8\u12DA\u12EB \u12A5\u1295\u12F0\u1308\u1293 \u12ED\u121E\u12AD\u1229\u1362"
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u098F \u098F\u099F\u09BE \u099B\u09C7\u099F\u09BF\u0982 \u09B8\u09B2\u09A8\u09BF \u0995\u09F0\u09BF\u09AC\u09B2\u09C8 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09F0\u09BF \u0986\u099B\u09C7, \u0995\u09BF\u09A8\u09CD\u09A4\u09C1 System Settings-\u09A4 \u098F\u099F\u09BE \u09A1\u09BE\u09AF\u09BC\u09B2\u2019\u0997 \u0996\u09CB\u09B2\u09BE \u0986\u099B\u09C7 \u09AF\u09BF\u099F\u09CB \u0987 \u0986\u09AA\u09CB\u09A8\u09BE\u09F0 \u09AC\u09BE\u09AC\u09C7 \u09AC\u09A8\u09CD\u09A7 \u0995\u09F0\u09BF\u09AC \u09A8\u09CB\u09F1\u09BE\u09F0\u09C7\u0964 \u0985\u09A8\u09C1\u0997\u09CD\u09F0\u09B9 \u0995\u09F0\u09BF \u09B8\u09C7\u0987 \u09A1\u09BE\u09AF\u09BC\u09B2\u2019\u0997\u099F\u09CB \u09AC\u09A8\u09CD\u09A7 \u0995\u09F0\u0995, \u09A4\u09BE\u09F0 \u09AA\u09BF\u099B\u09A4 \u09AA\u09C1\u09A8\u09F0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09F0\u0995\u0964"
          }
        },
        "az-Latn-AZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic bir parametri d\u0259yi\u015Fm\u0259y\u0259 \u00E7al\u0131\u015F\u0131r, lakin Sistem Parametrl\u0259rind\u0259 sizin \u00FC\u00E7\u00FCn ba\u011Flaya bilm\u0259diyi bir dialoq a\u00E7\u0131qd\u0131r. Z\u0259hm\u0259t olmasa h\u0259min dialoqu ba\u011Flay\u0131n v\u0259 yenid\u0259n c\u0259hd edin."
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0441\u043F\u0440\u0430\u0431\u0443\u0435 \u0437\u043C\u044F\u043D\u0456\u0446\u044C \u043D\u0430\u043B\u0430\u0434\u0443, \u0430\u043B\u0435 \u045E \u00AB\u0421\u0456\u0441\u0442\u044D\u043C\u043D\u044B\u0445 \u043D\u0430\u043B\u0430\u0434\u0430\u0445\u00BB \u0430\u0434\u043A\u0440\u044B\u0442\u0430 \u0434\u044B\u044F\u043B\u043E\u0433\u0430\u0432\u0430\u0435 \u0430\u043A\u043D\u043E, \u044F\u043A\u043E\u0435 \u0451\u043D \u043D\u0435 \u043C\u043E\u0436\u0430 \u0437\u0430\u043A\u0440\u044B\u0446\u044C \u0437\u0430 \u0432\u0430\u0441. \u0417\u0430\u043A\u0440\u044B\u0439\u0446\u0435 \u0433\u044D\u0442\u0430 \u0430\u043A\u043D\u043E \u0456 \u043F\u0430\u045E\u0442\u0430\u0440\u044B\u0446\u0435 \u0441\u043F\u0440\u043E\u0431\u0443."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0441\u0435 \u043E\u043F\u0438\u0442\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430, \u043D\u043E \u0432 \u201E\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\u201C \u0438\u043C\u0430 \u043E\u0442\u0432\u043E\u0440\u0435\u043D \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432 \u043F\u0440\u043E\u0437\u043E\u0440\u0435\u0446, \u043A\u043E\u0439\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0431\u044A\u0434\u0435 \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u043D \u0432\u043C\u0435\u0441\u0442\u043E \u0432\u0430\u0441. \u041C\u043E\u043B\u044F, \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u0442\u043E\u0437\u0438 \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432 \u043F\u0440\u043E\u0437\u043E\u0440\u0435\u0446 \u0438 \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u043E\u0442\u043D\u043E\u0432\u043E."
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u098F\u0995\u099F\u09BF \u09B8\u09C7\u099F\u09BF\u0982 \u09AA\u09B0\u09BF\u09AC\u09B0\u09CD\u09A4\u09A8 \u0995\u09B0\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u099B\u09C7, \u0995\u09BF\u09A8\u09CD\u09A4\u09C1 System Settings-\u098F \u098F\u0995\u099F\u09BF \u09A1\u09BE\u09AF\u09BC\u09BE\u09B2\u0997 \u0996\u09CB\u09B2\u09BE \u09B0\u09AF\u09BC\u09C7\u099B\u09C7 \u09AF\u09BE \u098F\u099F\u09BF \u0986\u09AA\u09A8\u09BE\u09B0 \u099C\u09A8\u09CD\u09AF \u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09A4\u09C7 \u09AA\u09BE\u09B0\u099B\u09C7 \u09A8\u09BE\u0964 \u0985\u09A8\u09C1\u0997\u09CD\u09B0\u09B9 \u0995\u09B0\u09C7 \u09B8\u09C7\u0987 \u09A1\u09BE\u09AF\u09BC\u09BE\u09B2\u0997\u099F\u09BF \u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09C1\u09A8, \u09A4\u09BE\u09B0\u09AA\u09B0 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic poku\u0161ava promijeniti postavku, ali u Postavkama sistema je otvoren dijalog koji se ne mo\u017Ee automatski zatvoriti. Zatvorite taj dijalog, a zatim poku\u0161ajte ponovo."
          }
        },
        "ca-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El Morphic est\u00E0 intentant canviar una opci\u00F3 de configuraci\u00F3, per\u00F2 la Configuraci\u00F3 del sistema t\u00E9 un di\u00E0leg obert que no es pot tancar autom\u00E0ticament. Tanqueu aquest di\u00E0leg i torneu-ho a provar."
          }
        },
        "eu-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic ezarpen bat aldatzen saiatzen ari da, baina Sistemaren ezarpenek elkarrizketa-koadro bat dute irekita, eta aplikazioak ezin du zure ordez itxi. Itxi elkarrizketa-koadro hori, eta saiatu berriro."
          }
        },
        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u0568 \u0583\u0578\u0580\u0571\u0578\u0582\u0574 \u0567 \u0583\u0578\u056D\u0565\u056C \u056F\u0561\u0580\u0563\u0561\u057E\u0578\u0580\u0578\u0582\u0574\u0568, \u057D\u0561\u056F\u0561\u0575\u0576 \u0540\u0561\u0574\u0561\u056F\u0561\u0580\u0563\u056B \u056F\u0561\u0580\u0563\u0561\u057E\u0578\u0580\u0578\u0582\u0574\u0576\u0565\u0580\u0578\u0582\u0574 \u0562\u0561\u0581 \u0567 \u0565\u0580\u056F\u056D\u0578\u057D\u0578\u0582\u0569\u0575\u0561\u0576 \u057A\u0561\u057F\u0578\u0582\u0570\u0561\u0576, \u0578\u0580\u0568 \u0570\u0576\u0561\u0580\u0561\u057E\u0578\u0580 \u0579\u0567 \u0583\u0561\u056F\u0565\u056C \u0571\u0565\u0580 \u0583\u0578\u056D\u0561\u0580\u0565\u0576\u0589 \u053D\u0576\u0564\u0580\u0578\u0582\u0574 \u0565\u0576\u0584 \u0583\u0561\u056F\u0565\u056C \u0561\u0575\u0564 \u057A\u0561\u057F\u0578\u0582\u0570\u0561\u0576\u0568, \u0561\u057A\u0561 \u0576\u0578\u0580\u056B\u0581 \u0583\u0578\u0580\u0571\u0565\u056C\u0589"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u098F\u0995\u099F\u09BF \u09B8\u09C7\u099F\u09BF\u0982 \u09AC\u09A6\u09B2\u09BE\u09A8\u09CB\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u099B\u09C7, \u0995\u09BF\u09A8\u09CD\u09A4\u09C1 System Settings-\u098F \u098F\u0995\u099F\u09BF \u09A1\u09BE\u09DF\u09BE\u09B2\u0997 \u0996\u09CB\u09B2\u09BE \u0986\u099B\u09C7 \u09AF\u09BE \u098F\u099F\u09BF \u0986\u09AA\u09A8\u09BE\u09B0 \u099C\u09A8\u09CD\u09AF \u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09A4\u09C7 \u09AA\u09BE\u09B0\u099B\u09C7 \u09A8\u09BE\u0964 \u0985\u09A8\u09C1\u0997\u09CD\u09B0\u09B9 \u0995\u09B0\u09C7 \u09A1\u09BE\u09DF\u09BE\u09B2\u0997\u099F\u09BF \u09AC\u09A8\u09CD\u09A7 \u0995\u09B0\u09C7 \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic se pokou\u0161\u00ED zm\u011Bnit nastaven\u00ED, ale v Nastaven\u00ED syst\u00E9mu je otev\u0159en\u00E9 dialogov\u00E9 okno, kter\u00E9 za v\u00E1s nelze zav\u0159\u00EDt. Zav\u0159ete pros\u00EDm toto dialogov\u00E9 okno a zkuste to znovu."
          }
        },
        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0787\u07A6\u0782\u07B0\u0782\u07A6\u0782\u07A9 \u0790\u07AC\u0793\u07A8\u0782\u07B0\u078E\u07B0\u0787\u07AC\u0787\u07B0 \u0784\u07A6\u078B\u07A6\u078D\u07AA\u0786\u07AA\u0783\u07A6\u0782\u07B0 \u0789\u07A6\u0790\u07A6\u0787\u07B0\u0786\u07A6\u078C\u07B0 \u0786\u07AA\u0783\u07A6\u0789\u07AA\u0782\u07B0\u060C \u0787\u07AC\u0786\u07A6\u0789\u07A6\u0786\u07AA System Settings \u078E\u07A6\u0787\u07A8 \u0780\u07AA\u0785\u07AA\u0788\u07A8\u078A\u07A6\u0787\u07A8\u0788\u07A7 \u0791\u07A6\u0787\u07A8\u078D\u07AE\u078E\u07AC\u0787\u07B0 \u078C\u07A8\u0784\u07A7\u0787\u07A6\u0781\u07B0\u0793\u07A6\u0786\u07A6\u0787\u07A8 \u0784\u07A6\u0782\u07B0\u078B\u07AC\u0787\u07B0 \u0782\u07AA\u0786\u07AA\u0783\u07AC\u0788\u07AD\u0782\u07AC. \u0787\u07AC \u0791\u07A6\u0787\u07A8\u078D\u07AE\u078E\u07B0 \u0784\u07A6\u0782\u07B0\u078B\u07AA\u0786\u07AA\u0783\u07AC\u0787\u07B0\u0788\u07AA\u0789\u07A6\u0781\u07B0\u078A\u07A6\u0780\u07AA \u0787\u07A6\u078D\u07AA\u0782\u07B0 \u0789\u07A6\u0790\u07A6\u0787\u07B0\u0786\u07A6\u078C\u07B0 \u0786\u07AE\u0781\u07B0\u078D\u07A6\u0787\u07B0\u0788\u07A7."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "gl-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 tentando cambiar unha opci\u00F3n, pero Configuraci\u00F3n do sistema ten un di\u00E1logo aberto que non pode pechar por ti. Pecha ese di\u00E1logo e t\u00E9ntao de novo."
          }
        },
        "hr-HR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic poku\u0161ava promijeniti postavku, ali Postavke sustava imaju otvoren dijalo\u0161ki okvir koji ne mo\u017Ee zatvoriti umjesto vas. Zatvorite taj dijalo\u0161ki okvir, a zatim poku\u0161ajte ponovno."
          }
        },
        "hu-HU": {
          "stringUnit": {
            "state": "translated",
            "value": "A Morphic megpr\u00F3b\u00E1l m\u00F3dos\u00EDtani egy be\u00E1ll\u00EDt\u00E1st, de a Rendszerbe\u00E1ll\u00EDt\u00E1sokban nyitva van egy p\u00E1rbesz\u00E9dpanel, amelyet nem tud bez\u00E1rni \u00D6n helyett. Z\u00E1rja be azt a p\u00E1rbesz\u00E9dpanelt, majd pr\u00F3b\u00E1lja \u00FAjra."
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u10EA\u10D3\u10D8\u10DA\u10DD\u10D1\u10E1 \u10DE\u10D0\u10E0\u10D0\u10DB\u10D4\u10E2\u10E0\u10D8\u10E1 \u10E8\u10D4\u10EA\u10D5\u10DA\u10D0\u10E1, \u10DB\u10D0\u10D2\u10E0\u10D0\u10DB \u201E\u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D8\u10E1 \u10DE\u10D0\u10E0\u10D0\u10DB\u10D4\u10E2\u10E0\u10D4\u10D1\u10E8\u10D8\u201C \u10D2\u10D0\u10EE\u10E1\u10DC\u10D8\u10DA\u10D8\u10D0 \u10D3\u10D8\u10D0\u10DA\u10DD\u10D2\u10D8, \u10E0\u10DD\u10DB\u10D4\u10DA\u10E1\u10D0\u10EA \u10D8\u10E1 \u10D7\u10E5\u10D5\u10D4\u10DC\u10D7\u10D5\u10D8\u10E1 \u10D5\u10D4\u10E0 \u10D3\u10D0\u10EE\u10E3\u10E0\u10D0\u10D5\u10E1. \u10D3\u10D0\u10EE\u10E3\u10E0\u10D4\u10D7 \u10D4\u10E1 \u10D3\u10D8\u10D0\u10DA\u10DD\u10D2\u10D8 \u10D3\u10D0 \u10E1\u10EA\u10D0\u10D3\u10D4\u10D7 \u10EE\u10D4\u10DA\u10D0\u10EE\u10DA\u10D0."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusubukan ng Morphic na baguhin ang isang setting, ngunit may nakabukas na dialog ang System Settings na hindi nito maisara para sa iyo. Pakisara ang dialog na iyon, pagkatapos ay subukang muli."
          }
        },
        "ga-IE": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00E1 Morphic ag iarraidh socr\u00FA a athr\u00FA, ach t\u00E1 dial\u00F3g oscailte ag Socruithe an Ch\u00F3rais nach f\u00E9idir leis a dh\u00FAnadh duit. D\u00FAn an dial\u00F3g sin, le do thoil, ansin bain triail eile as."
          }
        },
        "is-IS": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic er a\u00F0 reyna a\u00F0 breyta stillingu, en Kerfisstillingar eru me\u00F0 opinn svarglugga sem \u00FEa\u00F0 getur ekki loka\u00F0 fyrir \u00FEig. Loka\u00F0u svarglugganum og reyndu aftur."
          }
        },
        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0434\u0456 \u04E9\u0437\u0433\u0435\u0440\u0442\u0443\u0433\u0435 \u0442\u044B\u0440\u044B\u0441\u0443\u0434\u0430, \u0431\u0456\u0440\u0430\u049B \u00AB\u0416\u04AF\u0439\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043B\u0435\u0440\u0456\u00BB \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0441\u044B\u043D\u0434\u0430 \u043E\u043B \u0436\u0430\u0431\u0430 \u0430\u043B\u043C\u0430\u0439\u0442\u044B\u043D \u0434\u0438\u0430\u043B\u043E\u0433\u0442\u044B\u049B \u0442\u0435\u0440\u0435\u0437\u0435 \u0430\u0448\u044B\u049B. \u0421\u043E\u043B \u0434\u0438\u0430\u043B\u043E\u0433\u0442\u044B\u049B \u0442\u0435\u0440\u0435\u0437\u0435\u043D\u0456 \u0436\u0430\u0443\u044B\u043F, \u049B\u0430\u0439\u0442\u0430\u043B\u0430\u043F \u043A\u04E9\u0440\u0456\u04A3\u0456\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u1780\u17C6\u1796\u17BB\u1784\u1796\u17D2\u1799\u17B6\u1799\u17B6\u1798\u1795\u17D2\u179B\u17B6\u179F\u17CB\u1794\u17D2\u178A\u17BC\u179A\u1780\u17B6\u179A\u1780\u17C6\u178E\u178F\u17CB\u1798\u17BD\u1799 \u1794\u17C9\u17BB\u1793\u17D2\u178F\u17C2 System Settings \u1798\u17B6\u1793\u1794\u17D2\u179A\u17A2\u1794\u17CB\u1798\u17BD\u1799\u1794\u17BE\u1780\u178A\u17C2\u179B\u179C\u17B6\u1798\u17B7\u1793\u17A2\u17B6\u1785\u1794\u17B7\u1791\u17B1\u17D2\u1799\u17A2\u17D2\u1793\u1780\u1794\u17B6\u1793\u17D4 \u179F\u17BC\u1798\u1794\u17B7\u1791\u1794\u17D2\u179A\u17A2\u1794\u17CB\u1793\u17C4\u17C7 \u179A\u17BD\u1785\u179F\u17B6\u1780\u179B\u17D2\u1794\u1784\u1798\u17D2\u178F\u1784\u1791\u17C0\u178F\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u090F\u0915 \u0938\u0947\u091F\u093F\u0902\u0917 \u092C\u0926\u0932\u0941\u092A\u093E\u091A\u094B \u092F\u0924\u094D\u0928 \u0915\u0930\u0924\u093E, \u092A\u0942\u0923 System Settings \u0939\u093E\u0902\u0924 \u090F\u0915 \u0921\u093E\u092F\u0932\u0949\u0917 \u0909\u0917\u0921\u093F\u0932\u094D\u0932\u094B \u0906\u0938\u093E \u091C\u094B \u0924\u094B \u0924\u0941\u092E\u091A\u0947\u0916\u093E\u0924\u0940\u0930 \u092C\u0902\u0926 \u0915\u0930\u0942\u0902\u0915 \u0936\u0915\u0928\u093E. \u0915\u0943\u092A\u093E \u0915\u0930\u0942\u0928 \u0924\u094B \u0921\u093E\u092F\u0932\u0949\u0917 \u092C\u0902\u0926 \u0915\u0930\u093E\u0924, \u092E\u093E\u0917\u0940\u0930 \u092A\u0930\u0924\u0947\u0902 \u092F\u0924\u094D\u0928 \u0915\u0930\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201EMorphic\u201C bando pakeisti parametr\u0105, ta\u010Diau \u201ESystem Settings\u201C atidarytas dialogo langas, kurio jis negali u\u017E jus u\u017Edaryti. U\u017Edarykite t\u0105 dialogo lang\u0105 ir bandykite dar kart\u0105."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic m\u0113\u0123ina main\u012Bt iestat\u012Bjumu, bet lietotn\u0113 Sist\u0113mas iestat\u012Bjumi ir atv\u0113rts dialoglodzi\u0146\u0161, ko tas nevar aizv\u0113rt j\u016Bsu viet\u0101. Aizveriet \u0161o dialoglodzi\u0146u un m\u0113\u0123iniet v\u0113lreiz."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic mencoba mengubah pengaturan, tetapi Pengaturan Sistem memiliki dialog terbuka yang tidak dapat ditutup untuk Anda. Silakan tutup dialog tersebut, lalu coba lagi."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0CB8\u0CC6\u0C9F\u0CCD\u0C9F\u0CBF\u0C82\u0C97\u0CCD \u0CAC\u0CA6\u0CB2\u0CBF\u0CB8\u0CB2\u0CC1 \u0CAA\u0CCD\u0CB0\u0CAF\u0CA4\u0CCD\u0CA8\u0CBF\u0CB8\u0CC1\u0CA4\u0CCD\u0CA4\u0CBF\u0CA6\u0CC6, \u0C86\u0CA6\u0CB0\u0CC6 \u0CB8\u0CBF\u0CB8\u0CCD\u0C9F\u0CAE\u0CCD \u0CB8\u0CC6\u0C9F\u0CCD\u0C9F\u0CBF\u0C82\u0C97\u0CCD\u200C\u0C97\u0CB3\u0CB2\u0CCD\u0CB2\u0CBF \u0C85\u0CA6\u0CC1 \u0CA8\u0CBF\u0CAE\u0C97\u0CBE\u0C97\u0CBF \u0CAE\u0CC1\u0C9A\u0CCD\u0C9A\u0CB2\u0CBE\u0C97\u0CA6 \u0CB8\u0C82\u0CB5\u0CBE\u0CA6 \u0CA4\u0CC6\u0CB0\u0CC6\u0CA6\u0CBF\u0CA6\u0CC6. \u0CA6\u0CAF\u0CB5\u0CBF\u0C9F\u0CCD\u0C9F\u0CC1 \u0C86 \u0CB8\u0C82\u0CB5\u0CBE\u0CA6\u0CB5\u0CA8\u0CCD\u0CA8\u0CC1 \u0CAE\u0CC1\u0C9A\u0CCD\u0C9A\u0CBF, \u0CA8\u0C82\u0CA4\u0CB0 \u0CAE\u0CA4\u0CCD\u0CA4\u0CC6 \u0CAA\u0CCD\u0CB0\u0CAF\u0CA4\u0CCD\u0CA8\u0CBF\u0CB8\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0441\u0435 \u043E\u0431\u0438\u0434\u0443\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430, \u043D\u043E \u0421\u0438\u0441\u0442\u0435\u043C\u0441\u043A\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0438\u043C\u0430 \u043E\u0442\u0432\u043E\u0440\u0435\u043D \u0434\u0438\u0458\u0430\u043B\u043E\u0433 \u0448\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0438 \u0437\u0430 \u0432\u0430\u0441. \u0417\u0430\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u0433\u043E \u0442\u043E\u0458 \u0434\u0438\u0458\u0430\u043B\u043E\u0433, \u043F\u0430 \u043E\u0431\u0438\u0434\u0435\u0442\u0435 \u0441\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0D12\u0D30\u0D41 \u0D15\u0D4D\u0D30\u0D2E\u0D40\u0D15\u0D30\u0D23\u0D02 \u0D2E\u0D3E\u0D31\u0D4D\u0D31\u0D3E\u0D7B \u0D36\u0D4D\u0D30\u0D2E\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D28\u0D4D\u0D28\u0D41, \u0D2A\u0D15\u0D4D\u0D37\u0D47 \u0D38\u0D3F\u0D38\u0D4D\u0D31\u0D4D\u0D31\u0D02 \u0D15\u0D4D\u0D30\u0D2E\u0D40\u0D15\u0D30\u0D23\u0D19\u0D4D\u0D19\u0D33\u0D3F\u0D7D \u0D28\u0D3F\u0D19\u0D4D\u0D19\u0D7E\u0D15\u0D4D\u0D15\u0D3E\u0D2F\u0D3F \u0D05\u0D1F\u0D2F\u0D4D\u0D15\u0D4D\u0D15\u0D3E\u0D7B \u0D15\u0D34\u0D3F\u0D2F\u0D3E\u0D24\u0D4D\u0D24 \u0D12\u0D30\u0D41 \u0D21\u0D2F\u0D32\u0D4B\u0D17\u0D4D \u0D24\u0D41\u0D31\u0D28\u0D4D\u0D28\u0D3F\u0D30\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D28\u0D4D\u0D28\u0D41. \u0D26\u0D2F\u0D35\u0D3E\u0D2F\u0D3F \u0D06 \u0D21\u0D2F\u0D32\u0D4B\u0D17\u0D4D \u0D05\u0D1F\u0D1A\u0D4D\u0D1A \u0D36\u0D47\u0D37\u0D02 \u0D35\u0D40\u0D23\u0D4D\u0D1F\u0D41\u0D02 \u0D36\u0D4D\u0D30\u0D2E\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0442\u043E\u0445\u0438\u0440\u0433\u043E\u043E \u04E9\u04E9\u0440\u0447\u043B\u04E9\u0445 \u0433\u044D\u0436 \u0431\u0430\u0439\u043D\u0430, \u0433\u044D\u0445\u0434\u044D\u044D \u0421\u0438\u0441\u0442\u0435\u043C\u0438\u0439\u043D \u0442\u043E\u0445\u0438\u0440\u0433\u043E\u043E\u043D\u0434 \u0445\u0430\u0430\u0436 \u04E9\u0433\u04E9\u0445 \u0431\u043E\u043B\u043E\u043C\u0436\u0433\u04AF\u0439 \u0445\u0430\u0440\u0438\u043B\u0446\u0430\u0445 \u0446\u043E\u043D\u0445 \u043D\u044D\u044D\u043B\u0442\u0442\u044D\u0439 \u0431\u0430\u0439\u043D\u0430. \u0422\u044D\u0440 \u0446\u043E\u043D\u0445\u044B\u0433 \u0445\u0430\u0430\u0433\u0430\u0430\u0434 \u0434\u0430\u0445\u0438\u043D \u043E\u0440\u043E\u043B\u0434\u043E\u043D\u043E \u0443\u0443."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic sedang cuba menukar tetapan, tetapi Tetapan Sistem mempunyai dialog terbuka yang tidak dapat ditutup untuk anda. Sila tutup dialog itu, kemudian cuba lagi."
          }
        },
        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic qed jipprova jbiddel issettjar, i\u017Cda System Settings g\u0127andu djalogu miftu\u0127 li ma jistax jag\u0127laq g\u0127alik. Jekk jog\u0127\u0121bok ag\u0127laq dak id-djalogu, imbag\u0127ad er\u0121a\u0027 pprova."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic pr\u00F8ver \u00E5 endre en innstilling, men Systeminnstillinger har en dialogboks \u00E5pen som Morphic ikke kan lukke for deg. Lukk dialogboksen, og pr\u00F8v p\u00E5 nytt."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0932\u0947 \u0938\u0947\u091F\u093F\u0919 \u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928 \u0917\u0930\u094D\u0928\u0947 \u092A\u094D\u0930\u092F\u093E\u0938 \u0917\u0930\u094D\u0926\u0948\u091B, \u0924\u0930 System Settings \u092E\u093E \u090F\u0909\u091F\u093E \u0938\u0902\u0935\u093E\u0926 \u0916\u0941\u0932\u093E \u091B \u091C\u0941\u0928 \u092F\u0938\u0932\u0947 \u0924\u092A\u093E\u0908\u0902\u0915\u093E \u0932\u093E\u0917\u093F \u092C\u0928\u094D\u0926 \u0917\u0930\u094D\u0928 \u0938\u0915\u094D\u0926\u0948\u0928\u0964 \u0915\u0943\u092A\u092F\u093E \u0924\u094D\u092F\u094B \u0938\u0902\u0935\u093E\u0926 \u092C\u0928\u094D\u0926 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D, \u0924\u094D\u092F\u0938\u092A\u091B\u093F \u092B\u0947\u0930\u093F \u092A\u094D\u0930\u092F\u093E\u0938 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0B0F\u0B15 \u0B38\u0B47\u0B1F\u0B3F\u0B02 \u0B2A\u0B30\u0B3F\u0B2C\u0B30\u0B4D\u0B24\u0B4D\u0B24\u0B28 \u0B15\u0B30\u0B3F\u0B2C\u0B3E\u0B15\u0B41 \u0B1A\u0B47\u0B37\u0B4D\u0B1F\u0B3E \u0B15\u0B30\u0B41\u0B1B\u0B3F, \u0B15\u0B3F\u0B28\u0B4D\u0B24\u0B41 System Settings\u0B30\u0B47 \u0B0F\u0B15 \u0B21\u0B3E\u0B5F\u0B32\u0B17\u0B4D \u0B16\u0B4B\u0B32\u0B3E \u0B05\u0B1B\u0B3F \u0B2F\u0B3E\u0B39\u0B3E\u0B15\u0B41 \u0B0F\u0B39\u0B3E \u0B06\u0B2A\u0B23\u0B19\u0B4D\u0B15 \u0B2A\u0B3E\u0B07\u0B01 \u0B2C\u0B28\u0B4D\u0B26 \u0B15\u0B30\u0B3F\u0B2A\u0B3E\u0B30\u0B3F\u0B2C \u0B28\u0B3E\u0B39\u0B3F\u0B01\u0964 \u0B26\u0B5F\u0B3E\u0B15\u0B30\u0B3F \u0B38\u0B47\u0B39\u0B3F \u0B21\u0B3E\u0B5F\u0B32\u0B17\u0B4D \u0B2C\u0B28\u0B4D\u0B26 \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41, \u0B24\u0B3E\u0027\u0B2A\u0B30\u0B47 \u0B2A\u0B41\u0B23\u0B3F \u0B1A\u0B47\u0B37\u0B4D\u0B1F\u0B3E \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41\u0964"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0A07\u0A71\u0A15 \u0A38\u0A48\u0A1F\u0A3F\u0A70\u0A17 \u0A2C\u0A26\u0A32\u0A23 \u0A26\u0A40 \u0A15\u0A4B\u0A38\u0A3C\u0A3F\u0A38\u0A3C \u0A15\u0A30 \u0A30\u0A3F\u0A39\u0A3E \u0A39\u0A48, \u0A2A\u0A30 \u0A38\u0A3F\u0A38\u0A1F\u0A2E \u0A38\u0A48\u0A1F\u0A3F\u0A70\u0A17\u0A3E\u0A02 \u0A35\u0A3F\u0A71\u0A1A \u0A07\u0A71\u0A15 \u0A21\u0A3E\u0A07\u0A32\u0A3E\u0A17 \u0A16\u0A41\u0A71\u0A32\u0A4D\u0A39\u0A3E \u0A39\u0A48 \u0A1C\u0A3F\u0A38\u0A28\u0A42\u0A70 \u0A07\u0A39 \u0A24\u0A41\u0A39\u0A3E\u0A21\u0A47 \u0A32\u0A08 \u0A2C\u0A70\u0A26 \u0A28\u0A39\u0A40\u0A02 \u0A15\u0A30 \u0A38\u0A15\u0A26\u0A3E\u0964 \u0A15\u0A3F\u0A30\u0A2A\u0A3E \u0A15\u0A30\u0A15\u0A47 \u0A09\u0A39 \u0A21\u0A3E\u0A07\u0A32\u0A3E\u0A17 \u0A2C\u0A70\u0A26 \u0A15\u0A30\u0A4B, \u0A2B\u0A3F\u0A30 \u0A26\u0A41\u0A2C\u0A3E\u0A30\u0A3E \u0A15\u0A4B\u0A38\u0A3C\u0A3F\u0A38\u0A3C \u0A15\u0A30\u0A4B\u0964"
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062F \u06CC\u0648 \u062A\u0631\u062A\u06CC\u0628 \u062F \u0628\u062F\u0644\u0648\u0644\u0648 \u0647\u0685\u0647 \u06A9\u0648\u064A\u060C \u062E\u0648 System Settings \u06CC\u0648\u0647 \u062F\u0627\u0633\u06D0 \u0689\u06CC\u0627\u0644\u0648\u06AB \u0628\u06A9\u0633 \u062E\u0644\u0627\u0635 \u06A9\u0693\u06CC \u0686\u06D0 \u0633\u062A\u0627\u0633\u0648 \u0644\u067E\u0627\u0631\u0647 \u06CC\u06D0 \u0646\u0634\u064A \u062A\u0693\u0644\u06CC. \u0645\u0647\u0631\u0628\u0627\u0646\u064A \u0648\u06A9\u0693\u0626 \u0647\u063A\u0647 \u0689\u06CC\u0627\u0644\u0648\u06AB \u0628\u06A9\u0633 \u0648\u062A\u0693\u0626\u060C \u0627\u0648 \u0628\u06CC\u0627 \u0647\u0685\u0647 \u0648\u06A9\u0693\u0626."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por vos. Cerr\u00E1 ese cuadro y prob\u00E1 de nuevo."
          }
        },
        "es-BO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por usted. Cierre ese cuadro de di\u00E1logo y vuelva a intentarlo."
          }
        },
        "gd-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tha Morphic a\u0027 feuchainn ri suidheachadh atharrachadh, ach tha c\u00F2mhradh fosgailte ann an Roghainnean an t-siostaim nach urrainn dha a dh\u00F9nadh dhut. D\u00F9in an c\u00F2mhradh sin, an uair sin feuch ris a-rithist."
          }
        },
        "ro-RO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u00EEncearc\u0103 s\u0103 modifice o configurare, dar Configur\u0103ri sistem are deschis un dialog pe care nu \u00EEl poate \u00EEnchide pentru dvs. \u00CEnchide\u021Bi dialogul, apoi \u00EEncerca\u021Bi din nou."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440, \u043D\u043E \u0432 \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0445 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432\u043E\u0435 \u043E\u043A\u043D\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435 \u0443\u0434\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438. \u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435 \u044D\u0442\u043E \u043E\u043A\u043D\u043E \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0443."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0647\u06AA \u0633\u064A\u067D\u0646\u06AF \u062A\u0628\u062F\u064A\u0644 \u06AA\u0631\u06BB \u062C\u064A \u06AA\u0648\u0634\u0634 \u06AA\u0631\u064A \u0631\u0647\u064A\u0648 \u0622\u0647\u064A\u060C \u067E\u0631 System Settings \u06FE \u0647\u06AA \u068A\u0627\u0626\u0644\u0627\u06AF \u06A9\u0644\u064A\u0644 \u0622\u0647\u064A \u062C\u064A\u06AA\u0648 \u0627\u0647\u0648 \u062A\u0648\u0647\u0627\u0646 \u0644\u0627\u0621\u0650 \u0628\u0646\u062F \u0646\u067F\u0648 \u06AA\u0631\u064A \u0633\u06AF\u0647\u064A. \u0645\u0647\u0631\u0628\u0627\u0646\u064A \u06AA\u0631\u064A \u0627\u0647\u0648 \u068A\u0627\u0626\u0644\u0627\u06AF \u0628\u0646\u062F \u06AA\u0631\u064A\u0648\u060C \u067E\u0648\u0621\u0650 \u067B\u064A\u0647\u0631 \u06AA\u0648\u0634\u0634 \u06AA\u0631\u064A\u0648."
          }
        },
        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0DC3\u0DD0\u0D9A\u0DC3\u0DD4\u0DB8\u0D9A\u0DCA \u0DC0\u0DD9\u0DB1\u0DC3\u0DCA \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8\u0DA7 \u0D8B\u0DAD\u0DCA\u0DC3\u0DCF\u0DC4 \u0D9A\u0DBB\u0DBA\u0DD2, \u0DB1\u0DB8\u0DD4\u0DAD\u0DCA System Settings \u0DC4\u0DD2 \u0D94\u0DB6 \u0DC0\u0DD9\u0DB1\u0DD4\u0DC0\u0DD9\u0DB1\u0DCA \u0DC0\u0DD0\u0DC3\u0DD2\u0DBA \u0DB1\u0DDC\u0DC4\u0DD0\u0D9A\u0DD2 \u0DC3\u0D82\u0DC0\u0DCF\u0DAF\u0DBA\u0D9A\u0DCA \u0DC0\u0DD2\u0DC0\u0DD8\u0DAD\u0DC0 \u0D87\u0DAD. \u0D9A\u0DBB\u0DD4\u0DAB\u0DCF\u0D9A\u0DBB \u0D91\u0DB8 \u0DC3\u0D82\u0DC0\u0DCF\u0DAF\u0DBA \u0DC0\u0DC3\u0DCF \u0DB1\u0DD0\u0DC0\u0DAD \u0D8B\u0DAD\u0DCA\u0DC3\u0DCF\u0DC4 \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1."
          }
        },
        "sk-SK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic sa pok\u00FA\u0161a zmeni\u0165 nastavenie, ale v aplik\u00E1cii Nastavenia syst\u00E9mu je otvoren\u00E9 dial\u00F3gov\u00E9 okno, ktor\u00E9 za v\u00E1s nedok\u00E1\u017Ee zavrie\u0165. Zavrite toto dial\u00F3gov\u00E9 okno a sk\u00FAste to znova."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic posku\u0161a spremeniti nastavitev, vendar ima aplikacija Sistemske nastavitve odprto pogovorno okno, ki ga ne more zapreti namesto vas. Zaprite to pogovorno okno in poskusite znova."
          }
        },
        "sr-Latn-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic poku\u0161ava da promeni pode\u0161avanje, ali Pode\u0161avanja sistema imaju otvoren dijalog koji ne mo\u017Ee da zatvori umesto vas. Zatvorite taj dijalog, pa poku\u0161ajte ponovo."
          }
        },
        "cy-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae Morphic yn ceisio newid gosodiad, ond mae gan System Settings ddeialog ar agor na all ei chau drosoch. Caewch y ddeialog honno, yna rhowch gynnig arall arni."
          }
        },
        "sw-KE": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic inajaribu kubadilisha mpangilio, lakini Mipangilio ya Mfumo ina kisanduku cha mazungumzo kilichofunguliwa ambacho haiwezi kukifunga kwa niaba yako. Tafadhali funga kisanduku hicho, kisha ujaribu tena."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0B92\u0BB0\u0BC1 \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC8 \u0BAE\u0BBE\u0BB1\u0BCD\u0BB1 \u0BAE\u0BC1\u0BAF\u0BB2\u0BCD\u0B95\u0BBF\u0BB1\u0BA4\u0BC1, \u0B86\u0BA9\u0BBE\u0BB2\u0BCD \u0B95\u0BA3\u0BBF\u0BA9\u0BBF \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1\u0B95\u0BB3\u0BBF\u0BB2\u0BCD \u0B89\u0B99\u0BCD\u0B95\u0BB3\u0BC1\u0B95\u0BCD\u0B95\u0BBE\u0B95 \u0BAE\u0BC2\u0B9F \u0BAE\u0BC1\u0B9F\u0BBF\u0BAF\u0BBE\u0BA4 \u0B89\u0BB0\u0BC8\u0BAF\u0BBE\u0B9F\u0BB2\u0BCD \u0BA4\u0BBF\u0BB1\u0BA8\u0BCD\u0BA4\u0BC1\u0BB3\u0BCD\u0BB3\u0BA4\u0BC1. \u0B85\u0BA8\u0BCD\u0BA4 \u0B89\u0BB0\u0BC8\u0BAF\u0BBE\u0B9F\u0BB2\u0BC8 \u0BAE\u0BC2\u0B9F\u0BBF, \u0BAE\u0BC0\u0BA3\u0BCD\u0B9F\u0BC1\u0BAE\u0BCD \u0BAE\u0BC1\u0BAF\u0BB1\u0BCD\u0B9A\u0BBF\u0B95\u0BCD\u0B95\u0BB5\u0BC1\u0BAE\u0BCD."
          }
        },
        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0E01\u0E33\u0E25\u0E31\u0E07\u0E1E\u0E22\u0E32\u0E22\u0E32\u0E21\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E01\u0E32\u0E23\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32 \u0E41\u0E15\u0E48\u0E01\u0E32\u0E23\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32\u0E23\u0E30\u0E1A\u0E1A\u0E21\u0E35\u0E01\u0E25\u0E48\u0E2D\u0E07\u0E42\u0E15\u0E49\u0E15\u0E2D\u0E1A\u0E40\u0E1B\u0E34\u0E14\u0E2D\u0E22\u0E39\u0E48\u0E0B\u0E36\u0E48\u0E07\u0E44\u0E21\u0E48\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E1B\u0E34\u0E14\u0E43\u0E2B\u0E49\u0E04\u0E38\u0E13\u0E44\u0E14\u0E49 \u0E42\u0E1B\u0E23\u0E14\u0E1B\u0E34\u0E14\u0E01\u0E25\u0E48\u0E2D\u0E07\u0E42\u0E15\u0E49\u0E15\u0E2D\u0E1A\u0E19\u0E31\u0E49\u0E19 \u0E41\u0E25\u0E49\u0E27\u0E25\u0E2D\u0E07\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07"
          }
        },
        "ti-ER": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u1213\u12F0 \u1245\u1325\u12D2 \u12AD\u1255\u12ED\u122D \u12ED\u134D\u1275\u1295 \u12A3\u120E\u1363 \u130D\u1295 System Settings \u1263\u12D5\u1209 \u12AD\u12D3\u133D\u12CE \u12D8\u12ED\u12AD\u12A5\u120D \u12DD\u1270\u12B8\u134D\u1270 \u12F3\u12ED\u12A3\u120E\u130D \u12A3\u1208\u12CE\u1362 \u1260\u1303\u12BB \u1290\u1272 \u12F3\u12ED\u12A3\u120E\u130D \u12D3\u133D\u12CE\u1363 \u123D\u12D1 \u12F0\u130A\u121D\u12AB \u1348\u1275\u1295\u1362"
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic bir ayar\u0131 de\u011Fi\u015Ftirmeye \u00E7al\u0131\u015F\u0131yor ancak Sistem Ayarlar\u0131\u0027nda sizin i\u00E7in kapatamad\u0131\u011F\u0131 bir ileti\u015Fim kutusu a\u00E7\u0131k. L\u00FCtfen bu ileti\u015Fim kutusunu kapat\u0131p yeniden deneyin."
          }
        },
        "zu-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Morphic izama ukushintsha isilungiselelo, kodwa i-System Settings inebhokisi lengxoxo elivuliwe engeke ilivale egameni lakho. Sicela uvale lelo bhokisi lengxoxo, bese uzama futhi."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por ti. Cierra ese cuadro de di\u00E1logo e int\u00E9ntalo de nuevo."
          }
        },
        "es-CO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por usted. Cierre ese cuadro de di\u00E1logo e int\u00E9ntelo de nuevo."
          }
        },
        "es-CR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por vos. Cerr\u00E1 ese cuadro de di\u00E1logo y volv\u00E9 a intentarlo."

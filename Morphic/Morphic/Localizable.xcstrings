        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0646\u06D2 \u0634\u0627\u06CC\u062F \u063A\u0644\u0637 \u0648\u0646\u0688\u0648 \u067E\u0691\u06BE \u062F\u06CC \u06C1\u0648\u06D4 \u0627\u067E\u0646\u06D2 \u0645\u062A\u0646 \u0645\u06CC\u06BA \u06A9\u0644\u06A9 \u06A9\u0631\u06CC\u06BA \u0627\u0648\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u12E8\u1270\u1233\u1233\u1270 \u1218\u1235\u12AE\u1275 \u12A0\u1295\u1265\u1266 \u120A\u1206\u1295 \u12ED\u127D\u120B\u120D\u1362 \u12C8\u12F0 \u133D\u1211\u134D\u12CE \u1320\u1245 \u12EB\u12F5\u122D\u1309\u1293 \u12A5\u1295\u12F0\u1308\u1293 \u12ED\u121E\u12AD\u1229\u1362"

        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0E44\u0E21\u0E48\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E1B\u0E34\u0E14/\u0E1B\u0E34\u0E14 \u201C\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E04\u0E27\u0E32\u0E21\u0E15\u0E48\u0E32\u0E07\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E2A\u0E35\u201D \u0E42\u0E14\u0E22\u0E2D\u0E31\u0E15\u0E42\u0E19\u0E21\u0E31\u0E15\u0E34\u0E44\u0E14\u0E49 \u0E40\u0E1B\u0E34\u0E14\u0E01\u0E32\u0E23\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32\u0E01\u0E32\u0E23\u0E0A\u0E48\u0E27\u0E22\u0E01\u0E32\u0E23\u0E40\u0E02\u0E49\u0E32\u0E16\u0E36\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E34\u0E14/\u0E1B\u0E34\u0E14\u0E14\u0E49\u0E27\u0E22\u0E15\u0E19\u0E40\u0E2D\u0E07"
          }
        },
        "uz-Latn-UZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u201CKontrastni oshirish\u201Dni avtomatik yoqa olmadi. Uni yoqish uchun \u201CMaxsus imkoniyatlar\u201D sozlamalarini oching."
          }
        },
        "xh-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "IMorphic ayikwazanga ukutshintsha Ukwandisa Umehluko ngokuzenzekelayo. Vula izicwangciso Zokufikeleleka ukuze uyitshintshe."
          }
        },
        "ca-ES-valencia": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic no ha pogut canviar Augmentar el contrast autom\u00E0ticament. Obriu la configuraci\u00F3 d\u2019accessibilitat per a activar-lo o desactivar-lo."
          }
        },
        "chr-CHER-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u13A5\u13DD \u13F1\u13C4\u13B5\u13CD\u13D4\u13C5 \u13A4\u13E9\u13D2 \u13A4\u13D3\u13DA\u13AC \u13A4\u13C1\u13C9\u13D7. \u13AD\u13CD\u13DA\u13A2 \u13A0\u13F0\u13B8 \u13A0\u13D3\u13C1\u13B8 \u13A0\u13DF\u13B6\u13CD\u13D9\u13D7 \u13E3\u13C1\u13DF\u13F4\u13CD\u13D7."
          }
        },
        "es-PY": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic no pudo cambiar Aumentar contraste autom\u00E1ticamente. Abr\u00ED la Configuraci\u00F3n de Accesibilidad para hacerlo."
          }
        },
        "lb-LU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic konnt Kontrast erh\u00E9ijen net automatesch \u00EBmschalten. Maacht d\u0027Accessibilit\u00E9itsastellungen op, fir et \u00EBmzeschalten."
          }
        },
        "lo-LA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0E9A\u0ECD\u0EC8\u0EAA\u0EB2\u0EA1\u0EB2\u0E94\u0EC0\u0E9B\u0EB5\u0E94/\u0E9B\u0EB4\u0E94 \u0EC0\u0E9E\u0EB5\u0EC8\u0EA1\u0E84\u0EA7\u0EB2\u0EA1\u0E84\u0EBB\u0EA1\u0E8A\u0EB1\u0E94 \u0EC2\u0E94\u0E8D\u0EAD\u0EB1\u0E94\u0E95\u0EB0\u0EC2\u0E99\u0EA1\u0EB1\u0E94\u0EC4\u0E94\u0EC9. \u0EC0\u0E9B\u0EB5\u0E94\u0E81\u0EB2\u0E99\u0E95\u0EB1\u0EC9\u0E87\u0E84\u0EC8\u0EB2\u0E81\u0EB2\u0E99\u0EC0\u0E82\u0EBB\u0EC9\u0EB2\u0EC0\u0E96\u0EB4\u0E87\u0EC0\u0E9E\u0EB7\u0EC8\u0EAD\u0EAA\u0EB0\u0EAB\u0EBC\u0EB1\u0E9A\u0EA1\u0EB1\u0E99."
          }
        },
        "nn-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kunne ikkje sl\u00E5 p\u00E5 Auk kontrast automatisk. Opne Tilgjengeinnstillingar for \u00E5 sl\u00E5 det p\u00E5."
          }
        },
        "quz-PE": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic manam Chimpapurayta yapay nisqata kikinmanta tikrayta atirqanchu. Tikranaykipaq Yaykuy atiy wakichiykunata kichay."
          }
        },
        "sq-AL": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic nuk mundi ta ndryshonte automatikisht Rritjen e kontrastit. Hapni cil\u00EBsimet e aksesueshm\u00EBris\u00EB p\u00EBr ta aktivizuar/\u00E7aktivizuar."
          }
        },
        "sr-Cyrl-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0438\u0458\u0435 \u043C\u043E\u0433\u0430\u043E \u0430\u0443\u0442\u043E\u043C\u0430\u0442\u0441\u043A\u0438 \u0434\u0430 \u043F\u0440\u043E\u043C\u0438\u0458\u0435\u043D\u0438 \u041F\u043E\u0432\u0435\u045B\u0430\u045A\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0430. \u041E\u0442\u0432\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0435 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0447\u043D\u043E\u0441\u0442\u0438 \u0434\u0430 \u0433\u0430 \u0443\u043A\u0459\u0443\u0447\u0438\u0442\u0435 \u0438\u043B\u0438 \u0438\u0441\u043A\u0459\u0443\u0447\u0438\u0442\u0435."
          }
        },
        "sr-Cyrl-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0438\u0458\u0435 \u043C\u043E\u0433\u0430\u043E \u0430\u0443\u0442\u043E\u043C\u0430\u0442\u0441\u043A\u0438 \u0434\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438 \u0432\u0438\u0441\u043E\u043A \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442. \u041E\u0442\u0432\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0430 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0447\u043D\u043E\u0441\u0442\u0438 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u0433\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438\u043B\u0438."
          }
        },
        "mi-NZ": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0101ore i taea e Morphic te takahuri aunoa i te Whakanui P\u016Brata. Whakatuwherahia ng\u0101 tautuhinga \u0100heitanga hei takahuri."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic Increase Contrast\u200C\u0C28\u0C3F \u0C38\u0C4D\u0C35\u0C2F\u0C02\u0C1A\u0C3E\u0C32\u0C15\u0C02\u0C17\u0C3E \u0C2E\u0C3E\u0C30\u0C4D\u0C1A\u0C32\u0C47\u0C15\u0C2A\u0C4B\u0C2F\u0C3F\u0C02\u0C26\u0C3F. \u0C26\u0C3E\u0C28\u0C4D\u0C28\u0C3F \u0C1F\u0C4B\u0C17\u0C41\u0C32\u0C4D \u0C1A\u0C47\u0C2F\u0C21\u0C3E\u0C28\u0C3F\u0C15\u0C3F Accessibility \u0C38\u0C46\u0C1F\u0C4D\u0C1F\u0C3F\u0C02\u0C17\u0C4D\u200C\u0C32\u0C28\u0C41 \u0C24\u0C46\u0C30\u0C35\u0C02\u0C21\u0C3F."
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic, Kontrast\u0131 Art\u0131r ayar\u0131n\u0131 otomatik olarak de\u011Fi\u015Ftiremedi. A\u00E7mak veya kapatmak i\u00E7in Eri\u015Filebilirlik ayarlar\u0131n\u0131 a\u00E7\u0131n."
          }
        },
        "tt-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A \u0440\u04D9\u0432\u0435\u0448\u0442\u04D9 \u0430\u0440\u0442\u0442\u044B\u0440\u0430 \u0430\u043B\u043C\u0430\u0434\u044B. \u0410\u043D\u044B \u043A\u0430\u0431\u044B\u0437\u0443 \u04E9\u0447\u0435\u043D \u041C\u0430\u0445\u0441\u0443\u0441 \u043C\u04E9\u043C\u043A\u0438\u043D\u043B\u0435\u043A\u043B\u04D9\u0440 \u043A\u04E9\u0439\u043B\u04D9\u04AF\u043B\u04D9\u0440\u0435\u043D \u0430\u0447\u044B\u0433\u044B\u0437."
          }
        },
        "ug-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0633\u06D0\u0644\u0649\u0634\u062A\u06C7\u0631\u0645\u0627 \u062F\u06D5\u0631\u0649\u062C\u0649\u0646\u0649 \u0626\u0627\u0634\u06C7\u0631\u06C7\u0634\u0646\u0649 \u0626\u06C6\u0632\u0644\u06C8\u0643\u0649\u062F\u0649\u0646 \u0626\u0627\u0644\u0645\u0627\u0634\u062A\u06C7\u0631\u0627\u0644\u0645\u0649\u062F\u0649. \u0626\u06C7\u0646\u0649 \u0626\u0627\u0644\u0645\u0627\u0634\u062A\u06C7\u0631\u06C7\u0634 \u0626\u06C8\u0686\u06C8\u0646 \u0642\u06C7\u0644\u0627\u064A\u0644\u0649\u0642\u0644\u0649\u0642 \u062A\u06D5\u06AD\u0634\u06D5\u0643\u0644\u0649\u0631\u0649\u0646\u0649 \u0626\u06D0\u0686\u0649\u06AD."
          }
        },
        "zu-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "IMorphic ayikwazanga ukushintsha i-Increase Contrast ngokuzenzakalelayo. Vula izilungiselelo ze-Accessibility ukuze uyishintshe."
          }
        }
      }
    },

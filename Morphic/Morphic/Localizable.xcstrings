        },
        "hu-HU": {
          "stringUnit": {
            "state": "translated",
            "value": "A Morphic nem tudta automatikusan \u00E1tkapcsolni a Kontraszt n\u00F6vel\u00E9se be\u00E1ll\u00EDt\u00E1st. Nyissa meg a Kiseg\u00EDt\u0151 lehet\u0151s\u00E9gek be\u00E1ll\u00EDt\u00E1sait a be- vagy kikapcsol\u00E1shoz."
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic-\u10DB\u10D0 \u10D5\u10D4\u10E0 \u10E8\u10D4\u10EB\u10DA\u10DD \u201E\u10D9\u10DD\u10DC\u10E2\u10E0\u10D0\u10E1\u10E2\u10D8\u10E1 \u10D2\u10D0\u10D6\u10E0\u10D3\u10D8\u10E1\u201C \u10D0\u10D5\u10E2\u10DD\u10DB\u10D0\u10E2\u10E3\u10E0\u10D0\u10D3 \u10D2\u10D0\u10D3\u10D0\u10E0\u10D7\u10D5\u10D0. \u10E9\u10D0\u10E0\u10D7\u10D4\u10D7 \u10D8\u10D2\u10D8 \u201E\u10EC\u10D5\u10D3\u10DD\u10DB\u10D0\u10D3\u10DD\u10D1\u10D8\u10E1\u201C \u10DE\u10D0\u10E0\u10D0\u10DB\u10D4\u10E2\u10E0\u10D4\u10D1\u10E8\u10D8."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic couldn\u2019t switch Increase Contrast automatically. Open Accessibility settings to toggle it."
          }
        },
        "ga-IE": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00EDorbh fh\u00E9idir le Morphic M\u00E9adaigh Codarsnacht a athr\u00FA go huathoibr\u00EDoch. Oscail socruithe Inrochtaineachta chun \u00E9 a scor\u00E1n\u00FA."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic tidak dapat mengalihkan Tingkatkan Kontras secara otomatis. Buka pengaturan Aksesibilitas untuk mengalihkannya."
          }
        },
        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u00AB\u041A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0442\u044B \u0430\u0440\u0442\u0442\u044B\u0440\u0443\u00BB \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0456\u043D \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0442\u044B \u0442\u04AF\u0440\u0434\u0435 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0430 \u0430\u043B\u043C\u0430\u0434\u044B. \u041E\u043D\u044B \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043F \u049B\u043E\u0441\u0443 \u04AF\u0448\u0456\u043D \u0430\u0440\u043D\u0430\u0439\u044B \u043C\u04AF\u043C\u043A\u0456\u043D\u0434\u0456\u043A\u0442\u0435\u0440 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043B\u0435\u0440\u0456\u043D \u0430\u0448\u044B\u04A3\u044B\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u1798\u17B7\u1793\u17A2\u17B6\u1785\u1794\u17D2\u178A\u17BC\u179A Increase Contrast \u178A\u17C4\u1799\u179F\u17D2\u179C\u17D0\u1799\u1794\u17D2\u179A\u179C\u178F\u17D2\u178F\u17B7\u1794\u17B6\u1793\u1791\u17C1\u17D4 \u1794\u17BE\u1780\u1780\u17B6\u179A\u1780\u17C6\u178E\u178F\u17CB\u1797\u17B6\u1796\u1784\u17B6\u1799\u179F\u17D2\u179A\u17BD\u179B \u178A\u17BE\u1798\u17D2\u1794\u17B8\u1794\u17B7\u1791/\u1794\u17BE\u1780\u179C\u17B6\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0906\u092A\u0938\u0942\u0915 Increase Contrast \u092C\u0926\u0932\u092A\u093E\u0915 \u0936\u0915\u0928\u093E. \u0924\u094B \u091A\u093E\u0932\u0942/\u092C\u0902\u0926 \u0915\u0930\u092A\u093E\u0915 Accessibility \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C \u0909\u0917\u0921\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201EMorphic\u201C negal\u0117jo automati\u0161kai perjungti didesnio kontrasto. Atidarykite pritaikymo ne\u012Fgaliesiems parametrus, kad j\u012F perjungtum\u0117te."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic nevar\u0113ja autom\u0101tiski p\u0101rsl\u0113gt opciju Palielin\u0101t kontrastu. Atveriet pieejam\u012Bbas iestat\u012Bjumus, lai to p\u0101rsl\u0113gtu."
          }
        },
        "is-IS": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic gat ekki kveikt \u00E1 Auka birtuskil sj\u00E1lfkrafa. Opna\u00F0u stillingar fyrir a\u00F0gengi til a\u00F0 breyta \u00FEv\u00ED."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0C95\u0CBE\u0C82\u0C9F\u0CCD\u0CB0\u0CBE\u0CB8\u0CCD\u0C9F\u0CCD \u0CB9\u0CC6\u0C9A\u0CCD\u0C9A\u0CBF\u0CB8\u0CC1\u0CB5\u0CBF\u0C95\u0CC6\u0CAF\u0CA8\u0CCD\u0CA8\u0CC1 \u0CB8\u0CCD\u0CB5\u0CAF\u0C82\u0C9A\u0CBE\u0CB2\u0CBF\u0CA4\u0CB5\u0CBE\u0C97\u0CBF \u0CAC\u0CA6\u0CB2\u0CBE\u0CAF\u0CBF\u0CB8\u0CB2\u0CC1 \u0CB8\u0CBE\u0CA7\u0CCD\u0CAF\u0CB5\u0CBE\u0C97\u0CB2\u0CBF\u0CB2\u0CCD\u0CB2. \u0C85\u0CA6\u0CA8\u0CCD\u0CA8\u0CC1 \u0C9F\u0CBE\u0C97\u0CB2\u0CCD \u0CAE\u0CBE\u0CA1\u0CB2\u0CC1 \u0CAA\u0CCD\u0CB0\u0CB5\u0CC7\u0CB6\u0CB8\u0CBE\u0CA7\u0CCD\u0CAF\u0CA4\u0CC6 \u0CB8\u0CC6\u0C9F\u0CCD\u0C9F\u0CBF\u0C82\u0C97\u0CCD\u200C\u0C97\u0CB3\u0CA8\u0CCD\u0CA8\u0CC1 \u0CA4\u0CC6\u0CB0\u0CC6\u0CAF\u0CBF\u0CB0\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0441\u043A\u0438 \u0434\u0430 \u0433\u043E \u0432\u043A\u043B\u0443\u0447\u0438 \u0437\u0433\u043E\u043B\u0435\u043C\u0435\u043D\u0438\u043E\u0442 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442. \u041E\u0442\u0432\u043E\u0440\u0435\u0442\u0435 \u0433\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438\u0442\u0435 \u0437\u0430 \u043F\u0440\u0438\u0441\u0442\u0430\u043F\u043D\u043E\u0441\u0442 \u0437\u0430 \u0434\u0430 \u0433\u043E \u0432\u043A\u043B\u0443\u0447\u0438\u0442\u0435."

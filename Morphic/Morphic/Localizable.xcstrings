        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u10DB\u10DD\u10DC\u10D8\u10E8\u10DC\u10E3\u10DA\u10D8\u10E1 \u10EC\u10D0\u10D9\u10D8\u10D7\u10EE\u10D5\u10D0\u10DB\u201C \u10E8\u10D4\u10E1\u10D0\u10EB\u10DA\u10DD\u10D0 \u10D0\u10E0\u10D0\u10E1\u10EC\u10DD\u10E0\u10D8 \u10E4\u10D0\u10DC\u10EF\u10D0\u10E0\u10D0 \u10EC\u10D0\u10D8\u10D9\u10D8\u10D7\u10EE\u10D0. \u10D3\u10D0\u10D0\u10EC\u10D9\u10D0\u10DE\u10E3\u10DC\u10D4\u10D7 \u10D7\u10E5\u10D5\u10D4\u10DC\u10E1 \u10E2\u10D4\u10E5\u10E1\u10E2\u10E8\u10D8 \u10D3\u10D0 \u10E1\u10EA\u10D0\u10D3\u10D4\u10D7 \u10EE\u10D4\u10DA\u10D0\u10EE\u10DA\u10D0."

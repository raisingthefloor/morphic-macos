        "uz-Latn-UZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201CQirqib olish\u201D funksiyasi uchun \u201CEkranni yozib olish\u201D ruxsati talab qilinadi. Tizim sozlamalarida ruxsat bering, so\u02BBngra Morphic\u2019ni qayta ishga tushiring."
          }
        },
        "ca-ES-valencia": {
          "stringUnit": {
            "state": "translated",
            "value": "Retall requerix Gravaci\u00F3 de pantalla. Concedix-la en Configuraci\u00F3 del Sistema i despr\u00E9s reinicia Morphic."
          }
        },
        "chr-CHER-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u13A6\u13DF\u13CC\u13C5 \u13A0\u13C2\u13F4\u13D7 \u13A0\u13DA\u13B5\u13AD. \u13D7\u13A6\u13C1\u13DF\u13F4\u13CD\u13D7 \u13EB\u13EF\u13C1\u13B3\u13C5\u13AF\u13D3, \u13BF\u13C9 Morphic \u13D4\u13B5\u13C1 \u13AD\u13B4\u13CD\u13D3."
          }
        },
        "mi-NZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka hiahiatia te Screen Recording m\u014D te Kuti. Whakaaetia i System Settings, k\u0101tahi ka t\u012Bmata an\u014D i a Morphic."
          }
        },
        "nn-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermutklipp krev l\u00F8yve til skjermopptak. Gje l\u00F8yve i Systeminnstillingar, og start deretter Morphic p\u00E5 nytt."
          }
        },
        "quz-PE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuchuyqa Screen Recording nisqatan ma\u00F1akun. System Settings nisqapi saqiy, chaymanta Morphic kaqmanta qallarichiy."
          }
        },
        "sq-AL": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerja k\u00EBrkon Regjistrimin e ekranit. Lejojeni te Cil\u00EBsimet e sistemit, pastaj rinisni Morphic."
          }
        },
        "sr-Cyrl-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0458\u0435\u0447\u0430\u043A \u0437\u0430\u0445\u0442\u0438\u0458\u0435\u0432\u0430 \u0421\u043D\u0438\u043C\u0430\u045A\u0435 \u0435\u043A\u0440\u0430\u043D\u0430. \u041E\u0434\u043E\u0431\u0440\u0438\u0442\u0435 \u0433\u0430 \u0443 \u0421\u0438\u0441\u0442\u0435\u043C\u0441\u043A\u0438\u043C \u043F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0438\u043C\u0430, \u043F\u0430 \u043F\u043E\u043D\u043E\u0432\u043E \u043F\u043E\u043A\u0440\u0435\u043D\u0438\u0442\u0435 Morphic."
          }
        },
        "sr-Cyrl-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0435\u0446\u0430\u045A\u0435 \u0437\u0430\u0445\u0442\u0435\u0432\u0430 \u0421\u043D\u0438\u043C\u0430\u045A\u0435 \u0435\u043A\u0440\u0430\u043D\u0430. \u041E\u0434\u043E\u0431\u0440\u0438\u0442\u0435 \u0433\u0430 \u0443 \u041F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0438\u043C\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u043F\u0430 \u043F\u043E\u043D\u043E\u0432\u043E \u043F\u043E\u043A\u0440\u0435\u043D\u0438\u0442\u0435 Morphic."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0C38\u0C4D\u0C28\u0C3F\u0C2A\u0C4D \u0C15\u0C4B\u0C38\u0C02 \u0C38\u0C4D\u0C15\u0C4D\u0C30\u0C40\u0C28\u0C4D \u0C30\u0C3F\u0C15\u0C3E\u0C30\u0C4D\u0C21\u0C3F\u0C02\u0C17\u0C4D \u0C05\u0C35\u0C38\u0C30\u0C02. \u0C38\u0C3F\u0C38\u0C4D\u0C1F\u0C2E\u0C4D \u0C38\u0C46\u0C1F\u0C4D\u0C1F\u0C3F\u0C02\u0C17\u0C4D\u200C\u0C32\u0C32\u0C4B \u0C26\u0C3E\u0C28\u0C4D\u0C28\u0C3F \u0C05\u0C28\u0C41\u0C2E\u0C24\u0C3F\u0C02\u0C1A\u0C3F, \u0C06\u0C2A\u0C48 Morphic\u0C28\u0C3F \u0C2A\u0C41\u0C28\u0C03\u0C2A\u0C4D\u0C30\u0C3E\u0C30\u0C02\u0C2D\u0C3F\u0C02\u0C1A\u0C02\u0C21\u0C3F."
          }
        },
        "lb-LU": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip erfuerdert \u00C9cranopnam. Erlaabt se an de Systemastellungen, a start Morphic dann nei."
          }
        },
        "lo-LA": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u0E95\u0EC9\u0EAD\u0E87\u0E81\u0EB2\u0E99 Screen Recording. \u0E81\u0EB0\u0EA5\u0EB8\u0E99\u0EB2\u0EAD\u0EB0\u0E99\u0EB8\u0E8D\u0EB2\u0E94\u0EC3\u0E99 System Settings, \u0EC1\u0EA5\u0EC9\u0EA7\u0EC0\u0EA5\u0EB5\u0EC8\u0EA1 Morphic \u0EC3\u0EDD\u0EC8."
          }
        },
        "tt-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041A\u0438\u0441\u0435\u043F \u0430\u043B\u0443 \u04E9\u0447\u0435\u043D \u042D\u043A\u0440\u0430\u043D\u043D\u044B \u044F\u0437\u0434\u044B\u0440\u0443 \u043A\u0438\u0440\u04D9\u043A. \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043A\u04E9\u0439\u043B\u04D9\u04AF\u043B\u04D9\u0440\u0435\u043D\u0434\u04D9 \u0440\u04E9\u0445\u0441\u04D9\u0442 \u0431\u0438\u0440\u0435\u0433\u0435\u0437, \u0430\u043D\u043D\u0430\u0440\u044B Morphic\u0027\u043D\u044B \u044F\u04A3\u0430\u0434\u0430\u043D \u044D\u0448\u043B\u04D9\u0442\u0435\u043F \u0497\u0438\u0431\u04D9\u0440\u0435\u0433\u0435\u0437."
          }
        },
        "ug-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0643\u06D0\u0633\u0649\u0634 \u0626\u06C8\u0686\u06C8\u0646 \u0626\u06D0\u0643\u0631\u0627\u0646 \u062E\u0627\u062A\u0649\u0631\u0649\u0644\u06D5\u0634 \u0631\u06C7\u062E\u0633\u0649\u062A\u0649 \u0643\u06D0\u0631\u06D5\u0643. \u0626\u06C7\u0646\u0649 \u0633\u0649\u0633\u062A\u06D0\u0645\u0627 \u062A\u06D5\u06AD\u0634\u06D5\u0643\u0644\u0649\u0631\u0649 \u062F\u06D5 \u0628\u06D0\u0631\u0649\u067E\u060C \u0626\u0627\u0646\u062F\u0649\u0646 Morphic \u0646\u0649 \u0642\u0627\u064A\u062A\u0627 \u0642\u0648\u0632\u063A\u0649\u062A\u0649\u06AD."
          }
        },
        "xh-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Snip ifuna i-Screen Recording. Yinike imvume kwi-System Settings, uze uqalise kwakhona i-Morphic."
          }
        }
      }
    },

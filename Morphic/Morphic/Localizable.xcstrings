        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce P\u0159e\u010D\u00EDst vybran\u00E9 mo\u017En\u00E1 p\u0159e\u010Detla nespr\u00E1vn\u00E9 okno. Klikn\u011Bte do textu a zkuste to znovu."

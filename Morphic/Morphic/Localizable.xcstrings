    "ReadSelectedSpeakSelectionDisabledMessage": {
      "comment": "[loc-id:18a693419f16d0dd] Notification toast body shown when Read Selected can\u0027t work because the macOS \u201CSpeak selection\u201D feature is turned off. Tells the user to enable it. \u201CSpeak selection\u201D is the macOS Accessibility setting name; match Apple\u0027s wording. \u0022Morphic\u0022/Read Selected are product features.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected uses macOS \u201CSpeak selection,\u201D which is currently turned off. Turn it on in Accessibility settings, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201EAuswahl vorlesen\u201C verwendet die macOS-Funktion \u201EAuswahl sprechen\u201C, die derzeit deaktiviert ist. Aktivieren Sie sie in den Bedienungshilfen-Einstellungen, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa \u201CLeer selecci\u00F3n\u201D de macOS, que est\u00E1 desactivada. Act\u00EDvala en los ajustes de Accesibilidad y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0633\u062A\u062E\u062F\u0645 \u00AB\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u00BB \u0645\u064A\u0632\u0629 \u00AB\u0646\u0637\u0642 \u0627\u0644\u062A\u062D\u062F\u064A\u062F\u00BB \u0641\u064A macOS\u060C \u0648\u0647\u064A \u0645\u062A\u0648\u0642\u0641\u0629 \u062D\u0627\u0644\u064A\u064B\u0627. \u0634\u063A\u0651\u0644\u0647\u0627 \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u060C \u062B\u0645 \u062D\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u062E\u0648\u0627\u0646\u062F\u0646 \u0645\u0648\u0627\u0631\u062F \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647\u00BB \u0627\u0632 \u0648\u06CC\u0698\u06AF\u06CC \u00ABSpeak selection\u00BB \u062F\u0631 macOS \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u062F\u0631 \u062D\u0627\u0644 \u062D\u0627\u0636\u0631 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u0627\u0633\u062A. \u0622\u0646 \u0631\u0627 \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0648\u0634\u0646 \u06A9\u0646\u06CC\u062F \u0648 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected macOS \u201CSpeak selection\u201D \u0AA8\u0ACB \u0A89\u0AAA\u0AAF\u0ACB\u0A97 \u0A95\u0AB0\u0AC7 \u0A9B\u0AC7, \u0A9C\u0AC7 \u0AB9\u0ABE\u0AB2\u0AAE\u0ABE\u0A82 \u0AAC\u0A82\u0AA7 \u0A9B\u0AC7. \u0AA4\u0AC7\u0AA8\u0AC7 \u0A8D\u0A95\u0ACD\u0AB8\u0AC7\u0AB8\u0ABF\u0AAC\u0ABF\u0AB2\u0ABF\u0A9F\u0AC0 \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8\u0AAE\u0ABE\u0A82 \u0A9A\u0ABE\u0AB2\u0AC1 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091A\u092F\u0928\u093F\u0924 \u092A\u0922\u093C\u0947\u0902 macOS \u201C\u091A\u092F\u0928 \u092C\u094B\u0932\u0947\u0902\u201D \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0924\u093E \u0939\u0948, \u091C\u094B \u0935\u0930\u094D\u0924\u092E\u093E\u0928 \u092E\u0947\u0902 \u092C\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0947 \u090F\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917 \u092E\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u0930\u0947\u0902, \u092B\u093F\u0930 \u0938\u0947 \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uC120\uD0DD \uD56D\uBAA9 \uC77D\uAE30\uB294 macOS \u201C\uC120\uD0DD \uD56D\uBAA9 \uB9D0\uD558\uAE30\u201D\uB97C \uC0AC\uC6A9\uD558\uC9C0\uB9CC, \uD604\uC7AC \uAEBC\uC838 \uC788\uC2B5\uB2C8\uB2E4. \uC190\uC26C\uC6B4 \uC0AC\uC6A9 \uC124\uC815\uC5D0\uC11C \uCF20 \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093F\u0935\u0921\u0932\u0947\u0932\u0947 \u0935\u093E\u091A\u093E macOS \u091A\u0947 \u201CSpeak selection\u201D \u0935\u093E\u092A\u0930\u0924\u0947, \u091C\u0947 \u0938\u0927\u094D\u092F\u093E \u092C\u0902\u0926 \u0906\u0939\u0947. \u0924\u0947 \u0905\u200D\u0945\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C\u092E\u0927\u094D\u092F\u0947 \u091A\u093E\u0932\u0942 \u0915\u0930\u093E \u0906\u0923\u093F \u0928\u0902\u0924\u0930 \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected\u060C macOS \u06A9\u06CC \u201DSpeak selection\u201C \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0648 \u0641\u06CC \u0627\u0644\u062D\u0627\u0644 \u0628\u0646\u062F \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 Accessibility \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0645\u06CC\u06BA \u0622\u0646 \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201C\u6717\u8BFB\u6240\u9009\u5185\u5BB9\u201D\u4F7F\u7528 macOS \u7684\u201C\u6717\u8BFB\u6240\u9009\u9879\u201D\u529F\u80FD\uFF0C\u8BE5\u529F\u80FD\u5F53\u524D\u5DF2\u5173\u95ED\u3002\u8BF7\u5728\u201C\u8F85\u52A9\u529F\u80FD\u201D\u8BBE\u7F6E\u4E2D\u5C06\u5176\u6253\u5F00\uFF0C\u7136\u540E\u518D\u8BD5\u4E00\u6B21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300C\u6717\u8B80\u9078\u53D6\u7BC4\u570D\u300D\u4F7F\u7528 macOS \u7684\u300C\u6717\u8B80\u6240\u9078\u7BC4\u570D\u300D\uFF0C\u4F46\u8A72\u529F\u80FD\u76EE\u524D\u5DF2\u95DC\u9589\u3002\u8ACB\u5728\u300C\u8F14\u52A9\u4F7F\u7528\u300D\u8A2D\u5B9A\u4E2D\u5C07\u5176\u958B\u555F\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        }
      }
    },
    "ReadSelectedWrongWindowMessage": {
      "comment": "[loc-id:c212af8ae8e964e7] Notification toast body shown when Read Selected may have read from the wrong window (the user\u0027s app didn\u0027t refocus in time). Two sentences; tells the user how to retry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected may have read the wrong window. Click into your text and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201EAuswahl vorlesen\u201C hat m\u00F6glicherweise aus dem falschen Fenster vorgelesen. Klicken Sie in Ihren Text, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que Leer selecci\u00F3n haya le\u00EDdo la ventana equivocada. Haz clic en tu texto y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u062F \u062A\u0643\u0648\u0646 \u00AB\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u00BB \u0642\u0631\u0623\u062A \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u062E\u0637\u0623. \u0627\u0646\u0642\u0631 \u062F\u0627\u062E\u0644 \u0627\u0644\u0646\u0635 \u0648\u062D\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u00AB\u062E\u0648\u0627\u0646\u062F\u0646 \u0645\u062A\u0646 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647\u00BB \u067E\u0646\u062C\u0631\u0647\u0654 \u0627\u0634\u062A\u0628\u0627\u0647\u06CC \u0631\u0627 \u062E\u0648\u0627\u0646\u062F\u0647 \u0628\u0627\u0634\u062F. \u0631\u0648\u06CC \u0645\u062A\u0646 \u062E\u0648\u062F \u06A9\u0644\u06CC\u06A9 \u06A9\u0646\u06CC\u062F \u0648 \u062F\u0648\u0628\u0627\u0631\u0647 \u062A\u0644\u0627\u0634 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0A8F \u0A95\u0AA6\u0ABE\u0A9A \u0A96\u0ACB\u0A9F\u0AC0 \u0AB5\u0ABF\u0AA8\u0ACD\u0AA1\u0ACB \u0AB5\u0ABE\u0A82\u0A9A\u0AC0 \u0AB9\u0AB6\u0AC7. \u0AA4\u0AAE\u0ABE\u0AB0\u0ABE \u0A9F\u0AC7\u0A95\u0ACD\u0AB8\u0ACD\u0A9F\u0AAE\u0ABE\u0A82 \u0A95\u0ACD\u0AB2\u0ABF\u0A95 \u0A95\u0AB0\u0ACB \u0A85\u0AA8\u0AC7 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091A\u092F\u0928\u093F\u0924 \u092A\u0922\u093C\u0947\u0902 \u0928\u0947 \u0936\u093E\u092F\u0926 \u0917\u0932\u0924 \u0935\u093F\u0902\u0921\u094B \u0915\u094B \u092A\u0922\u093C \u0932\u093F\u092F\u093E \u0939\u0948\u0964 \u0905\u092A\u0928\u0947 \u091F\u0947\u0915\u094D\u0938\u094D\u091F \u092E\u0947\u0902 \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092B\u093F\u0930 \u0938\u0947 \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uC120\uD0DD \uD56D\uBAA9 \uC77D\uAE30\uAC00 \uC798\uBABB\uB41C \uCC3D\uC744 \uC77D\uC5C8\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD14D\uC2A4\uD2B8\uB97C \uD074\uB9AD\uD55C \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093F\u0935\u0921\u0932\u0947\u0932\u0947 \u0935\u093E\u091A\u093E \u0935\u0948\u0936\u093F\u0937\u094D\u091F\u094D\u092F\u093E\u0928\u0947 \u0915\u0926\u093E\u091A\u093F\u0924 \u091A\u0941\u0915\u0940\u091A\u0940 \u0935\u093F\u0902\u0921\u094B \u0935\u093E\u091A\u0932\u0940 \u0905\u0938\u0947\u0932. \u0924\u0941\u092E\u091A\u094D\u092F\u093E \u092E\u091C\u0915\u0941\u0930\u093E\u0924 \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u093E \u0906\u0923\u093F \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\u06C1\u0648 \u0633\u06A9\u062A\u0627 \u06C1\u06D2 Read Selected \u0646\u06D2 \u063A\u0644\u0637 \u0648\u0646\u0688\u0648 \u067E\u0691\u06BE \u0644\u06CC \u06C1\u0648\u06D4 \u0627\u067E\u0646\u06D2 \u0645\u062A\u0646 \u0645\u06CC\u06BA \u06A9\u0644\u06A9 \u06A9\u0631\u06CC\u06BA \u0627\u0648\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ECDc ph\u1EA7n \u0111\u00E3 ch\u1ECDn c\u00F3 th\u1EC3 \u0111\u00E3 \u0111\u1ECDc nh\u1EA7m c\u1EEDa s\u1ED5. B\u1EA5m v\u00E0o v\u0103n b\u1EA3n c\u1EE7a b\u1EA1n r\u1ED3i th\u1EED l\u1EA1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201C\u6717\u8BFB\u6240\u9009\u5185\u5BB9\u201D\u53EF\u80FD\u8BFB\u53D6\u4E86\u9519\u8BEF\u7684\u7A97\u53E3\u3002\u8BF7\u5728\u6587\u672C\u4E2D\u5355\u51FB\uFF0C\u7136\u540E\u518D\u8BD5\u4E00\u6B21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300C\u6717\u8B80\u9078\u53D6\u7BC4\u570D\u300D\u53EF\u80FD\u6717\u8B80\u4E86\u932F\u8AA4\u7684\u8996\u7A97\u3002\u8ACB\u6309\u4E00\u4E0B\u60A8\u7684\u6587\u5B57\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        }
      }
    },
    "RestartMorphicButtonLabel": {
      "comment": "[loc-id:f83db7160a4585b3] Action button on a Morphic notification toast that relaunches the app. \u0022Morphic\u0022 is a product name; do not translate it. Short imperative.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Morphic"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar Morphic"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0639\u0627\u062F\u0629 \u062A\u0634\u063A\u064A\u0644 Morphic"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0627\u0647\u200C\u0627\u0646\u062F\u0627\u0632\u06CC \u0645\u062C\u062F\u062F Morphic"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0AAB\u0AB0\u0AC0 \u0AB6\u0AB0\u0AC2 \u0A95\u0AB0\u0ACB"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0915\u094B \u092A\u0941\u0928\u0930\u093E\u0930\u0902\u092D \u0915\u0930\u0947\u0902"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \uB2E4\uC2DC \uC2DC\uC791"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0930\u0940\u0938\u094D\u091F\u093E\u0930\u094D\u091F \u0915\u0930\u093E"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u06A9\u0648 \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u1EDFi \u0111\u1ED9ng l\u1EA1i Morphic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91CD\u65B0\u542F\u52A8 Morphic"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91CD\u65B0\u555F\u52D5 Morphic"
          }
        }
      }
    },
    "ScreenRecordingGrantedRestartMessage": {
      "comment": "[loc-id:087e4f04ab021ac4] Notification toast body shown after the user grants Screen Recording permission, telling them to restart Morphic for it to take effect. \u0022Morphic\u0022 is a product name; \u0022Screen Recording\u0022 is the macOS privacy permission name (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung f\u00FCr Bildschirmaufnahme wurde erteilt. Starten Sie Morphic neu, damit die \u00C4nderung wirksam wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedi\u00F3 el permiso de Grabaci\u00F3n de pantalla. Reinicia Morphic para que el cambio surta efecto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0645 \u0645\u0646\u062D \u0625\u0630\u0646 \u00AB\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0634\u0627\u0634\u0629\u00BB. \u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 Morphic \u0644\u064A\u0635\u0628\u062D \u0627\u0644\u062A\u063A\u064A\u064A\u0631 \u0633\u0627\u0631\u064A \u0627\u0644\u0645\u0641\u0639\u0648\u0644."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062C\u0648\u0632 \u00AB\u0636\u0628\u0637 \u0635\u0641\u062D\u0647\u200C\u0646\u0645\u0627\u06CC\u0634\u00BB \u062F\u0627\u062F\u0647 \u0634\u062F. \u0628\u0631\u0627\u06CC \u0627\u0639\u0645\u0627\u0644 \u062A\u063A\u06CC\u06CC\u0631\u060C Morphic \u0631\u0627 \u0631\u0627\u0647\u200C\u0627\u0646\u062F\u0627\u0632\u06CC \u0645\u062C\u062F\u062F \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u0AAE\u0A82\u0A9C\u0AC2\u0AB0 \u0A95\u0AB0\u0ABE\u0AAF\u0AC1\u0A82. \u0AAB\u0AC7\u0AB0\u0AAB\u0ABE\u0AB0 \u0A85\u0AAE\u0AB2\u0AAE\u0ABE\u0A82 \u0A86\u0AB5\u0AC7 \u0AA4\u0AC7 \u0AAE\u0ABE\u0A9F\u0AC7 Morphic \u0AAB\u0AB0\u0AC0 \u0AB6\u0AB0\u0AC2 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0915\u094D\u0930\u0940\u0928 \u0930\u093F\u0915\u0949\u0930\u094D\u0921\u093F\u0902\u0917 \u0915\u0940 \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u0947 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964 \u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928 \u0932\u093E\u0917\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F Morphic \u0915\u094B \u092A\u0941\u0928\u0930\u093E\u0930\u0902\u092D \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uD654\uBA74 \uAE30\uB85D\uC774 \uD5C8\uC6A9\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBCC0\uACBD \uC0AC\uD56D\uC744 \uC801\uC6A9\uD558\uB824\uBA74 Morphic\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u091A\u0940 \u092A\u0930\u0935\u093E\u0928\u0917\u0940 \u0926\u093F\u0932\u0940 \u0917\u0947\u0932\u0940 \u0906\u0939\u0947. \u092C\u0926\u0932 \u0932\u093E\u0917\u0942 \u0939\u094B\u0923\u094D\u092F\u093E\u0938\u093E\u0920\u0940 Morphic \u0930\u0940\u0938\u094D\u091F\u093E\u0930\u094D\u091F \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u06A9\u06CC \u0627\u062C\u0627\u0632\u062A \u062F\u06D2 \u062F\u06CC \u06AF\u0626\u06CC\u06D4 \u062A\u0628\u062F\u06CC\u0644\u06CC \u06A9\u06D2 \u0646\u0627\u0641\u0630 \u06C1\u0648\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy\u1EC1n Ghi m\u00E0n h\u00ECnh \u0111\u00E3 \u0111\u01B0\u1EE3c c\u1EA5p. Kh\u1EDFi \u0111\u1ED9ng l\u1EA1i Morphic \u0111\u1EC3 thay \u0111\u1ED5i c\u00F3 hi\u1EC7u l\u1EF1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5DF2\u6388\u4E88\u201C\u5C4F\u5E55\u5F55\u5236\u201D\u6743\u9650\u3002\u8BF7\u91CD\u542F Morphic \u4EE5\u4F7F\u66F4\u6539\u751F\u6548\u3002"
          }
        }
      }
    },
    "SettingsDialogBlockingMessage": {
      "comment": "[loc-id:82900dc9c0dd22cb] Notification toast body shown when Morphic can\u0027t change a setting because System Settings has a modal dialog open that Morphic won\u0027t close automatically. Asks the user to close it and retry. \u0022Morphic\u0022 is a product name; \u0022System Settings\u0022 is the macOS app name (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic is trying to change a setting, but System Settings has a dialog open that it can\u2019t close for you. Please close that dialog, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic versucht, eine Einstellung zu \u00E4ndern, aber in den Systemeinstellungen ist ein Dialogfeld ge\u00F6ffnet, das nicht automatisch geschlossen werden kann. Schlie\u00DFen Sie dieses Dialogfeld, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 intentando cambiar un ajuste, pero Ajustes del Sistema tiene un cuadro de di\u00E1logo abierto que no puede cerrar por ti. Cierra ese cuadro de di\u00E1logo y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064A\u062D\u0627\u0648\u0644 Morphic \u062A\u063A\u064A\u064A\u0631 \u0623\u062D\u062F \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A\u060C \u0644\u0643\u0646 \u064A\u0648\u062C\u062F \u0645\u0631\u0628\u0639 \u062D\u0648\u0627\u0631 \u0645\u0641\u062A\u0648\u062D \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0646\u0638\u0627\u0645 \u064A\u062A\u0639\u0630\u0651\u0631 \u0639\u0644\u064A\u0647 \u0625\u063A\u0644\u0627\u0642\u0647 \u0646\u064A\u0627\u0628\u0629\u064B \u0639\u0646\u0643. \u064A\u064F\u0631\u062C\u0649 \u0625\u063A\u0644\u0627\u0642 \u0645\u0631\u0628\u0639 \u0627\u0644\u062D\u0648\u0627\u0631 \u0647\u0630\u0627\u060C \u062B\u0645 \u062D\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062F\u0631 \u062A\u0644\u0627\u0634 \u0627\u0633\u062A \u06CC\u06A9 \u062A\u0646\u0638\u06CC\u0645 \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F\u060C \u0627\u0645\u0627 \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0633\u06CC\u0633\u062A\u0645 \u06CC\u06A9 \u067E\u0646\u062C\u0631\u0647\u0654 \u06AF\u0641\u062A\u06AF\u0648 \u0628\u0627\u0632 \u0627\u0633\u062A \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0634\u0645\u0627 \u0628\u0628\u0646\u062F\u062F. \u0644\u0637\u0641\u0627\u064B \u0622\u0646 \u067E\u0646\u062C\u0631\u0647 \u0631\u0627 \u0628\u0628\u0646\u062F\u06CC\u062F\u060C \u0633\u067E\u0633 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97 \u0AAC\u0AA6\u0AB2\u0AB5\u0ABE\u0AA8\u0ACB \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0AC0 \u0AB0\u0AB9\u0ACD\u0AAF\u0AC1\u0A82 \u0A9B\u0AC7, \u0AAA\u0AB0\u0A82\u0AA4\u0AC1 System Settings \u0AAE\u0ABE\u0A82 \u0A8F\u0A95 \u0AA1\u0ABE\u0AAF\u0AB2\u0ACB\u0A97 \u0A96\u0AC1\u0AB2\u0ACD\u0AB2\u0ACB \u0A9B\u0AC7 \u0A9C\u0AC7\u0AA8\u0AC7 \u0AA4\u0AC7 \u0AA4\u0AAE\u0ABE\u0AB0\u0ABE \u0AAE\u0ABE\u0A9F\u0AC7 \u0AAC\u0A82\u0AA7 \u0A95\u0AB0\u0AC0 \u0AB6\u0A95\u0AA4\u0AC1\u0A82 \u0AA8\u0AA5\u0AC0. \u0A95\u0AC3\u0AAA\u0ABE \u0A95\u0AB0\u0AC0\u0AA8\u0AC7 \u0AA4\u0AC7 \u0AA1\u0ABE\u0AAF\u0AB2\u0ACB\u0A97 \u0AAC\u0A82\u0AA7 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u090F\u0915 \u0938\u0947\u091F\u093F\u0902\u0917 \u092C\u0926\u0932\u0928\u0947 \u0915\u093E \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930 \u0930\u0939\u093E \u0939\u0948, \u0932\u0947\u0915\u093F\u0928 \u0938\u093F\u0938\u094D\u091F\u092E \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u090F\u0915 \u0921\u093E\u092F\u0932\u0949\u0917 \u0916\u0941\u0932\u093E \u0939\u0948 \u091C\u093F\u0938\u0947 \u0935\u0939 \u0906\u092A\u0915\u0947 \u0932\u093F\u090F \u092C\u0902\u0926 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093E\u0964 \u0915\u0943\u092A\u092F\u093E \u0909\u0938 \u0921\u093E\u092F\u0932\u0949\u0917 \u0915\u094B \u092C\u0902\u0926 \u0915\u0930\u0947\u0902, \u092B\u093F\u0930 \u092A\u0941\u0928\u0903 \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic\uC774 \uC124\uC815\uC744 \uBCC0\uACBD\uD558\uB824\uACE0 \uD558\uC9C0\uB9CC, \uC2DC\uC2A4\uD15C \uC124\uC815\uC5D0 Morphic\uC774 \uB2EB\uC744 \uC218 \uC5C6\uB294 \uB300\uD654\uC0C1\uC790\uAC00 \uC5F4\uB824 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uB300\uD654\uC0C1\uC790\uB97C \uB2EB\uC740 \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC2ED\uC2DC\uC624."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u090F\u0915 \u0938\u0947\u091F\u093F\u0902\u0917 \u092C\u0926\u0932\u0923\u094D\u092F\u093E\u091A\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u0924 \u0906\u0939\u0947, \u092A\u0930\u0902\u0924\u0941 System Settings \u092E\u0927\u094D\u092F\u0947 \u090F\u0915 \u0921\u093E\u092F\u0932\u0949\u0917 \u0909\u0918\u0921\u093E \u0906\u0939\u0947 \u091C\u094B \u0924\u0947 \u0924\u0941\u092E\u091A\u094D\u092F\u093E\u0938\u093E\u0920\u0940 \u092C\u0902\u0926 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093E\u0939\u0940. \u0915\u0943\u092A\u092F\u093E \u0924\u094B \u0921\u093E\u092F\u0932\u0949\u0917 \u092C\u0902\u0926 \u0915\u0930\u093E \u0906\u0923\u093F \u0928\u0902\u0924\u0930 \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0627\u06CC\u06A9 \u062A\u0631\u062A\u06CC\u0628 \u062A\u0628\u062F\u06CC\u0644 \u06A9\u0631\u0646\u06D2 \u06A9\u06CC \u06A9\u0648\u0634\u0634 \u06A9\u0631 \u0631\u06C1\u0627 \u06C1\u06D2\u060C \u0644\u06CC\u06A9\u0646 System Settings \u0645\u06CC\u06BA \u0627\u06CC\u06A9 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u06A9\u06BE\u0644\u0627 \u06C1\u06D2 \u062C\u0633\u06D2 \u06CC\u06C1 \u0622\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 \u0628\u0646\u062F \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u062A\u0627\u06D4 \u0628\u0631\u0627\u06C1\u0650 \u06A9\u0631\u0645 \u0648\u06C1 \u0688\u0627\u0626\u06CC\u0644\u0627\u06AF \u0628\u0646\u062F \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0111ang c\u1ED1 thay \u0111\u1ED5i m\u1ED9t c\u00E0i \u0111\u1EB7t, nh\u01B0ng C\u00E0i \u0111\u1EB7t h\u1EC7 th\u1ED1ng c\u00F3 m\u1ED9t h\u1ED9p tho\u1EA1i \u0111ang m\u1EDF m\u00E0 Morphic kh\u00F4ng th\u1EC3 \u0111\u00F3ng gi\u00FAp b\u1EA1n. Vui l\u00F2ng \u0111\u00F3ng h\u1ED9p tho\u1EA1i \u0111\u00F3, r\u1ED3i th\u1EED l\u1EA1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u6B63\u5728\u5C1D\u8BD5\u66F4\u6539\u4E00\u9879\u8BBE\u7F6E\uFF0C\u4F46\u201C\u7CFB\u7EDF\u8BBE\u7F6E\u201D\u4E2D\u6253\u5F00\u4E86\u4E00\u4E2A\u5BF9\u8BDD\u6846\uFF0CMorphic \u65E0\u6CD5\u4E3A\u4F60\u5173\u95ED\u3002\u8BF7\u5173\u95ED\u8BE5\u5BF9\u8BDD\u6846\uFF0C\u7136\u540E\u91CD\u8BD5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u6B63\u5728\u5617\u8A66\u8B8A\u66F4\u8A2D\u5B9A\uFF0C\u4F46\u300C\u7CFB\u7D71\u8A2D\u5B9A\u300D\u6709\u958B\u555F\u7684\u5C0D\u8A71\u6846\uFF0CMorphic \u7121\u6CD5\u4EE3\u60A8\u95DC\u9589\u3002\u8ACB\u95DC\u9589\u8A72\u5C0D\u8A71\u6846\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        }
      }
    },
    "ShowMorphicBar": {

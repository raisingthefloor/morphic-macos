    "ColorFiltersAccessibleName": {
      "comment": "[loc-id:a01691fe83984b2d] VoiceOver/accessibility label for the \u0022Color\u0022 toggle button on the MorphicBar; it turns the macOS Color Filters display feature on or off. Noun phrase naming the feature.",

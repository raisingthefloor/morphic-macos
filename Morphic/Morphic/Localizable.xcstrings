    "MagnifierZoomShortcutsDisabledMessage": {
      "comment": "[loc-id:7d74a5049d7becd2] Notification toast body shown when the Magnifier can\u0027t work because the macOS \u201CUse keyboard shortcuts to zoom\u201D setting is off. \u201CUse keyboard shortcuts to zoom\u201D is the macOS Accessibility setting name; match Apple\u0027s wording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnifier uses the macOS Zoom keyboard shortcuts, which are turned off. Turn on \u201CUse keyboard shortcuts to zoom\u201D in Accessibility settings, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmlupe verwendet die macOS-Tastaturkurzbefehle zum Zoomen, die deaktiviert sind. Aktivieren Sie \u201ETastaturkurzbefehle zum Zoomen verwenden\u201C in den Bedienungshilfen-Einstellungen, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lupa usa las funciones r\u00E1pidas de teclado del Zoom de macOS, que est\u00E1n desactivadas. Activa \u201CUsar funciones r\u00E1pidas de teclado para hacer zoom\u201D en los ajustes de Accesibilidad e int\u00E9ntalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064A\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0645\u0643\u0628\u0631 \u0627\u062E\u062A\u0635\u0627\u0631\u0627\u062A \u0644\u0648\u062D\u0629 \u0645\u0641\u0627\u062A\u064A\u062D \u0627\u0644\u062A\u0643\u0628\u064A\u0631/\u0627\u0644\u062A\u0635\u063A\u064A\u0631 \u0641\u064A macOS\u060C \u0648\u0647\u064A \u0642\u064A\u062F \u0627\u0644\u0625\u064A\u0642\u0627\u0641. \u0642\u0645 \u0628\u062A\u0634\u063A\u064A\u0644 \u0022\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u062E\u062A\u0635\u0627\u0631\u0627\u062A \u0644\u0648\u062D\u0629 \u0627\u0644\u0645\u0641\u0627\u062A\u064A\u062D \u0644\u0644\u062A\u0643\u0628\u064A\u0631/\u0627\u0644\u062A\u0635\u063A\u064A\u0631\u0022 \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u060C \u062B\u0645 \u062D\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0630\u0631\u0647\u200C\u0628\u06CC\u0646 \u0627\u0632 \u0645\u06CC\u0627\u0646\u200C\u0628\u0631\u0647\u0627\u06CC \u0635\u0641\u062D\u0647\u200C\u06A9\u0644\u06CC\u062F \u0628\u0632\u0631\u06AF\u200C\u0646\u0645\u0627\u06CC\u06CC macOS \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u062E\u0627\u0645\u0648\u0634 \u0647\u0633\u062A\u0646\u062F. \u06AF\u0632\u06CC\u0646\u0647\u0654 \u00AB\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 \u0645\u06CC\u0627\u0646\u200C\u0628\u0631\u0647\u0627\u06CC \u0635\u0641\u062D\u0647\u200C\u06A9\u0644\u06CC\u062F \u0628\u0631\u0627\u06CC \u0628\u0632\u0631\u06AF\u200C\u0646\u0645\u0627\u06CC\u06CC\u00BB \u0631\u0627 \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0648\u0634\u0646 \u06A9\u0646\u06CC\u062F\u060C \u0633\u067E\u0633 \u062F\u0648\u0628\u0627\u0631\u0647 \u062A\u0644\u0627\u0634 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0AAE\u0AC7\u0A97\u0ACD\u0AA8\u0ABF\u0AAB\u0ABE\u0AAF\u0AB0 macOS \u0A9D\u0AC2\u0AAE \u0A95\u0AC0\u0AAC\u0ACB\u0AB0\u0ACD\u0AA1 \u0AB6\u0AC9\u0AB0\u0ACD\u0A9F\u0A95\u0A9F\u0ACD\u0AB8\u0AA8\u0ACB \u0A89\u0AAA\u0AAF\u0ACB\u0A97 \u0A95\u0AB0\u0AC7 \u0A9B\u0AC7, \u0A9C\u0AC7 \u0AAC\u0A82\u0AA7 \u0A9B\u0AC7. \u0A8D\u0A95\u0ACD\u0AB8\u0AC7\u0AB8\u0ABF\u0AAC\u0ABF\u0AB2\u0ABF\u0A9F\u0AC0 \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8\u0AAE\u0ABE\u0A82 \u201CUse keyboard shortcuts to zoom\u201D \u0A9A\u0ABE\u0AB2\u0AC1 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 \u0AAB\u0AB0\u0AC0 \u0AAA\u0ACD\u0AB0\u0AAF\u0ABE\u0AB8 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092E\u0948\u0917\u094D\u0928\u093F\u092B\u093C\u093E\u092F\u0930 macOS \u091C\u093C\u0942\u092E \u0915\u0940\u092C\u094B\u0930\u094D\u0921 \u0936\u0949\u0930\u094D\u091F\u0915\u091F \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0924\u093E \u0939\u0948, \u091C\u094B \u092C\u0902\u0926 \u0939\u0948\u0902\u0964 \u090F\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u201C\u091C\u093C\u0942\u092E \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0915\u0940\u092C\u094B\u0930\u094D\u0921 \u0936\u0949\u0930\u094D\u091F\u0915\u091F \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0947\u0902\u201D \u091A\u093E\u0932\u0942 \u0915\u0930\u0947\u0902, \u092B\u093F\u0930 \u092A\u0941\u0928\u0903 \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uB3CB\uBCF4\uAE30\uB294 \uD604\uC7AC \uAEBC\uC838 \uC788\uB294 macOS \uD655\uB300/\uCD95\uC18C \uD0A4\uBCF4\uB4DC \uB2E8\uCD95\uD0A4\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uC190\uC26C\uC6B4 \uC0AC\uC6A9 \uC124\uC815\uC5D0\uC11C \u201C\uD655\uB300/\uCD95\uC18C\uD558\uB824\uBA74 \uD0A4\uBCF4\uB4DC \uB2E8\uCD95\uD0A4 \uC0AC\uC6A9\u201D\uC744 \uCF20 \uB2E4\uC74C \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC2ED\uC2DC\uC624."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092E\u0945\u0917\u094D\u0928\u093F\u092B\u093E\u092F\u0930 macOS \u091D\u0942\u092E \u0915\u0940\u092C\u094B\u0930\u094D\u0921 \u0936\u0949\u0930\u094D\u091F\u0915\u091F \u0935\u093E\u092A\u0930\u0924\u0947, \u091C\u0947 \u092C\u0902\u0926 \u0906\u0939\u0947\u0924. \u0905\u200D\u0945\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C\u092E\u0927\u094D\u092F\u0947 \u201CUse keyboard shortcuts to zoom\u201D \u091A\u093E\u0932\u0942 \u0915\u0930\u093E \u0906\u0923\u093F \u0928\u0902\u0924\u0930 \u092A\u0941\u0928\u094D\u0939\u093E \u092A\u094D\u0930\u092F\u0924\u094D\u0928 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u06CC\u06AF\u0646\u06CC\u0641\u0627\u0626\u0631 macOS \u06A9\u06D2 Zoom \u06A9\u06CC \u0628\u0648\u0631\u0688 \u0634\u0627\u0631\u0679 \u06A9\u0679\u0633 \u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u06A9\u0631\u062A\u0627 \u06C1\u06D2\u060C \u062C\u0648 \u0628\u0646\u062F \u06C1\u06CC\u06BA\u06D4 Accessibility \u06A9\u06CC \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u0645\u06CC\u06BA \u0022Use keyboard shortcuts to zoom\u0022 \u06A9\u0648 \u0622\u0646 \u06A9\u0631\u06CC\u06BA\u060C \u067E\u06BE\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00EDnh l\u00FAp s\u1EED d\u1EE5ng ph\u00EDm t\u1EAFt Thu ph\u00F3ng c\u1EE7a macOS, hi\u1EC7n \u0111ang b\u1ECB t\u1EAFt. B\u1EADt \u201CS\u1EED d\u1EE5ng ph\u00EDm t\u1EAFt \u0111\u1EC3 thu ph\u00F3ng\u201D trong c\u00E0i \u0111\u1EB7t Tr\u1EE3 n\u0103ng, r\u1ED3i th\u1EED l\u1EA1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u653E\u5927\u955C\u4F7F\u7528 macOS\u201C\u7F29\u653E\u201D\u952E\u76D8\u5FEB\u6377\u952E\uFF0C\u4F46\u8FD9\u4E9B\u5FEB\u6377\u952E\u5DF2\u5173\u95ED\u3002\u8BF7\u5728\u201C\u8F85\u52A9\u529F\u80FD\u201D\u8BBE\u7F6E\u4E2D\u6253\u5F00\u201C\u4F7F\u7528\u952E\u76D8\u5FEB\u6377\u952E\u6765\u7F29\u653E\u201D\uFF0C\u7136\u540E\u91CD\u8BD5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u653E\u5927\u93E1\u4F7F\u7528 macOS \u7684\u300C\u7E2E\u653E\u300D\u9375\u76E4\u5FEB\u901F\u9375\uFF0C\u4F46\u9019\u4E9B\u5FEB\u901F\u9375\u5DF2\u95DC\u9589\u3002\u8ACB\u5728\u300C\u8F14\u52A9\u4F7F\u7528\u300D\u8A2D\u5B9A\u4E2D\u958B\u555F\u300C\u4F7F\u7528\u9375\u76E4\u5FEB\u901F\u9375\u4F86\u7E2E\u653E\u300D\uFF0C\u7136\u5F8C\u518D\u8A66\u4E00\u6B21\u3002"
          }
        }
      }
    },
    "MorphicForMacOSLabel": {
      "comment": "[loc-id:0de5bf5c6aadb7fa] App-name line in the About box. \u0022Morphic\u0022 is a product name and \u0022macOS\u0022 is Apple\u0027s OS name; do not translate either.",
      "extractionState": "manual",

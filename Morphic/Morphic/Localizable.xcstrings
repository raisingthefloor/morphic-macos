    "ContrastAutomationFailedMessage": {
      "comment": "[loc-id:bbeecdb44a5cb52f] Notification toast body shown when Morphic could not toggle Increase Contrast automatically, asking the user to do it in Accessibility settings. \u0022Morphic\u0022 is a product name; \u0022Increase Contrast\u0022 is the macOS Accessibility setting (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic couldn\u2019t switch Increase Contrast automatically. Open Accessibility settings to toggle it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic konnte \u201EKontrast erh\u00F6hen\u201C nicht automatisch umschalten. \u00D6ffnen Sie die Bedienungshilfen-Einstellungen, um die Option umzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic no pudo cambiar Aumentar contraste autom\u00E1ticamente. Abre los ajustes de Accesibilidad para activarlo o desactivarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0639\u0630\u0651\u0631 \u0639\u0644\u0649 Morphic \u062A\u0628\u062F\u064A\u0644 \u00AB\u0632\u064A\u0627\u062F\u0629 \u0627\u0644\u062A\u0628\u0627\u064A\u0646\u00BB \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627. \u0627\u0641\u062A\u062D \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0644\u062A\u0628\u062F\u064A\u0644\u0647\u0627."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0646\u062A\u0648\u0627\u0646\u0633\u062A \u00AB\u0627\u0641\u0632\u0627\u06CC\u0634 \u06A9\u0646\u062A\u0631\u0627\u0633\u062A\u00BB \u0631\u0627 \u0628\u0647\u200C\u0637\u0648\u0631 \u062E\u0648\u062F\u06A9\u0627\u0631 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F. \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0627 \u0628\u0627\u0632 \u06A9\u0646\u06CC\u062F \u062A\u0627 \u0622\u0646 \u0631\u0627 \u0631\u0648\u0634\u0646/\u062E\u0627\u0645\u0648\u0634 \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0A86\u0AAA\u0AAE\u0AC7\u0AB3\u0AC7 Increase Contrast \u0AAC\u0AA6\u0AB2\u0AC0 \u0AB6\u0A95\u0ACD\u0AAF\u0AC1\u0A82 \u0AA8\u0AA5\u0AC0. \u0AA4\u0AC7\u0AA8\u0AC7 \u0A9F\u0AC9\u0A97\u0AB2 \u0A95\u0AB0\u0AB5\u0ABE \u0AAE\u0ABE\u0A9F\u0AC7 \u0A8D\u0A95\u0ACD\u0AB8\u0AC7\u0AB8\u0ABF\u0AAC\u0ABF\u0AB2\u0ABF\u0A9F\u0AC0 \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8 \u0A96\u0ACB\u0AB2\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0938\u094D\u0935\u091A\u093E\u0932\u093F\u0924 \u0930\u0942\u092A \u0938\u0947 \u0915\u0902\u091F\u094D\u0930\u093E\u0938\u094D\u091F \u092C\u0922\u093C\u093E\u090F\u0901 \u0915\u094B \u0928\u0939\u0940\u0902 \u092C\u0926\u0932 \u0938\u0915\u093E\u0964 \u0907\u0938\u0947 \u091F\u0949\u0917\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u090F\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u0916\u094B\u0932\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic\uC774 \uB300\uBE44 \uC99D\uAC00\uB97C \uC790\uB3D9\uC73C\uB85C \uC804\uD658\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC190\uC26C\uC6B4 \uC0AC\uC6A9 \uC124\uC815\uC744 \uC5F4\uC5B4 \uCF1C\uAC70\uB098 \uB044\uC2ED\uC2DC\uC624."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0938\u094D\u0935\u092F\u0902\u091A\u0932\u093F\u0924\u092A\u0923\u0947 Increase Contrast \u0938\u094D\u0935\u093F\u091A \u0915\u0930\u0942 \u0936\u0915\u0932\u0947 \u0928\u093E\u0939\u0940. \u0924\u0947 \u091F\u0949\u0917\u0932 \u0915\u0930\u0923\u094D\u092F\u093E\u0938\u093E\u0920\u0940 \u0905\u200D\u0945\u0915\u094D\u0938\u0947\u0938\u093F\u092C\u093F\u0932\u093F\u091F\u0940 \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u091C \u0909\u0918\u0921\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u062E\u0648\u062F\u06A9\u0627\u0631 \u0637\u0648\u0631 \u067E\u0631 Increase Contrast \u06A9\u0648 \u062A\u0628\u062F\u06CC\u0644 \u0646\u06C1\u06CC\u06BA \u06A9\u0631 \u0633\u06A9\u0627\u06D4 \u0627\u0633\u06D2 \u0622\u0646 \u06CC\u0627 \u0622\u0641 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Accessibility \u062A\u0631\u062A\u06CC\u0628\u0627\u062A \u06A9\u06BE\u0648\u0644\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic kh\u00F4ng th\u1EC3 t\u1EF1 \u0111\u1ED9ng chuy\u1EC3n \u0111\u1ED5i T\u0103ng \u0111\u1ED9 t\u01B0\u01A1ng ph\u1EA3n. H\u00E3y m\u1EDF c\u00E0i \u0111\u1EB7t Tr\u1EE3 n\u0103ng \u0111\u1EC3 b\u1EADt/t\u1EAFt t\u00EDnh n\u0103ng n\u00E0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u65E0\u6CD5\u81EA\u52A8\u5207\u6362\u201C\u589E\u52A0\u5BF9\u6BD4\u5EA6\u201D\u3002\u8BF7\u6253\u5F00\u201C\u8F85\u52A9\u529F\u80FD\u201D\u8BBE\u7F6E\u8FDB\u884C\u5207\u6362\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u7121\u6CD5\u81EA\u52D5\u5207\u63DB\u300C\u589E\u52A0\u5C0D\u6BD4\u300D\u3002\u8ACB\u958B\u555F\u300C\u8F14\u52A9\u4F7F\u7528\u300D\u8A2D\u5B9A\u9032\u884C\u5207\u63DB\u3002"
          }
        }
      }
    },

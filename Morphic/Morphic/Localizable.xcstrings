          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0AAA\u0AB8\u0A82\u0AA6 \u0A95\u0AB0\u0AC7\u0AB2 \u0A9F\u0AC7\u0A95\u0ACD\u0AB8\u0ACD\u0A9F \u0AB5\u0ABE\u0A82\u0A9A\u0ACB"

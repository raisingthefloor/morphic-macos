    "ScreenRecordingGrantedRestartMessage": {
      "comment": "[loc-id:087e4f04ab021ac4] Notification toast body shown after the user grants Screen Recording permission, telling them to restart Morphic for it to take effect. \u0022Morphic\u0022 is a product name; \u0022Screen Recording\u0022 is the macOS privacy permission name (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung f\u00FCr Bildschirmaufnahme wurde erteilt. Starten Sie Morphic neu, damit die \u00C4nderung wirksam wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedi\u00F3 el permiso de Grabaci\u00F3n de pantalla. Reinicia Morphic para que el cambio surta efecto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u0645 \u0645\u0646\u062D \u0625\u0630\u0646 \u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0634\u0627\u0634\u0629. \u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 Morphic \u0644\u062A\u0637\u0628\u064A\u0642 \u0627\u0644\u062A\u063A\u064A\u064A\u0631."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062F\u0633\u062A\u0631\u0633\u06CC \u00AB\u0636\u0628\u0637 \u0635\u0641\u062D\u0647\u00BB \u062F\u0627\u062F\u0647 \u0634\u062F. \u0628\u0631\u0627\u06CC \u0627\u0639\u0645\u0627\u0644 \u062A\u063A\u06CC\u06CC\u0631\u060C Morphic \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0631\u0627\u0647\u200C\u0627\u0646\u062F\u0627\u0632\u06CC \u06A9\u0646\u06CC\u062F."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0AB8\u0ACD\u0A95\u0ACD\u0AB0\u0AC0\u0AA8 \u0AB0\u0AC7\u0A95\u0ACB\u0AB0\u0ACD\u0AA1\u0ABF\u0A82\u0A97\u0AA8\u0AC0 \u0AAA\u0AB0\u0AB5\u0ABE\u0AA8\u0A97\u0AC0 \u0AAE\u0AB3\u0AC0 \u0A97\u0A88 \u0A9B\u0AC7. \u0AAB\u0AC7\u0AB0\u0AAB\u0ABE\u0AB0 \u0A85\u0AB8\u0AB0\u0A95\u0ABE\u0AB0\u0A95 \u0AA5\u0AB5\u0ABE \u0AAE\u0ABE\u0A9F\u0AC7 Morphic \u0AAB\u0AB0\u0AC0 \u0AB6\u0AB0\u0AC2 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0915\u094D\u0930\u0940\u0928 \u0930\u093F\u0915\u0949\u0930\u094D\u0921\u093F\u0902\u0917 \u0915\u0940 \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u0947 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964 \u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928 \u0932\u093E\u0917\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F Morphic \u0915\u094B \u092A\u0941\u0928\u0930\u093E\u0930\u0902\u092D \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uD654\uBA74 \uAE30\uB85D\uC774 \uD5C8\uC6A9\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBCC0\uACBD \uC0AC\uD56D\uC744 \uC801\uC6A9\uD558\uB824\uBA74 Morphic\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u092E\u0902\u091C\u0942\u0930 \u091D\u093E\u0932\u0947. \u092C\u0926\u0932 \u0932\u093E\u0917\u0942 \u0939\u094B\u0923\u094D\u092F\u093E\u0938\u093E\u0920\u0940 Morphic \u092A\u0941\u0928\u094D\u0939\u093E \u0938\u0941\u0930\u0942 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u06A9\u06CC \u0627\u062C\u0627\u0632\u062A \u062F\u06D2 \u062F\u06CC \u06AF\u0626\u06CC\u06D4 \u062A\u0628\u062F\u06CC\u0644\u06CC \u06A9\u06D2 \u0646\u0627\u0641\u0630 \u06C1\u0648\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00E3 c\u1EA5p quy\u1EC1n Ghi m\u00E0n h\u00ECnh. H\u00E3y kh\u1EDFi \u0111\u1ED9ng l\u1EA1i Morphic \u0111\u1EC3 thay \u0111\u1ED5i c\u00F3 hi\u1EC7u l\u1EF1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5DF2\u6388\u4E88\u201C\u5C4F\u5E55\u5F55\u5236\u201D\u6743\u9650\u3002\u8BF7\u91CD\u65B0\u542F\u52A8 Morphic \u4EE5\u4F7F\u66F4\u6539\u751F\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5DF2\u6388\u4E88\u300C\u87A2\u5E55\u9304\u88FD\u300D\u6B0A\u9650\u3002\u8ACB\u91CD\u65B0\u555F\u52D5 Morphic \u8B93\u8B8A\u66F4\u751F\u6548\u3002"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00C8 stata concessa l\u2019autorizzazione per Registrazione schermo. Riavvia Morphic perch\u00E9 la modifica abbia effetto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05D4\u05D4\u05E8\u05E9\u05D0\u05D4 \u05F4\u05D4\u05E7\u05DC\u05D8\u05EA \u05DE\u05E1\u05DA\u05F4 \u05E0\u05D9\u05EA\u05E0\u05D4. \u05D9\u05E9 \u05DC\u05D4\u05E4\u05E2\u05D9\u05DC \u05DE\u05D7\u05D3\u05E9 \u05D0\u05EA Morphic \u05DB\u05D3\u05D9 \u05E9\u05D4\u05E9\u05D9\u05E0\u05D5\u05D9 \u05D9\u05D9\u05DB\u05E0\u05E1 \u05DC\u05EA\u05D5\u05E7\u05E3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753B\u9762\u53CE\u9332\u304C\u8A31\u53EF\u3055\u308C\u307E\u3057\u305F\u3002\u5909\u66F4\u3092\u6709\u52B9\u306B\u3059\u308B\u306B\u306F Morphic \u3092\u518D\u8D77\u52D5\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er givet tilladelse til Sk\u00E6rmoptagelse. Genstart Morphic, s\u00E5 \u00E6ndringen tr\u00E6der i kraft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u03A0\u03B1\u03C1\u03B1\u03C7\u03C9\u03C1\u03AE\u03B8\u03B7\u03BA\u03B5 \u03B7 \u03AC\u03B4\u03B5\u03B9\u03B1 \u00AB\u0395\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2\u00BB. \u0395\u03C0\u03B1\u03BD\u03B5\u03BA\u03BA\u03B9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF Morphic \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03C3\u03C4\u03B5\u03AF \u03B7 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AE."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00E4yt\u00F6n tallennus on sallittu. K\u00E4ynnist\u00E4 Morphic uudelleen, jotta muutos tulee voimaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u2019autorisation Enregistrement de l\u2019\u00E9cran a \u00E9t\u00E9 accord\u00E9e. Red\u00E9marrez Morphic pour appliquer la modification."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u0027autorisation Enregistrement de l\u0027\u00E9cran a \u00E9t\u00E9 accord\u00E9e. Red\u00E9marrez Morphic pour que le changement prenne effet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznano uprawnienie Nagrywanie ekranu. Uruchom ponownie Morphic, aby zmiana zacz\u0119\u0142a obowi\u0105zywa\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permiss\u00E3o de Grava\u00E7\u00E3o da Tela foi concedida. Reinicie o Morphic para que a altera\u00E7\u00E3o entre em vigor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A permiss\u00E3o de Grava\u00E7\u00E3o de Ecr\u00E3 foi concedida. Reinicie o Morphic para que a altera\u00E7\u00E3o entre em vigor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sk\u00E4rminspelning har beviljats. Starta om Morphic f\u00F6r att \u00E4ndringen ska b\u00F6rja g\u00E4lla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekraanisalvestus on lubatud. Muudatuse j\u00F5ustumiseks taask\u00E4ivita Morphic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermopname is toegestaan. Start Morphic opnieuw op om de wijziging door te voeren."
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u06A9\u06CC \u0627\u062C\u0627\u0632\u062A \u0645\u0644 \u06AF\u0626\u06CC\u06D4 \u062A\u0628\u062F\u06CC\u0644\u06CC \u0644\u0627\u06AF\u0648 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u06A9\u06CC \u0627\u062C\u0627\u0632\u062A \u062F\u06D2 \u062F\u06CC \u06AF\u0626\u06CC\u06D4 \u062A\u0628\u062F\u06CC\u0644\u06CC \u0645\u0624\u062B\u0631 \u06A9\u0631\u0646\u06D2 \u06A9\u06D2 \u0644\u06CC\u06D2 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Skermopname is toegestaan. Herbegin Morphic sodat die verandering in werking tree."
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u1270\u1348\u1245\u12F7\u120D\u1362 \u1208\u12CD\u1321 \u1270\u130D\u1263\u122B\u12CA \u12A5\u1295\u12F2\u1206\u1295 Morphic\u1295 \u12A5\u1295\u12F0\u1308\u1293 \u12EB\u1235\u1300\u121D\u1229\u1362"
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u0985\u09A8\u09C1\u09AE\u09A4\u09BF \u09A6\u09BF\u09AF\u09BC\u09BE \u09B9\u09C8\u099B\u09C7\u0964 \u09AA\u09F0\u09BF\u09F1\u09F0\u09CD\u09A4\u09A8 \u0995\u09BE\u09F0\u09CD\u09AF\u0995\u09F0\u09C0 \u0995\u09F0\u09BF\u09AC\u09B2\u09C8 Morphic \u09AA\u09C1\u09A8\u09F0\u09BE\u09F0\u09AE\u09CD\u09AD \u0995\u09F0\u0995\u0964"
          }
        },
        "az-Latn-AZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Yaz\u0131s\u0131 icaz\u0259si verildi. D\u0259yi\u015Fikliyin q\u00FCvv\u0259y\u0259 minm\u0259si \u00FC\u00E7\u00FCn Morphic-i yenid\u0259n ba\u015Flad\u0131n."
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0430\u0437\u0432\u043E\u043B \u00AB\u0417\u0430\u043F\u0456\u0441 \u044D\u043A\u0440\u0430\u043D\u0430\u00BB \u043F\u0440\u0430\u0434\u0430\u0441\u0442\u0430\u045E\u043B\u0435\u043D\u044B. \u041F\u0435\u0440\u0430\u0437\u0430\u043F\u0443\u0441\u0446\u0456\u0446\u0435 Morphic, \u043A\u0430\u0431 \u0437\u043C\u0435\u043D\u044B \u045E\u0441\u0442\u0443\u043F\u0456\u043B\u0456 \u045E \u0441\u0456\u043B\u0443."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u0442\u043E \u0437\u0430 \u201E\u0417\u0430\u043F\u0438\u0441 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0430\u201C \u0435 \u0434\u0430\u0434\u0435\u043D\u043E. \u0420\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0439\u0442\u0435 Morphic, \u0437\u0430 \u0434\u0430 \u0432\u043B\u0435\u0437\u0435 \u043F\u0440\u043E\u043C\u044F\u043D\u0430\u0442\u0430 \u0432 \u0441\u0438\u043B\u0430."
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u09AE\u099E\u09CD\u099C\u09C1\u09B0 \u0995\u09B0\u09BE \u09B9\u09AF\u09BC\u09C7\u099B\u09C7\u0964 \u09AA\u09B0\u09BF\u09AC\u09B0\u09CD\u09A4\u09A8 \u0995\u09BE\u09B0\u09CD\u09AF\u0995\u09B0 \u0995\u09B0\u09A4\u09C7 Morphic \u09AA\u09C1\u09A8\u09B0\u09BE\u09AF\u09BC \u099A\u09BE\u09B2\u09C1 \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "ca-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0027ha concedit el perm\u00EDs d\u0027enregistrament de la pantalla. Reinicieu el Morphic perqu\u00E8 el canvi tingui efecte."
          }
        },
        "eu-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila grabatzeko baimena eman da. Berrabiarazi Morphic aldaketak eragina izan dezan."
          }
        },
        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0537\u056F\u0580\u0561\u0576\u056B \u0571\u0561\u0575\u0576\u0561\u0563\u0580\u0578\u0582\u0574\u0568 \u0569\u0578\u0582\u0575\u056C\u0561\u057F\u0580\u057E\u0565\u0581\u0589 \u054E\u0565\u0580\u0561\u0563\u0578\u0580\u056E\u0561\u0580\u056F\u0565\u0584 Morphic-\u0568\u055D \u0583\u0578\u0583\u0578\u056D\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576 \u0578\u0582\u056A\u056B \u0574\u0565\u057B \u0574\u057F\u0576\u0565\u056C\u0578\u0582 \u0570\u0561\u0574\u0561\u0580\u0589"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording-\u098F\u09B0 \u0985\u09A8\u09C1\u09AE\u09A4\u09BF \u09A6\u09C7\u0993\u09DF\u09BE \u09B9\u09DF\u09C7\u099B\u09C7\u0964 \u09AA\u09B0\u09BF\u09AC\u09B0\u09CD\u09A4\u09A8\u099F\u09BF \u0995\u09BE\u09B0\u09CD\u09AF\u0995\u09B0 \u0995\u09B0\u09BE\u09B0 \u099C\u09A8\u09CD\u09AF Morphic \u09B0\u09BF\u09B8\u09CD\u099F\u09BE\u09B0\u09CD\u099F \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje ekrana je odobreno. Ponovo pokrenite Morphic da bi promjena stupila na snagu."
          }
        },
        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Opr\u00E1vn\u011Bn\u00ED Z\u00E1znam obrazovky bylo ud\u011Bleno. Aby se zm\u011Bna projevila, restartujte Morphic."
          }
        },
        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u0780\u07AA\u0787\u07B0\u078B\u07A6 \u078B\u07AC\u0788\u07A8\u0787\u07B0\u0796\u07AC. \u0784\u07A6\u078B\u07A6\u078D\u07AA \u0787\u07A6\u0789\u07A6\u078D\u07AA\u0786\u07AA\u0783\u07AA\u0789\u07A6\u0781\u07B0 Morphic \u0787\u07A6\u078D\u07AA\u0782\u07B0 \u078A\u07A6\u0781\u07A7."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Naibigay na ang pahintulot sa Screen Recording. I-restart ang Morphic para magkabisa ang pagbabago."
          }
        },
        "gl-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedeuse a Gravaci\u00F3n da pantalla. Reinicia Morphic para que o cambio te\u00F1a efecto."
          }
        },
        "hr-HR": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje zaslona je odobreno. Ponovno pokrenite Morphic da bi promjena stupila na snagu."
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u10D4\u10D9\u10E0\u10D0\u10DC\u10D8\u10E1 \u10E9\u10D0\u10EC\u10D4\u10E0\u10D8\u10E1\u201C \u10DC\u10D4\u10D1\u10D0\u10E0\u10D7\u10D5\u10D0 \u10DB\u10D8\u10DC\u10D8\u10ED\u10D4\u10D1\u10E3\u10DA\u10D8\u10D0. \u10EA\u10D5\u10DA\u10D8\u10DA\u10D4\u10D1\u10D8\u10E1 \u10D0\u10E1\u10D0\u10DB\u10DD\u10E5\u10DB\u10D4\u10D3\u10D4\u10D1\u10DA\u10D0\u10D3 \u10D2\u10D0\u10D3\u10D0\u10E2\u10D5\u10D8\u10E0\u10D7\u10D4\u10D7 Morphic."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording was granted. Restart Morphic for the change to take effect."
          }
        },
        "ga-IE": {
          "stringUnit": {
            "state": "translated",
            "value": "Deona\u00EDodh Taifeadadh Sc\u00E1ile\u00E1in. Atosaigh Morphic chun go dtiocfaidh an t-athr\u00FA i bhfeidhm."
          }
        },
        "hu-HU": {
          "stringUnit": {
            "state": "translated",
            "value": "A K\u00E9perny\u0151felv\u00E9tel enged\u00E9lyezve lett. Ind\u00EDtsa \u00FAjra a Morphic alkalmaz\u00E1st, hogy a m\u00F3dos\u00EDt\u00E1s \u00E9rv\u00E9nybe l\u00E9pjen."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman Layar telah diizinkan. Mulai ulang Morphic agar perubahan diterapkan."
          }
        },
        "is-IS": {
          "stringUnit": {
            "state": "translated",
            "value": "Skj\u00E1upptaka var leyf\u00F0. Endurr\u00E6stu Morphic til a\u00F0 breytingin taki gildi."
          }
        },
        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u042D\u043A\u0440\u0430\u043D\u0434\u044B \u0436\u0430\u0437\u0443\u00BB \u0440\u04B1\u049B\u0441\u0430\u0442\u044B \u0431\u0435\u0440\u0456\u043B\u0434\u0456. \u04E8\u0437\u0433\u0435\u0440\u0456\u0441\u0442\u0456\u04A3 \u043A\u04AF\u0448\u0456\u043D\u0435 \u0435\u043D\u0443\u0456 \u04AF\u0448\u0456\u043D Morphic \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0441\u044B\u043D \u049B\u0430\u0439\u0442\u0430 \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u1794\u17B6\u1793\u1795\u17D2\u178A\u179B\u17CB\u179F\u17B7\u1791\u17D2\u1792\u17B7 Screen Recording\u17D4 \u1785\u17B6\u1794\u17CB\u1795\u17D2\u178A\u17BE\u1798 Morphic \u17A1\u17BE\u1784\u179C\u17B7\u1789 \u178A\u17BE\u1798\u17D2\u1794\u17B8\u17B1\u17D2\u1799\u1780\u17B6\u179A\u1795\u17D2\u179B\u17B6\u179F\u17CB\u1794\u17D2\u178A\u17BC\u179A\u1798\u17B6\u1793\u1794\u17D2\u179A\u179F\u17B7\u1791\u17D2\u1792\u1797\u17B6\u1796\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u092A\u0930\u0935\u093E\u0928\u0917\u0940 \u0926\u093F\u0932\u0940. \u092C\u0926\u0932 \u0932\u093E\u0917\u0942 \u091C\u093E\u0935\u092A\u093E\u0915 Morphic \u092A\u0930\u0924 \u0938\u0941\u0930\u0942 \u0915\u0930\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrano \u012Fra\u0161ymo leidimas suteiktas. Paleiskite \u201EMorphic\u201C i\u0161 naujo, kad pakeitimas \u012Fsigaliot\u0173."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekr\u0101na ierakst\u012B\u0161anas at\u013Cauja ir pie\u0161\u0137irta. Restart\u0113jiet Morphic, lai izmai\u0146as st\u0101tos sp\u0113k\u0101."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0CB8\u0CCD\u0C95\u0CCD\u0CB0\u0CC0\u0CA8\u0CCD \u0CB0\u0CC6\u0C95\u0CBE\u0CB0\u0CCD\u0CA1\u0CBF\u0C82\u0C97\u0CCD\u200C\u0C97\u0CC6 \u0C85\u0CA8\u0CC1\u0CAE\u0CA4\u0CBF \u0CA8\u0CC0\u0CA1\u0CB2\u0CBE\u0C97\u0CBF\u0CA6\u0CC6. \u0CAC\u0CA6\u0CB2\u0CBE\u0CB5\u0CA3\u0CC6\u0CAF\u0CC1 \u0C9C\u0CBE\u0CB0\u0CBF\u0C97\u0CC6 \u0CAC\u0CB0\u0CB2\u0CC1 Morphic \u0C85\u0CA8\u0CCD\u0CA8\u0CC1 \u0CAE\u0CB0\u0CC1\u0CAA\u0CCD\u0CB0\u0CBE\u0CB0\u0C82\u0CAD\u0CBF\u0CB8\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043D\u0438\u043C\u0430\u045A\u0435\u0442\u043E \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u043E\u0442 \u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u043E. \u0420\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0458\u0442\u0435 \u0433\u043E Morphic \u0437\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0430\u0442\u0430 \u0434\u0430 \u0441\u0442\u0430\u043F\u0438 \u043D\u0430 \u0441\u0438\u043B\u0430."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0D38\u0D4D\u200C\u0D15\u0D4D\u0D30\u0D40\u0D7B \u0D31\u0D46\u0D15\u0D4D\u0D15\u0D4B\u0D7C\u0D21\u0D3F\u0D02\u0D17\u0D4D \u0D05\u0D28\u0D41\u0D35\u0D26\u0D3F\u0D1A\u0D4D\u0D1A\u0D41. \u0D2E\u0D3E\u0D31\u0D4D\u0D31\u0D02 \u0D2A\u0D4D\u0D30\u0D3E\u0D2C\u0D32\u0D4D\u0D2F\u0D24\u0D4D\u0D24\u0D3F\u0D7D \u0D35\u0D30\u0D41\u0D28\u0D4D\u0D28\u0D24\u0D3F\u0D28\u0D4D Morphic \u0D2A\u0D41\u0D28\u0D30\u0D3E\u0D30\u0D02\u0D2D\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u044D\u043B\u0433\u044D\u0446\u0438\u0439\u043D \u0431\u0438\u0447\u043B\u044D\u0433 \u0445\u0438\u0439\u0445 \u0437\u04E9\u0432\u0448\u04E9\u04E9\u0440\u04E9\u043B \u043E\u043B\u0433\u043E\u0433\u0434\u043B\u043E\u043E. \u04E8\u04E9\u0440\u0447\u043B\u04E9\u043B\u0442 \u0445\u04AF\u0447\u0438\u043D \u0442\u04E9\u0433\u04E9\u043B\u0434\u04E9\u0440 \u0431\u043E\u043B\u043E\u0445\u044B\u043D \u0442\u0443\u043B\u0434 Morphic-\u0438\u0439\u0433 \u0434\u0430\u0445\u0438\u043D \u044D\u0445\u043B\u04AF\u04AF\u043B\u043D\u044D \u04AF\u04AF."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman Skrin telah dibenarkan. Mulakan semula Morphic agar perubahan berkuat kuasa."
          }
        },
        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-permess g\u0127al Screen Recording ing\u0127ata. Er\u0121a\u0027 ibda Morphic biex il-bidla tid\u0127ol fis-se\u0127\u0127."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermopptak ble innvilget. Start Morphic p\u00E5 nytt for at endringen skal tre i kraft."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u0915\u094B \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u093F\u0907\u092F\u094B\u0964 \u092A\u0930\u093F\u0935\u0930\u094D\u0924\u0928 \u0932\u093E\u0917\u0942 \u0917\u0930\u094D\u0928 Morphic \u092A\u0941\u0928: \u0938\u0941\u0930\u0941 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u0B05\u0B28\u0B41\u0B2E\u0B24\u0B3F \u0B26\u0B3F\u0B06\u0B17\u0B32\u0B3E\u0964 \u0B2A\u0B30\u0B3F\u0B2C\u0B30\u0B4D\u0B24\u0B4D\u0B24\u0B28 \u0B15\u0B3E\u0B30\u0B4D\u0B2F\u0B4D\u0B5F\u0B15\u0B3E\u0B30\u0B40 \u0B15\u0B30\u0B3F\u0B2C\u0B3E\u0B15\u0B41 Morphic \u0B2A\u0B41\u0B28\u0B03\u0B06\u0B30\u0B2E\u0B4D\u0B2D \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41\u0964"
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062F Screen Recording \u0627\u062C\u0627\u0632\u0647 \u0648\u0631\u06A9\u0693\u0644 \u0634\u0648\u0647. \u062F \u0628\u062F\u0644\u0648\u0646 \u062F \u067E\u0644\u064A \u06A9\u06CC\u062F\u0648 \u0644\u067E\u0627\u0631\u0647 Morphic \u0628\u06CC\u0627 \u067E\u06CC\u0644 \u06A9\u0693\u0626."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedi\u00F3 el permiso de Grabaci\u00F3n de pantalla. Reinici\u00E1 Morphic para que el cambio se aplique."
          }
        },
        "es-BO": {
          "stringUnit": {
            "state": "translated",
            "value": "Se concedi\u00F3 el permiso de Grabaci\u00F3n de pantalla. Reinicie Morphic para que el cambio surta efecto."
          }
        },
        "gd-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaidh Cl\u00E0radh-sgr\u00ECn a cheadachadh. Ath-th\u00F2isich Morphic gus an tig an t-atharrachadh an gn\u00EComh."
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0A38\u0A15\u0A4D\u0A30\u0A40\u0A28 \u0A30\u0A3F\u0A15\u0A3E\u0A30\u0A21\u0A3F\u0A70\u0A17 \u0A26\u0A40 \u0A07\u0A1C\u0A3E\u0A1C\u0A3C\u0A24 \u0A26\u0A3F\u0A71\u0A24\u0A40 \u0A17\u0A08\u0964 \u0A24\u0A2C\u0A26\u0A40\u0A32\u0A40 \u0A32\u0A3E\u0A17\u0A42 \u0A15\u0A30\u0A28 \u0A32\u0A08 Morphic \u0A28\u0A42\u0A70 \u0A2E\u0A41\u0A5C \u0A1A\u0A3E\u0A32\u0A42 \u0A15\u0A30\u0A4B\u0964"
          }
        },
        "ro-RO": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisiunea \u00CEnregistrare ecran a fost acordat\u0103. Reporni\u021Bi Morphic pentru ca modificarea s\u0103 aib\u0103 efect."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043E\u0441\u0442\u0443\u043F \u043A \u00AB\u0417\u0430\u043F\u0438\u0441\u0438 \u044D\u043A\u0440\u0430\u043D\u0430\u00BB \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D. \u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 Morphic, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0432\u0441\u0442\u0443\u043F\u0438\u043B\u043E \u0432 \u0441\u0438\u043B\u0443."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u06AA\u0631\u064A\u0646 \u0631\u06AA\u0627\u0631\u068A\u0646\u06AF \u062C\u064A \u0627\u062C\u0627\u0632\u062A \u068F\u0646\u064A \u0648\u0626\u064A. \u062A\u0628\u062F\u064A\u0644\u064A \u06A9\u064A \u0644\u0627\u06B3\u0648 \u06AA\u0631\u06BB \u0644\u0627\u0621\u0650 Morphic \u067B\u064A\u0647\u0631 \u0634\u0631\u0648\u0639 \u06AA\u0631\u064A\u0648."
          }
        },
        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0DAD\u0DD2\u0DBB \u0DB4\u0DA7\u0DD2\u0D9C\u0DAD \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8 \u0DC3\u0DB3\u0DC4\u0DCF \u0D85\u0DC0\u0DC3\u0DBB \u0DAF\u0DD3 \u0D87\u0DAD. \u0DC0\u0DD9\u0DB1\u0DC3 \u0D9A\u0DCA\u200D\u0DBB\u0DD2\u0DBA\u0DCF\u0DAD\u0DCA\u0DB8\u0D9A \u0DC0\u0DD3\u0DB8\u0DA7 Morphic \u0DB1\u0DD0\u0DC0\u0DAD \u0D86\u0DBB\u0DB8\u0DCA\u0DB7 \u0D9A\u0DBB\u0DB1\u0DCA\u0DB1."
          }
        },
        "sk-SK": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahr\u00E1vanie obrazovky bolo povolen\u00E9. Re\u0161tartujte Morphic, aby sa zmena prejavila."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljenje za snemanje zaslona je bilo odobreno. Znova za\u017Eenite Morphic, da bo sprememba za\u010Dela veljati."
          }
        },
        "sr-Latn-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje ekrana je odobreno. Ponovo pokrenite Morphic da bi promena stupila na snagu."
          }
        },
        "cy-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhoddwyd caniat\u00E2d Recordio Sgrin. Ailgychwynnwch Morphic er mwyn i\u2019r newid ddod i rym."
          }
        },
        "sw-KE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusa ya Kurekodi Skrini imetolewa. Anzisha upya Morphic ili mabadiliko yaanze kutumika."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0BA4\u0BBF\u0BB0\u0BC8\u0BAA\u0BCD \u0BAA\u0BA4\u0BBF\u0BB5\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0B85\u0BA9\u0BC1\u0BAE\u0BA4\u0BBF \u0BB5\u0BB4\u0B99\u0BCD\u0B95\u0BAA\u0BCD\u0BAA\u0B9F\u0BCD\u0B9F\u0BA4\u0BC1. \u0BAE\u0BBE\u0BB1\u0BCD\u0BB1\u0BAE\u0BCD \u0B9A\u0BC6\u0BAF\u0BB2\u0BCD\u0BAA\u0B9F Morphic-\u0B90 \u0BAE\u0BB1\u0BC1\u0BA4\u0BCA\u0B9F\u0B95\u0BCD\u0B95\u0BAE\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
          }
        },
        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0E2D\u0E19\u0E38\u0E0D\u0E32\u0E15\u0E01\u0E32\u0E23\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E08\u0E2D\u0E41\u0E25\u0E49\u0E27 \u0E40\u0E23\u0E34\u0E48\u0E21 Morphic \u0E43\u0E2B\u0E21\u0E48\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E43\u0E2B\u0E49\u0E01\u0E32\u0E23\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E41\u0E1B\u0E25\u0E07\u0E21\u0E35\u0E1C\u0E25"
          }
        },
        "ti-ER": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording \u1270\u1348\u1252\u12F1 \u12A5\u12E9\u1362 \u12A5\u1272 \u1208\u12CD\u1322 \u1270\u130D\u1263\u122B\u12CA \u1295\u12BD\u12B8\u12CD\u1295\u1361 \u1295Morphic \u12A5\u1295\u12F0\u1308\u1293 \u1300\u121D\u122E\u1362"
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kayd\u0131 izni verildi. De\u011Fi\u015Fikli\u011Fin etkili olmas\u0131 i\u00E7in Morphic\u0027i yeniden ba\u015Flat\u0131n."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043E\u0437\u0432\u0456\u043B \u043D\u0430 \u0437\u0430\u043F\u0438\u0441 \u0435\u043A\u0440\u0430\u043D\u0430 \u043D\u0430\u0434\u0430\u043D\u043E. \u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0456\u0442\u044C Morphic, \u0449\u043E\u0431 \u0437\u043C\u0456\u043D\u0430 \u043D\u0430\u0431\u0443\u043B\u0430 \u0447\u0438\u043D\u043D\u043E\u0441\u0442\u0456."
          }
        },

    "SnipScreenRecordingRequiredMessage": {
      "comment": "[loc-id:278b18f84fe30f3f] Notification toast body shown when the Snip feature needs Screen Recording permission, telling the user to grant it and restart. \u0022Snip\u0022 is a Morphic feature; \u0022System Settings\u0022/\u0022Screen Recording\u0022 are macOS names (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00FCr \u201EAusschnitt\u201C ist die Bildschirmaufnahme erforderlich. Erteilen Sie die Berechtigung in den Systemeinstellungen und starten Sie Morphic neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorte requiere Grabaci\u00F3n de pantalla. Conc\u00E9dela en Ajustes del Sistema y reinicia Morphic."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u062A\u0637\u0644\u0628 \u0645\u064A\u0632\u0629 \u0627\u0644\u0627\u0642\u062A\u0637\u0627\u0639 \u0625\u0630\u0646 \u00AB\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0634\u0627\u0634\u0629\u00BB. \u0627\u0645\u0646\u062D\u0647 \u0641\u064A \u00AB\u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0646\u0638\u0627\u0645\u00BB\u060C \u062B\u0645 \u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 Morphic."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u0AA8\u0AC7 Screen Recording \u0A9C\u0AB0\u0AC2\u0AB0\u0AC0 \u0A9B\u0AC7. \u0AA4\u0AC7\u0AA8\u0AC7 System Settings \u0AAE\u0ABE\u0A82 \u0AAE\u0A82\u0A9C\u0AC2\u0AB0 \u0A95\u0AB0\u0ACB, \u0AAA\u0A9B\u0AC0 Morphic \u0AAB\u0AB0\u0AC0 \u0AB6\u0AB0\u0AC2 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A \u0915\u0947 \u0932\u093F\u090F \u0938\u094D\u0915\u094D\u0930\u0940\u0928 \u0930\u093F\u0915\u0949\u0930\u094D\u0921\u093F\u0902\u0917 \u0915\u0940 \u0906\u0935\u0936\u094D\u092F\u0915\u0924\u093E \u0939\u0948\u0964 \u0907\u0938\u0947 \u0938\u093F\u0938\u094D\u091F\u092E \u0938\u0947\u091F\u093F\u0902\u0917 \u092E\u0947\u0902 \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u0947\u0902, \u092B\u093F\u0930 Morphic \u0915\u094B \u092A\u0941\u0928\u0930\u093E\u0930\u0902\u092D \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uCEA1\uCC98\uC5D0\uB294 \uD654\uBA74 \uAE30\uB85D\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uC2DC\uC2A4\uD15C \uC124\uC815\uC5D0\uC11C \uD5C8\uC6A9\uD55C \uB2E4\uC74C Morphic\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A\u0938\u093E\u0920\u0940 Screen Recording \u0906\u0935\u0936\u094D\u092F\u0915 \u0906\u0939\u0947. System Settings \u092E\u0927\u094D\u092F\u0947 \u0924\u094D\u092F\u093E\u091A\u0940 \u092A\u0930\u0935\u093E\u0928\u0917\u0940 \u0926\u094D\u092F\u093E \u0906\u0923\u093F \u0928\u0902\u0924\u0930 Morphic \u0930\u0940\u0938\u094D\u091F\u093E\u0930\u094D\u091F \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u06A9\u06D2 \u0644\u06CC\u06D2 \u0627\u0633\u06A9\u0631\u06CC\u0646 \u0631\u06CC\u06A9\u0627\u0631\u0688\u0646\u06AF \u0636\u0631\u0648\u0631\u06CC \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 \u0633\u0633\u0679\u0645 \u0633\u06CC\u0679\u0646\u06AF\u0632 \u0645\u06CC\u06BA \u0627\u062C\u0627\u0632\u062A \u062F\u06CC\u06BA\u060C \u067E\u06BE\u0631 Morphic \u06A9\u0648 \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00EDnh n\u0103ng C\u1EAFt y\u00EAu c\u1EA7u quy\u1EC1n Ghi m\u00E0n h\u00ECnh. H\u00E3y c\u1EA5p quy\u1EC1n n\u00E0y trong C\u00E0i \u0111\u1EB7t h\u1EC7 th\u1ED1ng, sau \u0111\u00F3 kh\u1EDFi \u0111\u1ED9ng l\u1EA1i Morphic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u622A\u56FE\u9700\u8981\u201C\u5C4F\u5E55\u5F55\u5236\u201D\u6743\u9650\u3002\u8BF7\u5728\u201C\u7CFB\u7EDF\u8BBE\u7F6E\u201D\u4E2D\u6388\u4E88\u8BE5\u6743\u9650\uFF0C\u7136\u540E\u91CD\u542F Morphic\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300C\u526A\u53D6\u300D\u9700\u8981\u300C\u87A2\u5E55\u9304\u88FD\u300D\u6B0A\u9650\u3002\u8ACB\u5728\u300C\u7CFB\u7D71\u8A2D\u5B9A\u300D\u4E2D\u6388\u4E88\u8A72\u6B0A\u9650\uFF0C\u7136\u5F8C\u91CD\u65B0\u555F\u52D5 Morphic\u3002"
          }
        }
      }
    },

        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u053F\u0561\u0580\u0564\u0561\u056C \u0576\u0577\u057E\u0561\u056E\u0568\u00BB \u0563\u0578\u0580\u056E\u0561\u057C\u0578\u0582\u0575\u0569\u0568, \u0570\u0576\u0561\u0580\u0561\u057E\u0578\u0580 \u0567, \u057D\u056D\u0561\u056C \u057A\u0561\u057F\u0578\u0582\u0570\u0561\u0576\u056B\u0581 \u0567 \u056F\u0561\u0580\u0564\u0561\u0581\u0565\u056C\u0589 \u054D\u0565\u0572\u0574\u0565\u0584 \u0571\u0565\u0580 \u057F\u0565\u0584\u057D\u057F\u056B \u057E\u0580\u0561 \u0587 \u0576\u0578\u0580\u056B\u0581 \u0583\u0578\u0580\u0571\u0565\u0584\u0589"
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u06C1\u0648 \u0633\u06A9\u062A\u0627 \u06C1\u06D2 Read Selected \u0646\u06D2 \u063A\u0644\u0637 \u0648\u0646\u0688\u0648 \u067E\u0691\u06BE \u0644\u06CC \u06C1\u0648\u06D4 \u0627\u067E\u0646\u06D2 \u0679\u06CC\u06A9\u0633\u0679 \u067E\u0631 \u06A9\u0644\u06A9 \u06A9\u0631\u06CC\u06BA \u0627\u0648\u0631 \u062F\u0648\u0628\u0627\u0631\u06C1 \u06A9\u0648\u0634\u0634 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees Geselekteerde het dalk uit die verkeerde venster gelees. Klik in jou teks en probeer weer."
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u099A\u09DF\u09A8 \u0995\u09F0\u09BE \u09AA\u09BE\u09A0 \u09AA\u09DD\u09CB\u0981\u09A4\u09C7 \u09B9\u09DF\u09A4\u09CB \u09AD\u09C1\u09B2 \u0989\u0987\u09A3\u09CD\u09A1\u0027 \u09AA\u09DD\u09BE \u09B9\u09C8\u099B\u09C7\u0964 \u0986\u09AA\u09CB\u09A8\u09BE\u09F0 \u09AA\u09BE\u09A0\u09A4 \u0995\u09CD\u09B2\u09BF\u0995 \u0995\u09F0\u0995 \u0986\u09F0\u09C1 \u09AA\u09C1\u09A8\u09F0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09F0\u0995\u0964"
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u010Citaj odabrano je mo\u017Eda pro\u010Ditalo pogre\u0161an prozor. Kliknite u tekst i poku\u0161ajte ponovo."

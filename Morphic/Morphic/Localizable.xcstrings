        "chr-CHER-US": {
          "stringUnit": {
            "state": "translated",
            "value": "\u13AF\u13EF\u13C5\u13DB \u13AA\u13EA\u13B5 \u13A0\u13AA\u13E9\u13DB\u13D7 \u13C5\u13E9\u13D3\u13B4 \u13A6\u13DA\u13A2 \u13A4\u13AA\u13E9\u13DB\u13A2 \u13A8\u13D2\u13A2. \u13E3\u13E4\u13B5 \u13AA\u13EA\u13B5 \u13AD\u13D0\u13C5\u13CD\u13D3\u13CF, \u13D4\u13B5\u13C1 \u13AD\u13DF\u13B6\u13CD\u13D3."
          }
        },
        "lb-LU": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Virliese gouf m\u00E9iglecherweis d\u00E9i falsch F\u00EBnster gelies. Klickt an \u00C4ren Text a prob\u00E9iert et nach eng K\u00E9ier."
          }
        },
        "lo-LA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0EAD\u0EC8\u0EB2\u0E99\u0E97\u0EB5\u0EC8\u0EC0\u0EA5\u0EB7\u0EAD\u0E81\u0EAD\u0EB2\u0E94\u0E88\u0EB0\u0EAD\u0EC8\u0EB2\u0E99\u0EDC\u0EC9\u0EB2\u0E95\u0EC8\u0EB2\u0E87\u0E9C\u0EB4\u0E94. \u0E84\u0EA5\u0EB4\u0E81\u0EC3\u0EAA\u0EC8\u0E82\u0ECD\u0EC9\u0E84\u0EA7\u0EB2\u0EA1\u0E82\u0EAD\u0E87\u0E97\u0EC8\u0EB2\u0E99 \u0EC1\u0EA5\u0EC9\u0EA7\u0EA5\u0EAD\u0E87\u0EC3\u0EDD\u0EC8\u0EAD\u0EB5\u0E81\u0E84\u0EB1\u0EC9\u0E87."
          }
        },
        "mi-NZ": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u0113r\u0101 pea i p\u0101nuihia e P\u0101nui T\u012Bpako te matapihi h\u0113. P\u0101whiritia ki t\u014D kuputuhi, ka ngana an\u014D ai."
          }
        },
        "quz-PE": {
          "stringUnit": {
            "state": "translated",
            "value": "Akllasqa \u00D1awinchay ichapas pantasqa wintanamanta \u00F1awincharun. Qillqaykiman \u00F1it\u0027iykuy hinaspa kaqmanta ruway."
          }
        },
        "sq-AL": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201CLexo t\u00EB zgjedhurin\u201D mund t\u00EB ket\u00EB lexuar dritaren e gabuar. Klikoni te teksti juaj dhe provoni p\u00EBrs\u00EBri."
          }
        },
        "sr-Cyrl-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u0427\u0438\u0442\u0430\u0458 \u0438\u0437\u0430\u0431\u0440\u0430\u043D\u043E\u201C \u0458\u0435 \u043C\u043E\u0436\u0434\u0430 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u043E \u043F\u043E\u0433\u0440\u0435\u0448\u0430\u043D \u043F\u0440\u043E\u0437\u043E\u0440. \u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u0443 \u0441\u0432\u043E\u0458 \u0442\u0435\u043A\u0441\u0442 \u0438 \u043F\u043E\u043A\u0443\u0448\u0430\u0458\u0442\u0435 \u043F\u043E\u043D\u043E\u0432\u043E."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Selected \u0C24\u0C2A\u0C4D\u0C2A\u0C41 \u0C35\u0C3F\u0C02\u0C21\u0C4B\u0C28\u0C41 \u0C1A\u0C26\u0C3F\u0C35\u0C3F \u0C09\u0C02\u0C21\u0C35\u0C1A\u0C4D\u0C1A\u0C41. \u0C2E\u0C40 \u0C1F\u0C46\u0C15\u0C4D\u0C38\u0C4D\u0C1F\u0C4D\u200C\u0C2A\u0C48 \u0C15\u0C4D\u0C32\u0C3F\u0C15\u0C4D \u0C1A\u0C47\u0C38\u0C3F, \u0C2E\u0C33\u0C4D\u0C32\u0C40 \u0C2A\u0C4D\u0C30\u0C2F\u0C24\u0C4D\u0C28\u0C3F\u0C02\u0C1A\u0C02\u0C21\u0C3F."
          }
        },
        "sr-Cyrl-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0438\u0442\u0430\u045A\u0435 \u0438\u0437\u0430\u0431\u0440\u0430\u043D\u043E\u0433 \u0458\u0435 \u043C\u043E\u0436\u0434\u0430 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u043E \u0442\u0435\u043A\u0441\u0442 \u0438\u0437 \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u043E\u0433 \u043F\u0440\u043E\u0437\u043E\u0440\u0430. \u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u0443 \u0441\u0432\u043E\u0458 \u0442\u0435\u043A\u0441\u0442 \u0438 \u043F\u043E\u043A\u0443\u0448\u0430\u0458\u0442\u0435 \u043F\u043E\u043D\u043E\u0432\u043E."
          }
        },
        "tt-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0430\u0439\u043B\u0430\u043D\u0433\u0430\u043D\u043D\u044B \u0443\u043A\u0443 \u044F\u043B\u0433\u044B\u0448 \u0442\u04D9\u0440\u04D9\u0437\u04D9\u043D\u0435 \u0443\u043A\u044B\u0433\u0430\u043D \u0431\u0443\u043B\u044B\u0440\u0433\u0430 \u043C\u04E9\u043C\u043A\u0438\u043D. \u0422\u0435\u043A\u0441\u0442\u043A\u0430 \u0431\u0430\u0441\u044B\u0433\u044B\u0437 \u04BB\u04D9\u043C \u043A\u0430\u0431\u0430\u0442\u043B\u0430\u043F \u043A\u0430\u0440\u0430\u0433\u044B\u0437."

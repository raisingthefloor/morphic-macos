        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0648\u0646\u0647 \u0634\u0648 \u06A9\u0693\u0627\u06CC Increase Contrast \u067E\u0647 \u0627\u062A\u0648\u0645\u0627\u062A \u0689\u0648\u0644 \u0628\u062F\u0644 \u06A9\u0693\u064A. \u062F \u0628\u062F\u0644\u0648\u0644\u0648 \u0644\u067E\u0627\u0631\u0647 \u062F \u0644\u0627\u0633\u0631\u0633\u064A \u0627\u0645\u0633\u062A\u0646\u06D0 \u067E\u0631\u0627\u0646\u06CC\u0632\u0626."

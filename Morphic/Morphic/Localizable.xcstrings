        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Czytaj zaznaczone mog\u0142a odczyta\u0107 niew\u0142a\u015Bciwe okno. Kliknij tekst i spr\u00F3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

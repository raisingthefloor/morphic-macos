    "SnipScreenRecordingRequiredMessage": {
      "comment": "[loc-id:278b18f84fe30f3f] Notification toast body shown when the Snip feature needs Screen Recording permission, telling the user to grant it and restart. \u0022Snip\u0022 is a Morphic feature; \u0022System Settings\u0022/\u0022Screen Recording\u0022 are macOS names (match Apple\u0027s wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00FCr Ausschnitte ist die Berechtigung zur Bildschirmaufnahme erforderlich. Erteilen Sie diese in den Systemeinstellungen und starten Sie Morphic neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorte requiere Grabaci\u00F3n de pantalla. Concede el permiso en Configuraci\u00F3n del Sistema y reinicia Morphic."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062A\u062A\u0637\u0644\u0628 \u0645\u064A\u0632\u0629 \u0627\u0644\u0642\u0635\u0627\u0635\u0629 \u0625\u0630\u0646 \u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0634\u0627\u0634\u0629. \u0627\u0645\u0646\u062D \u0627\u0644\u0625\u0630\u0646 \u0641\u064A \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0646\u0638\u0627\u0645\u060C \u062B\u0645 \u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 Morphic."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0AB8\u0ACD\u0AA8\u0ABF\u0AAA \u0AAE\u0ABE\u0A9F\u0AC7 \u0AB8\u0ACD\u0A95\u0ACD\u0AB0\u0AC0\u0AA8 \u0AB0\u0AC7\u0A95\u0ACB\u0AB0\u0ACD\u0AA1\u0ABF\u0A82\u0A97 \u0A9C\u0AB0\u0AC2\u0AB0\u0AC0 \u0A9B\u0AC7. \u0AB8\u0ABF\u0AB8\u0ACD\u0A9F\u0AAE \u0AB8\u0AC7\u0A9F\u0ABF\u0A82\u0A97\u0ACD\u0AB8\u0AAE\u0ABE\u0A82 \u0AA4\u0AC7\u0AA8\u0AC0 \u0AAE\u0A82\u0A9C\u0AC2\u0AB0\u0AC0 \u0A86\u0AAA\u0ACB, \u0AAA\u0A9B\u0AC0 Morphic \u0AAB\u0AB0\u0AC0 \u0AB6\u0AB0\u0AC2 \u0A95\u0AB0\u0ACB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A \u0915\u0947 \u0932\u093F\u090F \u0938\u094D\u0915\u094D\u0930\u0940\u0928 \u0930\u093F\u0915\u0949\u0930\u094D\u0921\u093F\u0902\u0917 \u0915\u0940 \u0906\u0935\u0936\u094D\u092F\u0915\u0924\u093E \u0939\u0948\u0964 \u0907\u0938\u0947 \u0938\u093F\u0938\u094D\u091F\u092E \u0938\u0947\u091F\u093F\u0902\u0917\u094D\u0938 \u092E\u0947\u0902 \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u0947\u0902, \u092B\u093F\u0930 Morphic \u0915\u094B \u092A\u0941\u0928\u0930\u093E\u0930\u0902\u092D \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uCEA1\uCC98\uC5D0\uB294 \uD654\uBA74 \uAE30\uB85D \uAD8C\uD55C\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uC2DC\uC2A4\uD15C \uC124\uC815\uC5D0\uC11C \uAD8C\uD55C\uC744 \uBD80\uC5EC\uD55C \uD6C4 Morphic\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC138\uC694."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A\u0932\u093E Screen Recording \u0906\u0935\u0936\u094D\u092F\u0915 \u0906\u0939\u0947. \u0924\u0947 System Settings \u092E\u0927\u094D\u092F\u0947 \u092E\u0902\u091C\u0942\u0930 \u0915\u0930\u093E, \u0928\u0902\u0924\u0930 Morphic \u092A\u0941\u0928\u094D\u0939\u093E \u0938\u0941\u0930\u0942 \u0915\u0930\u093E."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u06A9\u06D2 \u0644\u06CC\u06D2 \u0627\u0633\u06A9\u0631\u06CC\u0646 \u0631\u06CC\u06A9\u0627\u0631\u0688\u0646\u06AF \u0636\u0631\u0648\u0631\u06CC \u06C1\u06D2\u06D4 \u0627\u0633\u06D2 \u0633\u0633\u0679\u0645 \u0633\u06CC\u0679\u0646\u06AF\u0632 \u0645\u06CC\u06BA \u0627\u062C\u0627\u0632\u062A \u062F\u06CC\u06BA\u060C \u067E\u06BE\u0631 Morphic \u06A9\u0648 \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00EDnh n\u0103ng C\u1EAFt y\u00EAu c\u1EA7u quy\u1EC1n Ghi m\u00E0n h\u00ECnh. H\u00E3y c\u1EA5p quy\u1EC1n n\u00E0y trong C\u00E0i \u0111\u1EB7t h\u1EC7 th\u1ED1ng, sau \u0111\u00F3 kh\u1EDFi \u0111\u1ED9ng l\u1EA1i Morphic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201C\u622A\u56FE\u201D\u9700\u8981\u201C\u5C4F\u5E55\u5F55\u5236\u201D\u6743\u9650\u3002\u8BF7\u5728\u201C\u7CFB\u7EDF\u8BBE\u7F6E\u201D\u4E2D\u6388\u4E88\u8BE5\u6743\u9650\uFF0C\u7136\u540E\u91CD\u542F Morphic\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526A\u53D6\u9700\u8981\u300C\u87A2\u5E55\u9304\u88FD\u300D\u6B0A\u9650\u3002\u8ACB\u5728\u300C\u7CFB\u7D71\u8A2D\u5B9A\u300D\u4E2D\u6388\u4E88\u6B0A\u9650\uFF0C\u7136\u5F8C\u91CD\u65B0\u555F\u52D5 Morphic\u3002"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0631\u0627\u06CC \u0628\u0631\u0634\u060C \u00AB\u0636\u0628\u0637 \u0635\u0641\u062D\u0647\u00BB \u0644\u0627\u0632\u0645 \u0627\u0633\u062A. \u0622\u0646 \u0631\u0627 \u062F\u0631 \u00AB\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0633\u06CC\u0633\u062A\u0645\u00BB \u0645\u062C\u0627\u0632 \u06A9\u0646\u06CC\u062F\u060C \u0633\u067E\u0633 Morphic \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0631\u0627\u0647\u200C\u0627\u0646\u062F\u0627\u0632\u06CC \u06A9\u0646\u06CC\u062F."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip richiede la Registrazione schermo. Concedila in Impostazioni di Sistema, quindi riavvia Morphic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05D7\u05D9\u05EA\u05D5\u05DA \u05D3\u05D5\u05E8\u05E9 \u05F4\u05D4\u05E7\u05DC\u05D8\u05EA \u05DE\u05E1\u05DA\u05F4. \u05D9\u05E9 \u05DC\u05D4\u05E2\u05E0\u05D9\u05E7 \u05D0\u05EA \u05D4\u05D4\u05E8\u05E9\u05D0\u05D4 \u05D1\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D4\u05DE\u05E2\u05E8\u05DB\u05EA, \u05D5\u05D0\u05D6 \u05DC\u05D4\u05E4\u05E2\u05D9\u05DC \u05DE\u05D7\u05D3\u05E9 \u05D0\u05EA Morphic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5207\u308A\u53D6\u308A\u306B\u306F\u753B\u9762\u53CE\u9332\u304C\u5FC5\u8981\u3067\u3059\u3002\u30B7\u30B9\u30C6\u30E0\u8A2D\u5B9A\u3067\u8A31\u53EF\u3057\u3066\u304B\u3089\u3001Morphic \u3092\u518D\u8D77\u52D5\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udklip kr\u00E6ver Sk\u00E6rmoptagelse. Giv adgang i Systemindstillinger, og genstart derefter Morphic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u03A4\u03BF \u0391\u03C0\u03CC\u03BA\u03BF\u03BC\u03BC\u03B1 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u00AB\u0395\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03BF\u03B8\u03CC\u03BD\u03B7\u03C2\u00BB. \u03A0\u03B1\u03C1\u03B1\u03C7\u03C9\u03C1\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7\u03BD \u03C3\u03C4\u03B9\u03C2 \u03A1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03BA\u03B1\u03B9, \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1, \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03BA\u03B9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF Morphic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00E4ytt\u00F6leike vaatii N\u00E4yt\u00F6n tallennus -luvan. My\u00F6nn\u00E4 se J\u00E4rjestelm\u00E4asetuksissa ja k\u00E4ynnist\u00E4 Morphic uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture n\u00E9cessite Enregistrement de l\u2019\u00E9cran. Accordez cette autorisation dans R\u00E9glages Syst\u00E8me, puis red\u00E9marrez Morphic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knippen vereist Schermopname. Sta dit toe in Systeeminstellingen en start Morphic daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Wycinek wymaga uprawnienia Nagrywanie ekranu. Przyznaj je w Ustawieniach systemowych, a nast\u0119pnie uruchom ponownie Morphic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso Capturar requer a permiss\u00E3o de Grava\u00E7\u00E3o da Tela. Conceda-a nos Ajustes do Sistema e reinicie o Morphic."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorte requer Grava\u00E7\u00E3o do ecr\u00E3. Conceda-a nas Defini\u00E7\u00F5es do Sistema e reinicie o Morphic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sk\u00E4rmklipp kr\u00E4ver Sk\u00E4rminspelning. Ge beh\u00F6righet i Systeminst\u00E4llningar och starta sedan om Morphic."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00E4ljal\u00F5ige n\u00F5uab ekraanisalvestust. Luba see s\u00FCsteemiseadetes ja taask\u00E4ivita Morphic."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip n\u00E9cessite l\u2019autorisation Enregistrement de l\u2019\u00E9cran. Accordez-la dans R\u00E9glages Syst\u00E8me, puis red\u00E9marrez Morphic."
          }
        },
        "ur-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u06A9\u06D2 \u0644\u06CC\u06D2 Screen Recording \u0686\u0627\u06C1\u06CC\u06D2\u06D4 \u0627\u0633\u06D2 System Settings \u0645\u06CC\u06BA \u0627\u062C\u0627\u0632\u062A \u062F\u06CC\u06BA\u060C \u067E\u06BE\u0631 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u0646\u067E \u06A9\u06D2 \u0644\u06CC\u06D2 Screen Recording \u062F\u0631\u06A9\u0627\u0631 \u06C1\u06D2\u06D4 \u0633\u0633\u0679\u0645 \u0633\u06CC\u0679\u0646\u06AF\u0632 \u0645\u06CC\u06BA \u0627\u062C\u0627\u0632\u062A \u062F\u06CC\u06BA\u060C \u067E\u06BE\u0631 Morphic \u062F\u0648\u0628\u0627\u0631\u06C1 \u0634\u0631\u0648\u0639 \u06A9\u0631\u06CC\u06BA\u06D4"
          }
        },
        "af-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Knip vereis Skermopname. Staan dit toe in Stelselinstellings, en herbegin dan Morphic."
          }
        },
        "am-ET": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip Screen Recording \u12EB\u1235\u1348\u120D\u1308\u12CB\u120D\u1362 \u1260System Settings \u12CD\u1235\u1325 \u134D\u1240\u12F5\u1208\u1275\u1363 \u12A8\u12DA\u12EB Morphic\u1295 \u12F3\u130D\u121D \u12A0\u1235\u1300\u121D\u122D\u1362"
          }
        },
        "as-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip-\u09F0 \u09AC\u09BE\u09AC\u09C7 Screen Recording \u09AA\u09CD\u09F0\u09AF\u09BC\u09CB\u099C\u09A8\u0964 System Settings-\u09A4 \u0985\u09A8\u09C1\u09AE\u09A4\u09BF \u09A6\u09BF\u09AF\u09BC\u0995, \u09A4\u09BE\u09F0\u09AA\u09BF\u099B\u09A4 Morphic \u09AA\u09C1\u09A8\u09F0\u09BE\u09F0\u09AE\u09CD\u09AD \u0995\u09F0\u0995\u0964"
          }
        },
        "az-Latn-AZ": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0259sm\u0259 \u00FC\u00E7\u00FCn Ekran qeydi t\u0259l\u0259b olunur. Sistem Parametrl\u0259rind\u0259 icaz\u0259 verin, sonra Morphic-i yenid\u0259n ba\u015Flad\u0131n."
          }
        },
        "bg-BG": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201E\u0418\u0437\u0440\u044F\u0437\u0432\u0430\u043D\u0435\u201C \u0438\u0437\u0438\u0441\u043A\u0432\u0430 \u201E\u0417\u0430\u043F\u0438\u0441 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0430\u201C. \u0420\u0430\u0437\u0440\u0435\u0448\u0435\u0442\u0435 \u0433\u043E \u0432 \u201E\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\u201C, \u0441\u043B\u0435\u0434 \u043A\u043E\u0435\u0442\u043E \u0440\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0439\u0442\u0435 Morphic."
          }
        },
        "bn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip-\u098F\u09B0 \u099C\u09A8\u09CD\u09AF Screen Recording \u09AA\u09CD\u09B0\u09AF\u09BC\u09CB\u099C\u09A8\u0964 System Settings-\u098F \u0985\u09A8\u09C1\u09AE\u09A4\u09BF \u09A6\u09BF\u09A8, \u09A4\u09BE\u09B0\u09AA\u09B0 Morphic \u09AA\u09C1\u09A8\u09B0\u09BE\u09AF\u09BC \u099A\u09BE\u09B2\u09C1 \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "ca-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El retall requereix la gravaci\u00F3 de pantalla. Concediu-la a Configuraci\u00F3 del sistema i reinicieu Morphic."
          }
        },
        "eu-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozketak Pantaila-grabaketa behar du. Eman baimena Sistemaren ezarpenetan eta berrabiarazi Morphic."
          }
        },
        "hy-AM": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u053F\u057F\u0580\u0565\u056C\u00BB \u0563\u0578\u0580\u056E\u0561\u057C\u0578\u0582\u0575\u0569\u0568 \u057A\u0561\u0570\u0561\u0576\u057B\u0578\u0582\u0574 \u0567 \u0537\u056F\u0580\u0561\u0576\u056B \u0571\u0561\u0575\u0576\u0561\u0563\u0580\u0574\u0561\u0576 \u0569\u0578\u0582\u0575\u056C\u057F\u057E\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0589 \u054F\u0580\u0561\u0574\u0561\u0564\u0580\u0565\u0584 \u0561\u0575\u0576 \u0540\u0561\u0574\u0561\u056F\u0561\u0580\u0563\u056B \u056F\u0561\u0580\u0563\u0561\u057E\u0578\u0580\u0578\u0582\u0574\u0576\u0565\u0580\u0578\u0582\u0574, \u0561\u057A\u0561 \u057E\u0565\u0580\u0561\u0563\u0578\u0580\u056E\u0561\u0580\u056F\u0565\u0584 Morphic-\u0568\u0589"
          }
        },
        "be-BY": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u043F\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0443 \u0434\u0430 \u0417\u0430\u043F\u0456\u0441\u0443 \u044D\u043A\u0440\u0430\u043D\u0430. \u0414\u0430\u0439\u0446\u0435 \u044F\u0433\u043E \u045E \u0421\u0456\u0441\u0442\u044D\u043C\u043D\u044B\u0445 \u043D\u0430\u043B\u0430\u0434\u0430\u0445, \u0437\u0430\u0442\u044B\u043C \u043F\u0435\u0440\u0430\u0437\u0430\u043F\u0443\u0441\u0446\u0456\u0446\u0435 Morphic."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip-\u098F\u09B0 \u099C\u09A8\u09CD\u09AF Screen Recording \u09AA\u09CD\u09B0\u09DF\u09CB\u099C\u09A8\u0964 System Settings-\u098F \u0985\u09A8\u09C1\u09AE\u09A4\u09BF \u09A6\u09BF\u09A8, \u09A4\u09BE\u09B0\u09AA\u09B0 Morphic \u0986\u09AC\u09BE\u09B0 \u099A\u09BE\u09B2\u09C1 \u0995\u09B0\u09C1\u09A8\u0964"
          }
        },
        "cs-CZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce V\u00FDst\u0159i\u017Eek vy\u017Eaduje opr\u00E1vn\u011Bn\u00ED Z\u00E1znam obrazovky. Ud\u011Blte ho v Nastaven\u00ED syst\u00E9mu a potom restartujte Morphic."
          }
        },
        "dv-MV": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0790\u07B0\u0782\u07A8\u0795\u07B0 \u0786\u07AA\u0783\u07AA\u0789\u07A6\u0781\u07B0 Screen Recording \u0784\u07AD\u0782\u07AA\u0782\u07B0\u0788\u07AC\u0787\u07AC\u0788\u07AC. System Settings \u078C\u07AC\u0783\u07AD\u078E\u07A6\u0787\u07A8 \u0787\u07AC \u078B\u07A9\u060C Morphic \u0787\u07A6\u078D\u07AA\u0782\u07B0 \u078A\u07A6\u0781\u07A7\u0781\u07AC\u0788\u07AC."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Snip ang Screen Recording. Ibigay ito sa System Settings, pagkatapos ay i-restart ang Morphic."
          }
        },
        "gl-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "O recorte require a Gravaci\u00F3n da pantalla. Conc\u00E9dea en Configuraci\u00F3n do sistema e reinicia Morphic."
          }
        },
        "hr-HR": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrezivanje zahtijeva Snimanje zaslona. Odobrite ga u Postavkama sustava, a zatim ponovno pokrenite Morphic."
          }
        },
        "hu-HU": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kiv\u00E1g\u00E1shoz K\u00E9perny\u0151felv\u00E9tel sz\u00FCks\u00E9ges. Enged\u00E9lyezze a Rendszerbe\u00E1ll\u00EDt\u00E1sokban, majd ind\u00EDtsa \u00FAjra a Morphicot."
          }
        },
        "ka-GE": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip-\u10E1 \u10E1\u10ED\u10D8\u10E0\u10D3\u10D4\u10D1\u10D0 \u201E\u10D4\u10D9\u10E0\u10D0\u10DC\u10D8\u10E1 \u10E9\u10D0\u10EC\u10D4\u10E0\u10D0\u201C. \u10DB\u10D8\u10D0\u10DC\u10D8\u10ED\u10D4\u10D7 \u10DC\u10D4\u10D1\u10D0\u10E0\u10D7\u10D5\u10D0 \u201E\u10E1\u10D8\u10E1\u10E2\u10D4\u10DB\u10D8\u10E1 \u10DE\u10D0\u10E0\u10D0\u10DB\u10D4\u10E2\u10E0\u10D4\u10D1\u10E8\u10D8\u201C, \u10E8\u10D4\u10DB\u10D3\u10D4\u10D2 \u10D2\u10D0\u10D3\u10D0\u10E2\u10D5\u10D8\u10E0\u10D7\u10D4\u10D7 Morphic."
          }
        },
        "bs-Latn-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip zahtijeva Snimanje ekrana. Dozvolite ga u Postavkama sistema, zatim ponovo pokrenite Morphic."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip requires Screen Recording. Grant it in System Settings, then restart Morphic."
          }
        },
        "ga-IE": {
          "stringUnit": {
            "state": "translated",
            "value": "Teasta\u00EDonn Taifeadadh Sc\u00E1ile\u00E1in le haghaidh Gearrth\u00F3g. Deonaigh \u00E9 i Socruithe an Ch\u00F3rais, ansin atosaigh Morphic."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunting memerlukan Perekaman Layar. Izinkan di Pengaturan Sistem, lalu mulai ulang Morphic."
          }
        },
        "kk-KZ": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00AB\u049A\u0438\u044B\u043F \u0430\u043B\u0443\u00BB \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u0441\u044B \u04AF\u0448\u0456\u043D \u00AB\u042D\u043A\u0440\u0430\u043D\u0434\u044B \u0436\u0430\u0437\u0443\u00BB \u0440\u04B1\u049B\u0441\u0430\u0442\u044B \u049B\u0430\u0436\u0435\u0442. \u041E\u043D\u044B \u00AB\u0416\u04AF\u0439\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043B\u0435\u0440\u0456\u00BB \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0441\u044B\u043D\u0434\u0430 \u0431\u0435\u0440\u0456\u043F, Morphic \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0441\u044B\u043D \u049B\u0430\u0439\u0442\u0430 \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
          }
        },
        "km-KH": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip \u178F\u17D2\u179A\u17BC\u179C\u1780\u17B6\u179A Screen Recording\u17D4 \u1795\u17D2\u178A\u179B\u17CB\u179C\u17B6\u1780\u17D2\u1793\u17BB\u1784 System Settings \u179A\u17BD\u1785\u1785\u17B6\u1794\u17CB\u1795\u17D2\u178A\u17BE\u1798 Morphic \u17A1\u17BE\u1784\u179C\u17B7\u1789\u17D4"
          }
        },
        "kok-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A\u093E\u0915 Screen Recording \u091C\u093E\u092F. System Settings\u093E\u0902\u0924 \u092A\u0930\u0935\u093E\u0928\u0917\u0940 \u0926\u093F\u092F\u093E\u0924, \u092E\u093E\u0917\u0940\u0930 Morphic \u092A\u0930\u0924 \u0938\u0941\u0930\u0942 \u0915\u0930\u093E\u0924."
          }
        },
        "lt-LT": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcijai \u201EI\u0161karpa\u201C reikalingas leidimas \u012Fra\u0161yti ekran\u0105. Suteikite j\u012F programoje \u201ESistemos nuostatos\u201C, tada paleiskite \u201EMorphic\u201C i\u0161 naujo."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgriezumam ir nepiecie\u0161ama Ekr\u0101na ierakst\u012B\u0161ana. At\u013Caujiet to lietotn\u0113 Sist\u0113mas iestat\u012Bjumi un p\u0113c tam restart\u0113jiet Morphic."
          }
        },
        "is-IS": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip krefst Skj\u00E1uppt\u00F6ku. Veittu heimild \u00ED Kerfisstillingum og endurr\u00E6stu s\u00ED\u00F0an Morphic."
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0CB8\u0CCD\u0CA8\u0CBF\u0CAA\u0CCD\u200C\u0C97\u0CC6 \u0CB8\u0CCD\u0C95\u0CCD\u0CB0\u0CC0\u0CA8\u0CCD \u0CB0\u0CC6\u0C95\u0CBE\u0CB0\u0CCD\u0CA1\u0CBF\u0C82\u0C97\u0CCD \u0C85\u0C97\u0CA4\u0CCD\u0CAF\u0CB5\u0CBF\u0CA6\u0CC6. \u0CB8\u0CBF\u0CB8\u0CCD\u0C9F\u0CAE\u0CCD \u0CB8\u0CC6\u0C9F\u0CCD\u0C9F\u0CBF\u0C82\u0C97\u0CCD\u200C\u0C97\u0CB3\u0CB2\u0CCD\u0CB2\u0CBF \u0C85\u0CA6\u0C95\u0CCD\u0C95\u0CC6 \u0C85\u0CA8\u0CC1\u0CAE\u0CA4\u0CBF \u0CA8\u0CC0\u0CA1\u0CBF, \u0CA8\u0C82\u0CA4\u0CB0 Morphic \u0C85\u0CA8\u0CCD\u0CA8\u0CC1 \u0CAE\u0CB0\u0CC1\u0CAA\u0CCD\u0CB0\u0CBE\u0CB0\u0C82\u0CAD\u0CBF\u0CB8\u0CBF."
          }
        },
        "mk-MK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430 \u0418\u0441\u0435\u0447\u043E\u043A \u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E \u0421\u043D\u0438\u043C\u0430\u045A\u0435 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u043E\u0442. \u0414\u043E\u0437\u0432\u043E\u043B\u0435\u0442\u0435 \u0433\u043E \u0432\u043E \u0421\u0438\u0441\u0442\u0435\u043C\u0441\u043A\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438, \u043F\u0430 \u0440\u0435\u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0458\u0442\u0435 \u0433\u043E Morphic."
          }
        },
        "mn-MN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0425\u0430\u0439\u0447\u043B\u0430\u0445 \u0444\u0443\u043D\u043A\u0446\u044D\u0434 \u0414\u044D\u043B\u0433\u044D\u0446\u0438\u0439\u043D \u0431\u0438\u0447\u043B\u044D\u0433\u0438\u0439\u043D \u0437\u04E9\u0432\u0448\u04E9\u04E9\u0440\u04E9\u043B \u0448\u0430\u0430\u0440\u0434\u043B\u0430\u0433\u0430\u0442\u0430\u0439. \u0421\u0438\u0441\u0442\u0435\u043C\u0438\u0439\u043D \u0442\u043E\u0445\u0438\u0440\u0433\u043E\u043E\u043D\u043E\u043E\u0441 \u0437\u04E9\u0432\u0448\u04E9\u04E9\u0440\u04E9\u043B \u043E\u043B\u0433\u043E\u043E\u0434, Morphic-\u0433 \u0434\u0430\u0445\u0438\u043D \u044D\u0445\u043B\u04AF\u04AF\u043B\u043D\u044D \u04AF\u04AF."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Petik memerlukan Rakaman Skrin. Benarkannya dalam Tetapan Sistem, kemudian mulakan semula Morphic."
          }
        },
        "mt-MT": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip je\u0127tie\u0121 Screen Recording. Ag\u0127ti l-permess f\u0027System Settings, imbag\u0127ad er\u0121a\u0027 ibda Morphic."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Utklipp krever Skjermopptak. Gi tillatelse i Systeminnstillinger, og start Morphic p\u00E5 nytt."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094D\u0928\u093F\u092A\u0915\u093E \u0932\u093E\u0917\u093F Screen Recording \u0906\u0935\u0936\u094D\u092F\u0915 \u091B\u0964 System Settings \u092E\u093E \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u093F\u0928\u0941\u0939\u094B\u0938\u094D, \u0924\u094D\u092F\u0938\u092A\u091B\u093F Morphic \u092A\u0941\u0928\u0903 \u0938\u0941\u0930\u0941 \u0917\u0930\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0B38\u0B4D\u0B28\u0B3F\u0B2A\u0B4D \u0B2A\u0B3E\u0B07\u0B01 Screen Recording \u0B06\u0B2C\u0B36\u0B4D\u0B5F\u0B15\u0964 System Settings\u0B30\u0B47 \u0B0F\u0B39\u0B3E\u0B15\u0B41 \u0B05\u0B28\u0B41\u0B2E\u0B24\u0B3F \u0B26\u0B3F\u0B05\u0B28\u0B4D\u0B24\u0B41, \u0B24\u0B3E\u0027\u0B2A\u0B30\u0B47 Morphic \u0B2A\u0B41\u0B28\u0B03\u0B06\u0B30\u0B2E\u0B4D\u0B2D \u0B15\u0B30\u0B28\u0B4D\u0B24\u0B41\u0964"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0A38\u0A28\u0A3F\u0A71\u0A2A \u0A32\u0A08 \u0A38\u0A15\u0A4D\u0A30\u0A40\u0A28 \u0A30\u0A3F\u0A15\u0A3E\u0A30\u0A21\u0A3F\u0A70\u0A17 \u0A26\u0A40 \u0A32\u0A4B\u0A5C \u0A39\u0A48\u0964 \u0A38\u0A3F\u0A38\u0A1F\u0A2E \u0A38\u0A48\u0A1F\u0A3F\u0A70\u0A17\u0A3E\u0A02 \u0A35\u0A3F\u0A71\u0A1A \u0A07\u0A38\u0A26\u0A40 \u0A07\u0A1C\u0A3E\u0A1C\u0A3C\u0A24 \u0A26\u0A3F\u0A13, \u0A2B\u0A3F\u0A30 Morphic \u0A28\u0A42\u0A70 \u0A2E\u0A41\u0A5C-\u0A1A\u0A3E\u0A32\u0A42 \u0A15\u0A30\u0A4B\u0964"
          }
        },
        "ps-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "\u067E\u0631\u06D0 \u06A9\u0648\u0644 \u062F Screen Recording \u0627\u062C\u0627\u0632\u06D0 \u062A\u0647 \u0627\u0693\u062A\u06CC\u0627 \u0644\u0631\u064A. \u062F\u0627 \u067E\u0647 System Settings \u06A9\u06D0 \u0648\u0631\u06A9\u0693\u0626\u060C \u0628\u06CC\u0627 Morphic \u0628\u06CC\u0627 \u067E\u06CC\u0644 \u06A9\u0693\u0626."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "La funci\u00F3n Recorte requiere el permiso de Grabaci\u00F3n de pantalla. Concedelo en Configuraci\u00F3n del Sistema y despu\u00E9s reinici\u00E1 Morphic."
          }
        },
        "es-BO": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorte requiere Grabaci\u00F3n de pantalla. Otorgue el permiso en Configuraci\u00F3n del Sistema y luego reinicie Morphic."
          }
        },
        "gd-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tha Gearradh \u00E0s feumach air Cl\u00E0radh-sgr\u00ECn. Ceadaich e ann an Roghainnean an t-siostaim, an uair sin ath-th\u00F2isich Morphic."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip-\u0D28\u0D4D Screen Recording \u0D06\u0D35\u0D36\u0D4D\u0D2F\u0D2E\u0D3E\u0D23\u0D4D. System Settings-\u0D7D \u0D05\u0D24\u0D4D \u0D05\u0D28\u0D41\u0D35\u0D26\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15, \u0D24\u0D41\u0D1F\u0D7C\u0D28\u0D4D\u0D28\u0D4D Morphic \u0D2A\u0D41\u0D28\u0D30\u0D3E\u0D30\u0D02\u0D2D\u0D3F\u0D15\u0D4D\u0D15\u0D41\u0D15."
          }
        },
        "ro-RO": {
          "stringUnit": {
            "state": "translated",
            "value": "Decuparea necesit\u0103 \u00CEnregistrare ecran. Acorda\u021Bi permisiunea \u00EEn Configur\u0103ri sistem, apoi reporni\u021Bi Morphic."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043B\u044F \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430 \u044D\u043A\u0440\u0430\u043D\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u00AB\u0417\u0430\u043F\u0438\u0441\u0438 \u044D\u043A\u0440\u0430\u043D\u0430\u00BB. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E \u0432 \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0445 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445, \u0437\u0430\u0442\u0435\u043C \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 Morphic."
          }
        },
        "sd-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u0646\u067E \u0644\u0627\u0621\u0650 \u0627\u0633\u06AA\u0631\u064A\u0646 \u0631\u06AA\u0627\u0631\u068A\u0646\u06AF \u06AF\u0647\u0631\u0628\u0644 \u0622\u0647\u064A. \u0627\u0646 \u06A9\u064A System Settings \u06FE \u0645\u0646\u0638\u0648\u0631 \u06AA\u0631\u064A\u0648\u060C \u067E\u0648\u0621\u0650 Morphic \u067B\u064A\u0647\u0631 \u0634\u0631\u0648\u0639 \u06AA\u0631\u064A\u0648."
          }
        },
        "si-LK": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0D9A\u0DD0\u0DB4\u0DD3\u0DB8\u0DA7 \u0DAD\u0DD2\u0DBB \u0DB4\u0DA7\u0DD2\u0D9C\u0DAD \u0D9A\u0DD2\u0DBB\u0DD3\u0DB8 \u0D85\u0DC0\u0DC1\u0DCA\u200D\u0DBA\u0DBA\u0DD2. System Settings \u0DC4\u0DD2 \u0D91\u0DBA \u0DBD\u0DB6\u0DCF \u0DAF\u0DD3, \u0DB4\u0DC3\u0DD4\u0DC0 Morphic \u0DB1\u0DD0\u0DC0\u0DAD \u0D85\u0DBB\u0DB9\u0DB1\u0DCA\u0DB1."
          }
        },
        "sk-SK": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00FDstri\u017Eok vy\u017Eaduje Nahr\u00E1vanie obrazovky. Povo\u013Ete ho v Nastaveniach syst\u00E9mu a potom re\u0161tartujte Morphic."
          }
        },
        "sl-SI": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajem zahteva Snemanje zaslona. Odobrite ga v Sistemskih nastavitvah, nato znova za\u017Eenite Morphic."
          }
        },
        "sr-Latn-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Ise\u010Dak zahteva Snimanje ekrana. Odobrite ga u Pode\u0161avanjima sistema, pa ponovo pokrenite Morphic."
          }
        },
        "cy-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae Cipio angen Recordio Sgrin. Rhowch ganiat\u00E2d yn Gosodiadau System, yna ailgychwynnwch Morphic."
          }
        },
        "sw-KE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa inahitaji Kurekodi Skrini. Iruhusu katika Mipangilio ya Mfumo, kisha uanzishe upya Morphic."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0BA4\u0BC1\u0BA3\u0BC1\u0B95\u0BCD\u0B95\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0BA4\u0BBF\u0BB0\u0BC8\u0BAA\u0BCD \u0BAA\u0BA4\u0BBF\u0BB5\u0BC1 \u0BA4\u0BC7\u0BB5\u0BC8. \u0B95\u0BA3\u0BBF\u0BA9\u0BBF \u0B85\u0BAE\u0BC8\u0BAA\u0BCD\u0BAA\u0BC1\u0B95\u0BB3\u0BBF\u0BB2\u0BCD \u0B85\u0BA4\u0BC8 \u0B85\u0BA9\u0BC1\u0BAE\u0BA4\u0BBF\u0BA4\u0BCD\u0BA4\u0BC1, Morphic-\u0B90 \u0BAE\u0BB1\u0BC1\u0BA4\u0BCA\u0B9F\u0B95\u0BCD\u0B95\u0BAE\u0BCD \u0B9A\u0BC6\u0BAF\u0BCD\u0BAF\u0BB5\u0BC1\u0BAE\u0BCD."
          }
        },
        "th-TH": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0E01\u0E32\u0E23\u0E08\u0E31\u0E1A\u0E20\u0E32\u0E1E\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E01\u0E32\u0E23\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E08\u0E2D \u0E43\u0E2B\u0E49\u0E2D\u0E19\u0E38\u0E0D\u0E32\u0E15\u0E43\u0E19\u0E01\u0E32\u0E23\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32\u0E23\u0E30\u0E1A\u0E1A \u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E34\u0E48\u0E21 Morphic \u0E43\u0E2B\u0E21\u0E48"
          }
        },
        "ti-ER": {
          "stringUnit": {
            "state": "translated",
            "value": "\u121D\u1251\u122B\u133D Screen Recording \u12E8\u12F5\u120D\u12EE\u1362 \u12A3\u1265 System Settings \u134D\u1250\u12F6\u1361 \u12F5\u1215\u122A\u12A1 \u1295Morphic \u12A5\u1295\u12F0\u1308\u1293 \u1300\u121D\u122E\u1362"
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Al\u0131nt\u0131s\u0131 \u00F6zelli\u011Fi i\u00E7in Ekran Kayd\u0131 izni gerekir. Sistem Ayarlar\u0131\u0027ndan izin verin, ard\u0131ndan Morphic\u0027i yeniden ba\u015Flat\u0131n."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043B\u044F \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430 \u0435\u043A\u0440\u0430\u043D\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0434\u043E\u0437\u0432\u0456\u043B \u043D\u0430 \u0437\u0430\u043F\u0438\u0441 \u0435\u043A\u0440\u0430\u043D\u0430. \u041D\u0430\u0434\u0430\u0439\u0442\u0435 \u0439\u043E\u0433\u043E \u0432 \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445, \u0430 \u043F\u043E\u0442\u0456\u043C \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0456\u0442\u044C Morphic."
          }
        },
        "yo-NG": {
          "stringUnit": {
            "state": "translated",
            "value": "Snip n\u00EDl\u00F2 \u00E0\u1E63\u1EB9 Screen Recording. \u1EB8 f\u00FAn un n\u00ED \u00E0\u1E63\u1EB9 n\u00EDn\u00FA System Settings, l\u1EB9\u0301y\u00ECn n\u00E1\u00E0 k\u00ED \u1EB9 t\u00FAn b\u1EB9\u0300r\u1EB9\u0300 Morphic."
          }
        },
        "zu-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Snip idinga i-Screen Recording. Inike imvume ku-System Settings, bese uqala kabusha i-Morphic."

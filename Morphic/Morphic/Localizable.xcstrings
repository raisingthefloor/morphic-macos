        "chr-CHER-US": {
          "stringUnit": {
            "state": "translated",
            "value": "\u13A0\u13D9\u13D7 \u13AA\u13EA\u13B6\u13D7 \u13A3\u13CF\u13F3 \u13A2\u13AC\u13C1\u13B8. Morphic \u13D4\u13B5\u13C1 \u13AD\u13B4\u13C5 \u13BE\u13CD\u13A9 \u13A4\u13D3\u13C1\u13DF\u13F4\u13DB \u13AC\u13D9\u13D7 \u13A2\u13F3\u13B5\u13CD\u13D9\u13D7."

        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer selecci\u00F3n usa \u201CLeer la selecci\u00F3n\u201D de macOS, que actualmente est\u00E1 desactivada. Act\u00EDvala en la configuraci\u00F3n de Accesibilidad y vuelve a intentarlo."
          }
        },
        "es-NI": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lo seleccionado usa la funci\u00F3n \u201CLeer selecci\u00F3n\u201D de macOS, que est\u00E1 desactivada. Activ\u00E1la en la configuraci\u00F3n de Accesibilidad y volv\u00E9 a intentarlo."

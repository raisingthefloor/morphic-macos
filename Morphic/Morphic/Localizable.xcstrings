        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043D\u0430\u043C\u0430\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440, \u0430\u043B\u0435 \u0432 \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u043E \u0434\u0456\u0430\u043B\u043E\u0433\u043E\u0432\u0435 \u0432\u0456\u043A\u043D\u043E, \u044F\u043A\u0435 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0437\u0430\u043A\u0440\u0438\u0442\u0438 \u0437\u0430 \u0432\u0430\u0441. \u0417\u0430\u043A\u0440\u0438\u0439\u0442\u0435 \u0446\u0435 \u0432\u0456\u043A\u043D\u043E \u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C \u0441\u043F\u0440\u043E\u0431\u0443."
          }
        },
        "uz-Latn-UZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic sozlamani o\u02BBzgartirmoqchi, biroq Tizim sozlamalarida ochiq dialog oynasi bor va Morphic uni yopa olmaydi. Iltimos, o\u02BBsha oynani yopib, qaytadan urunib ko\u02BBring."
          }
        },
        "xh-ZA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic izama ukutshintsha isetingi, kodwa Iisetingi Zesistim zinengxoxo evulekileyo engenakuyivala kuwe. Nceda uyivale loo ngxoxo, uze uzame kwakhona."
          }
        },
        "yo-NG": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0144 gb\u00ECy\u00E0nj\u00FA l\u00E1ti y\u00ED \u00ECt\u00F2 kan pad\u00E0, \u1E63\u00F9gb\u1ECD\u0301n System Settings n\u00ED f\u00E8r\u00E8s\u00E9 \u00ECb\u00E1nis\u1ECD\u0300r\u1ECD\u0300 t\u00ED \u00F3 \u1E63\u00ED t\u00ED k\u00F2 l\u00E8 t\u00EC f\u00FAn \u1ECD. J\u1ECD\u0300w\u1ECD\u0301 ti f\u00E8r\u00E8s\u00E9 \u00ECb\u00E1nis\u1ECD\u0300r\u1ECD\u0300 n\u00E1\u00E0, k\u00ED o s\u00EC gb\u00ECy\u00E0nj\u00FA l\u1EB9\u0301\u1EB9\u0300kan s\u00ED i."
          }
        },
        "ca-ES-valencia": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic intenta canviar una configuraci\u00F3, per\u00F2 Configuraci\u00F3 del Sistema t\u00E9 un quadre de di\u00E0leg obert que no pot tancar per tu. Tanca eixe quadre de di\u00E0leg i torna-ho a provar."
          }
        },
        "chr-CHER-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u13A0\u13D3\u13C1\u13B3\u13DB \u13A4\u13EC\u13E2\u13D7 \u13D3\u13D3\u13C2\u13B8, \u13A0\u13CE\u13C3 System Settings \u13A0\u13D3\u13C1\u13E8\u13D7 \u13A4\u13CD\u13DA\u13A2\u13DB \u13A4\u13BF\u13A5 \u13BE\u13CD\u13A9 \u13AC\u13E9\u13CD\u13DA\u13D7 \u13C2\u13A8\u13D2\u13BE. \u13A1\u13B3\u13DB \u13BE\u13CD\u13A9 \u13A0\u13D3\u13C1\u13E8\u13D7 \u13AF\u13CD\u13DA\u13A2, \u13A0\u13B4 \u13D4\u13B5\u13C1 \u13AF\u13D9\u13A5\u13CF."
          }
        },
        "es-PY": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic est\u00E1 tratando de cambiar una configuraci\u00F3n, pero Configuraci\u00F3n del Sistema tiene abierto un cuadro de di\u00E1logo que no puede cerrar por vos. Por favor, cerr\u00E1 ese cuadro de di\u00E1logo y volv\u00E9 a intentarlo."
          }
        },
        "lo-LA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0E81\u0ECD\u0EB2\u0EA5\u0EB1\u0E87\u0E9E\u0EB0\u0E8D\u0EB2\u0E8D\u0EB2\u0EA1\u0E9B\u0EC8\u0EBD\u0E99\u0E81\u0EB2\u0E99\u0E95\u0EB1\u0EC9\u0E87\u0E84\u0EC8\u0EB2, \u0EC1\u0E95\u0EC8 \u0E81\u0EB2\u0E99\u0E95\u0EB1\u0EC9\u0E87\u0E84\u0EC8\u0EB2\u0EA5\u0EB0\u0E9A\u0EBB\u0E9A \u0EA1\u0EB5\u0E81\u0EC8\u0EAD\u0E87\u0EC2\u0E95\u0EC9\u0E95\u0EAD\u0E9A\u0EC0\u0E9B\u0EB5\u0E94\u0EA2\u0EB9\u0EC8\u0E97\u0EB5\u0EC8\u0E9A\u0ECD\u0EC8\u0EAA\u0EB2\u0EA1\u0EB2\u0E94\u0E9B\u0EB4\u0E94\u0EC3\u0EAB\u0EC9\u0E97\u0EC8\u0EB2\u0E99\u0EC4\u0E94\u0EC9. \u0E81\u0EB0\u0EA5\u0EB8\u0E99\u0EB2\u0E9B\u0EB4\u0E94\u0E81\u0EC8\u0EAD\u0E87\u0EC2\u0E95\u0EC9\u0E95\u0EAD\u0E9A\u0E99\u0EB1\u0EC9\u0E99, \u0EC1\u0EA5\u0EC9\u0EA7\u0EA5\u0EAD\u0E87\u0EC3\u0EDD\u0EC8\u0EAD\u0EB5\u0E81\u0E84\u0EB1\u0EC9\u0E87."
          }
        },
        "mi-NZ": {
          "stringUnit": {
            "state": "translated",
            "value": "Kei te ngana a Morphic ki te panoni i t\u0113tahi tautuhinga, engari he pouaka k\u014Drero kei te tuwhera i System Settings e kore e taea te kati m\u0101u. T\u0113n\u0101 kati taua pouaka k\u014Drero, ka ngana an\u014D ai."
          }
        },
        "nn-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic pr\u00F8ver \u00E5 endre ei innstilling, men Systeminnstillingar har ei dialogrute open som Morphic ikkje kan lukke for deg. Lukk dialogruta og pr\u00F8v p\u00E5 nytt."
          }
        },
        "quz-PE": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic huk churanata hukmanyachiyta munan, ichaqa System Settings huk rimanakuyta kichasqa kachkan mana qampaq wichq\u0027ay atinanta. Ama hina kaspa chay rimanakuyta wichq\u0027ay, chaymanta kaqmanta ruway."
          }
        },
        "sr-Cyrl-BA": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043F\u043E\u043A\u0443\u0448\u0430\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u043C\u0438\u0458\u0435\u043D\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0443, \u0430\u043B\u0438 \u0421\u0438\u0441\u0442\u0435\u043C\u0441\u043A\u0430 \u043F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0430 \u0438\u043C\u0430\u0458\u0443 \u043E\u0442\u0432\u043E\u0440\u0435\u043D \u0434\u0438\u0458\u0430\u043B\u043E\u0433 \u043A\u043E\u0458\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0437\u0430\u0442\u0432\u043E\u0440\u0438 \u0443\u043C\u0458\u0435\u0441\u0442\u043E \u0432\u0430\u0441. \u0417\u0430\u0442\u0432\u043E\u0440\u0438\u0442\u0435 \u0442\u0430\u0458 \u0434\u0438\u0458\u0430\u043B\u043E\u0433, \u043F\u0430 \u043F\u043E\u043A\u0443\u0448\u0430\u0458\u0442\u0435 \u043F\u043E\u043D\u043E\u0432\u043E."
          }
        },
        "sr-Cyrl-RS": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043F\u043E\u043A\u0443\u0448\u0430\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u043C\u0435\u043D\u0438 \u043F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0435, \u0430\u043B\u0438 \u0458\u0435 \u0443 \u0430\u043F\u043B\u0438\u043A\u0430\u0446\u0438\u0458\u0438 \u041F\u043E\u0434\u0435\u0448\u0430\u0432\u0430\u045A\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0442\u0432\u043E\u0440\u0435\u043D \u0434\u0438\u0458\u0430\u043B\u043E\u0433 \u043A\u043E\u0458\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0437\u0430\u0442\u0432\u043E\u0440\u0438 \u0443\u043C\u0435\u0441\u0442\u043E \u0432\u0430\u0441. \u0417\u0430\u0442\u0432\u043E\u0440\u0438\u0442\u0435 \u0442\u0430\u0458 \u0434\u0438\u0458\u0430\u043B\u043E\u0433, \u043F\u0430 \u043F\u043E\u043A\u0443\u0448\u0430\u0458\u0442\u0435 \u043F\u043E\u043D\u043E\u0432\u043E."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0C12\u0C15 \u0C38\u0C46\u0C1F\u0C4D\u0C1F\u0C3F\u0C02\u0C17\u0C4D\u200C\u0C28\u0C41 \u0C2E\u0C3E\u0C30\u0C4D\u0C1A\u0C21\u0C3E\u0C28\u0C3F\u0C15\u0C3F \u0C2A\u0C4D\u0C30\u0C2F\u0C24\u0C4D\u0C28\u0C3F\u0C38\u0C4D\u0C24\u0C4B\u0C02\u0C26\u0C3F, \u0C15\u0C3E\u0C28\u0C40 System Settings \u0C32\u0C4B \u0C05\u0C26\u0C3F \u0C2E\u0C40 \u0C15\u0C4B\u0C38\u0C02 \u0C2E\u0C42\u0C2F\u0C32\u0C47\u0C28\u0C3F \u0C12\u0C15 \u0C21\u0C48\u0C32\u0C3E\u0C17\u0C4D \u0C24\u0C46\u0C30\u0C3F\u0C1A\u0C3F \u0C09\u0C02\u0C26\u0C3F. \u0C26\u0C2F\u0C1A\u0C47\u0C38\u0C3F \u0C06 \u0C21\u0C48\u0C32\u0C3E\u0C17\u0C4D\u200C\u0C28\u0C41 \u0C2E\u0C42\u0C38\u0C3F, \u0C2E\u0C33\u0C4D\u0C32\u0C40 \u0C2A\u0C4D\u0C30\u0C2F\u0C24\u0C4D\u0C28\u0C3F\u0C02\u0C1A\u0C02\u0C21\u0C3F."
          }
        },
        "lb-LU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic prob\u00E9iert, eng Astellung z\u0027\u00E4nneren, mee an de Systemastellungen ass en Dialogfeld op, dat Morphic net fir dech zoumaache kann. Maach wgl. dat Dialogfeld zou a prob\u00E9ier et dann nach eng K\u00E9ier."
          }
        },
        "sq-AL": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic po p\u00EBrpiqet t\u00EB ndryshoj\u00EB nj\u00EB cil\u00EBsim, por Cil\u00EBsimet e Sistemit kan\u00EB nj\u00EB dialog t\u00EB hapur q\u00EB nuk mund ta mbyll\u00EB p\u00EBr ju. Ju lutemi, mbyllni at\u00EB dialog, pastaj provoni s\u00EBrish."
          }
        },
        "tt-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u043A\u04E9\u0439\u043B\u04D9\u04AF\u043D\u0435 \u04AF\u0437\u0433\u04D9\u0440\u0442\u0435\u0440\u0433\u04D9 \u0442\u044B\u0440\u044B\u0448\u0430, \u043B\u04D9\u043A\u0438\u043D \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043A\u04E9\u0439\u043B\u04D9\u04AF\u043B\u04D9\u0440\u0435\u043D\u0434\u04D9 \u0441\u0435\u0437\u043D\u0435\u04A3 \u04E9\u0447\u0435\u043D \u044F\u0431\u044B\u043F \u0431\u0443\u043B\u043C\u044B\u0439 \u0442\u043E\u0440\u0433\u0430\u043D \u0434\u0438\u0430\u043B\u043E\u0433 \u0442\u04D9\u0440\u04D9\u0437\u04D9\u0441\u0435 \u0430\u0447\u044B\u043A. \u0417\u0438\u043D\u04BB\u0430\u0440, \u0448\u0443\u043B \u0434\u0438\u0430\u043B\u043E\u0433 \u0442\u04D9\u0440\u04D9\u0437\u04D9\u0441\u0435\u043D \u044F\u0431\u044B\u0433\u044B\u0437, \u0430\u043D\u043D\u0430\u0440\u044B \u044F\u04A3\u0430\u0434\u0430\u043D \u0442\u044B\u0440\u044B\u0448\u044B\u043F \u043A\u0430\u0440\u0430\u0433\u044B\u0437."
          }
        },
        "ug-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0628\u0649\u0631 \u062A\u06D5\u06AD\u0634\u06D5\u0643\u0646\u0649 \u0626\u06C6\u0632\u06AF\u06D5\u0631\u062A\u0645\u06D5\u0643\u0686\u0649\u060C \u0644\u06D0\u0643\u0649\u0646 \u0633\u0649\u0633\u062A\u06D0\u0645\u0627 \u062A\u06D5\u06AD\u0634\u06D5\u0643\u0644\u0649\u0631\u0649\u062F\u06D5 \u0633\u0649\u0632 \u0626\u06C8\u0686\u06C8\u0646 \u062A\u0627\u0642\u0649\u064A\u0627\u0644\u0645\u0627\u064A\u062F\u0649\u063A\u0627\u0646 \u0628\u0649\u0631 \u0633\u06C6\u0632\u0644\u06D5\u0634\u0643\u06C8 \u0626\u06D0\u0686\u0649\u0642 \u062A\u06C7\u0631\u06C7\u067E\u062A\u06C7. \u0634\u06C7 \u0633\u06C6\u0632\u0644\u06D5\u0634\u0643\u06C8\u0646\u0649 \u062A\u0627\u0642\u0627\u067E\u060C \u0626\u0627\u0646\u062F\u0649\u0646 \u0642\u0627\u064A\u062A\u0627 \u0633\u0649\u0646\u0627\u06AD."
          }
        }
      }
    },

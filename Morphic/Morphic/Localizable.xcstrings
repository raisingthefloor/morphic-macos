            "value": "Read selected text"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u062E\u062A\u0627\u0631"

          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u06A9\u06D2 \u0644\u06CC\u06D2 Morphic"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic cho macOs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic\u7684macOS\u7248\u672C"
          }
        },
        "zh-Hant": {
          "stringUnit": {

        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "Morphic \u0932\u0947 Increase Contrast \u0938\u094D\u0935\u0924\u0903 \u092C\u0926\u0932\u094D\u0928 \u0938\u0915\u0947\u0928\u0964 \u092F\u0938\u0932\u093E\u0908 \u091F\u0917\u0932 \u0917\u0930\u094D\u0928 \u092A\u0939\u0941\u0901\u091A \u0938\u0947\u091F\u093F\u0919\u0939\u0930\u0942 \u0916\u094B\u0932\u094D\u0928\u0941\u0939\u094B\u0938\u094D\u0964"
